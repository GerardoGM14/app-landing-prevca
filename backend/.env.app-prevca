# === Variables de entorno de PRODUCCIÓN (proyecto app-prevca) ===
# Firebase Functions v2 carga este archivo (.env.<projectId>) con prioridad
# sobre .env cuando se despliega al proyecto app-prevca.
# Solo URLs públicas — NADA de secretos aquí (el Access Token va en Secret Manager).

# Dominio propio de la landing: MercadoPago devuelve aquí al cliente tras pagar.
PUBLIC_LANDING_URL=https://grupoprevca.com

# Base pública del API desplegado, para que MercadoPago alcance el webhook.
PUBLIC_API_URL=https://us-central1-app-prevca.cloudfunctions.net/api
