---
// Gestión corporativa de información y valores de la empresa.
import "../styles/global.css";
import {
	FaSearch,
	FaArrowLeft,
	FaArrowRight,
	FaLinkedinIn,
	FaInstagram,
	FaTwitter,
	FaBars,
	FaTimes,
	FaBullseye,
	FaEye,
	FaPhoneSquareAlt,
	FaCheckCircle,
} from "react-icons/fa";
import { MdMarkEmailRead } from "react-icons/md";
import { AiOutlineSafetyCertificate } from "react-icons/ai";
import {
	HiArrowDownOnSquareStack,
	HiArrowUpOnSquareStack,
} from "react-icons/hi2";
import { LuCookie } from "react-icons/lu";
import {
	HiOutlineHeart,
	HiOutlineLightBulb,
	HiOutlineStar,
} from "react-icons/hi2";
import libroImg from "../assets/libro-reclamaciones.png";
import isoImg from "../assets/iso-9001.webp";

// Importación de imágenes de liderazgo
import leaderKevin from "../assets/nosotros/leader-kevin.jpeg";
import leaderRosa from "../assets/nosotros/leader-rosa.jpg";
import leaderMileydi from "../assets/nosotros/leader-mileydi.jpeg";

// Configuración del equipo de liderazgo
const leaders = [
	{
		name: "Kevin Charles Pérez Chávez",
		role: "Gerente General",
		image: leaderKevin,
		position: "object-top",
		imgClass: "translate-y-8", // Desplaza la imagen hacia abajo físicamente
	},
	{
		name: "Rosa Santisteban",
		role: "Logística y Operaciones",
		image: leaderRosa,
	},
	{
		name: "Mileydi Olivera",
		role: "Contabilidad y Finanzas",
		image: leaderMileydi,
	},
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Nuestra Historia | Grupo Prevca</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Outfit:wght@400;600&family=Inter:wght@300;400&display=swap"
			rel="stylesheet"
		/>
		<style>
			/* Spinner Animation */
			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}
			.loader-spinner {
				border: 3px solid rgba(255, 255, 255, 0.1);
				border-left-color: #1d4c74;
				border-radius: 50%;
				width: 50px;
				height: 50px;
				animation: spin 0.8s linear infinite;
			}
			/* Initial state for cookie banner */
			#cookie-banner {
				transform: translateY(100%);
			}

			/* Reveal on Scroll classes */
			.reveal-item {
				opacity: 0;
				transform: translateY(30px);
				transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.reveal-item.active {
				opacity: 1;
				transform: translateY(0);
			}

			/* Timeline Styling */
			.timeline-dot {
				width: 14px;
				height: 14px;
				background-color: white;
				border-radius: 50%;
				position: absolute;
				top: -7px;
				left: 50%;
				transform: translateX(-50%);
				z-index: 10;
				box-shadow: 0 0 0 4px #1d4c74;
			}

			/* Nav Link Animation */
			.nav-link {
				position: relative;
			}
			.nav-link::after {
				content: "";
				position: absolute;
				bottom: -2px;
				left: 0;
				width: 0;
				height: 2px;
				background-color: white;
				transition: width 0.3s ease;
			}
			.nav-link:hover::after {
				width: 100%;
			}

			/* Typewriter Cursor */
			.typewriter-cursor::after {
				content: "|";
				animation: blink 1s infinite;
				margin-left: 2px;
				color: #1d4c74;
			}
			@keyframes blink {
				0%,
				100% {
					opacity: 1;
				}
				50% {
					opacity: 0;
				}
			}

			/* Scroll Progress Bar Style */
			#scroll-progress-bar {
				width: 0%;
				transition: width 0.1s ease-out;
			}

			/* Legal Modals Styles */
			.modal-overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.5);
				backdrop-filter: blur(4px);
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 20px;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.3s ease;
			}
			.modal-overlay.active {
				opacity: 1;
				pointer-events: auto;
			}
			.modal-content {
				background: white;
				width: 100%;
				max-width: 800px;
				max-height: 80vh;
				overflow-y: auto;
				padding: 40px;
				border-radius: 2px;
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
				position: relative;
				border-top: 6px solid #1d4c74;
			}
			.modal-close {
				position: absolute;
				top: 20px;
				right: 20px;
				font-size: 24px;
				cursor: pointer;
				color: #2a3035;
				opacity: 0.5;
				transition: opacity 0.2s;
			}
			.modal-close:hover {
				opacity: 1;
			}
			.modal-body h3 {
				color: #1d4c74;
				font-weight: 700;
				font-family: "Outfit Variable", sans-serif;
				margin-bottom: 20px;
				letter-spacing: -0.01em;
			}
			.modal-body section {
				margin-bottom: 24px;
			}
			.modal-body h4 {
				font-weight: 700;
				margin-bottom: 8px;
				color: #2a3035;
			}
			.modal-body p {
				color: #4b5563;
				line-height: 1.6;
				margin-bottom: 12px;
			}
		</style>
	</head>
	<body
		class="bg-white text-gray-800 font-body selection:bg-[#1d4c74] selection:text-white overflow-x-hidden"
	>
		<!-- CORPORATE LOADER -->
		<div
			id="loader-overlay"
			class="fixed inset-0 z-[100] flex flex-col items-center justify-center transition-opacity duration-700"
		>
			<div class="absolute inset-0 bg-black/30 backdrop-blur-md"></div>
			<div class="relative z-10">
				<div class="loader-spinner"></div>
			</div>
		</div>

		<!-- Main Navbar -->
		<nav
			class="bg-[#2a3035] text-white py-4 px-6 md:px-8 flex justify-between items-center font-ui sticky top-0 z-50 transition-all duration-300"
		>
			<div class="flex items-center gap-3">
				<div
					class="w-7 h-7 md:w-8 md:h-8 bg-white text-[#2a3035] font-extrabold flex items-center justify-center font-display text-base md:text-lg shadow-none"
				>
					P
				</div>
				<span
					class="text-xl md:text-2xl font-extrabold tracking-widest font-display uppercase"
					>GRUPO PREVCA</span
				>
			</div>

			<!-- Desktop Menu -->
			<div
				class="hidden lg:flex gap-8 text-sm font-semibold tracking-wide uppercase"
			>
				<a
					href="/"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Inicio</a
				>
				<a
					href="/nosotros"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Sobre Nosotros</a
				>
				<a
					href="/madera"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Aserradero Prevca</a
				>
				<a
					href="/alojamiento"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Alojamiento</a
				>
				<a
					href="/cafe"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Café</a
				>
				<a
					href="/#contact-section"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Contacto</a
				>
			</div>

			<div class="hidden lg:flex gap-6 items-center">
				<button
					class="hover:text-gray-400 transition-colors text-lg cursor-pointer"
					aria-label="Buscar"><FaSearch /></button
				>
				<a
					href="/ecommerce"
					class="bg-[#1d4c74] text-white uppercase text-xs font-bold py-2 px-6 hover:bg-[#153a5b] transition-colors cursor-pointer border-none"
				>
					Tienda Virtual
				</a>
			</div>

			<!-- Mobile Toggle -->
			<button
				id="menu-toggle"
				class="lg:hidden text-2xl text-white cursor-pointer"
				aria-label="Menu"
			>
				<div id="icon-bars"><FaBars id="icon-bars" /></div>
				<div id="icon-times" class="hidden">
					<FaTimes id="icon-times" />
				</div>
			</button>
		</nav>

		<!-- Mobile Menu Drawer -->
		<div
			id="mobile-menu"
			class="fixed inset-0 bg-[#2a3035] z-40 transform translate-x-full transition-transform duration-300 lg:hidden pt-24 px-8 overflow-y-auto"
		>
			<div
				class="flex flex-col gap-6 text-xl text-white font-ui uppercase font-bold tracking-widest"
			>
				<a href="/" class="border-b border-white/10 pb-4 cursor-pointer"
					>Inicio</a
				>
				<a
					href="/nosotros"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Sobre Nosotros</a
				>
				<a
					href="/madera"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Aserradero Prevca</a
				>
				<a
					href="/alojamiento"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Alojamiento</a
				>
				<a
					href="/cafe"
					class="border-b border-white/10 pb-4 cursor-pointer">Café</a
				>
				<a
					href="/#contact-section"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Contacto</a
				>
				<a
					href="/ecommerce"
					class="bg-[#1d4c74] text-center py-4 mt-4 cursor-pointer text-sm"
					>Tienda Virtual</a
				>
			</div>
		</div>

		<!-- HERO: Nuestra Historia y Valores -->
		<header
			class="relative w-full h-[50vh] md:h-[60vh] flex flex-col md:flex-row bg-gray-900 border-b border-[#2a3035]"
		>
			<!-- 4 Background Slices -->
			<div
				class="w-full md:w-1/4 h-1/4 md:h-full bg-cover bg-center md:border-r border-white/10 grayscale-[0.3] hover:grayscale-0 transition-all duration-700"
				style="background-image: url('https://images.unsplash.com/photo-1644358686685-4ed525a59663?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');"
			>
			</div>
			<div
				class="w-full md:w-1/4 h-1/4 md:h-full bg-cover bg-center md:border-r border-white/10 grayscale-[0.3] hover:grayscale-0 transition-all duration-700"
				style="background-image: url('https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&q=80&w=1200');"
			>
			</div>
			<div
				class="w-full md:w-1/4 h-1/4 md:h-full bg-cover bg-center md:border-r border-white/10 grayscale-[0.3] hover:grayscale-0 transition-all duration-700"
				style="background-image: url('https://images.unsplash.com/photo-1542372147193-a7aca54189cd?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');"
			>
			</div>
			<div
				class="w-full md:w-1/4 h-1/4 md:h-full bg-cover bg-center grayscale-[0.3] hover:grayscale-0 transition-all duration-700"
				style="background-image: url('https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&q=80&w=1200');"
			>
			</div>

			<!-- Overlay with Title -->
			<div
				class="absolute inset-0 bg-black/60 flex flex-col justify-center items-center text-white text-center p-6 md:p-12"
			>
				<h1
					class="text-4xl sm:text-5xl md:text-6xl font-extrabold font-display tracking-wide leading-tight reveal-item shadow-black drop-shadow-xl uppercase"
				>
					Nuestra Historia y Valores
				</h1>
			</div>
		</header>

		<!-- Timeline Section -->
		<section
			class="bg-[#1d4c74] py-20 text-white font-body px-6 md:px-8 overflow-hidden relative border-t-4 border-[#2a3035]"
		>
			<div class="max-w-7xl mx-auto reveal-item">
				<div
					class="relative w-full h-1 bg-white/20 hidden md:block mb-10 rounded-full mt-4"
				>
				</div>

				<div
					class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-6 relative text-center"
				>
					<!-- Node 1 -->
					<div class="relative pt-4">
						<div class="hidden md:block timeline-dot"></div>
						<h3
							class="font-bold text-base mb-2 opacity-90 tracking-widest uppercase font-ui"
						>
							Fundación
						</h3>
						<h4
							class="font-extrabold text-3xl font-display mb-3 text-white"
						>
							1987
						</h4>
						<p
							class="text-sm text-gray-200 opacity-90 leading-relaxed px-2"
						>
							Consolidación de la exportación de madera
							sustentable en respeto al medio ambiente.
						</p>
					</div>
					<!-- Node 2 -->
					<div class="relative pt-4" style="transition-delay: 150ms">
						<div class="hidden md:block timeline-dot"></div>
						<h3
							class="font-bold text-base mb-2 opacity-90 tracking-widest uppercase font-ui"
						>
							Expansión
						</h3>
						<h4
							class="font-extrabold text-3xl font-display mb-3 text-white"
						>
							2010
						</h4>
						<p
							class="text-sm text-gray-200 opacity-90 leading-relaxed px-2"
						>
							Integración de estándares corporativos y expansión
							técnica a nivel regional.
						</p>
					</div>
					<!-- Node 3 -->
					<div class="relative pt-4" style="transition-delay: 300ms">
						<div class="hidden md:block timeline-dot"></div>
						<h3
							class="font-bold text-base mb-2 opacity-90 tracking-widest uppercase font-ui"
						>
							Diversificación
						</h3>
						<h4
							class="font-extrabold text-3xl font-display mb-3 text-white"
						>
							2022
						</h4>
						<p
							class="text-sm text-gray-200 opacity-90 leading-relaxed px-2"
						>
							Apertura oficial del sector de Alojamiento Premium
							con establecimientos modelo.
						</p>
					</div>
					<!-- Node 4 -->
					<div class="relative pt-4" style="transition-delay: 450ms">
						<div class="hidden md:block timeline-dot"></div>
						<h3
							class="font-extrabold text-lg font-display mb-2 text-white"
						>
							Liderazgo Multisectorial
						</h3>
						<h4
							class="font-bold text-xl opacity-90 tracking-widest font-ui mt-3"
						>
							2024 - Presente
						</h4>
						<p
							class="text-sm text-gray-200 opacity-90 leading-relaxed px-2 mt-2"
						>
							Dedicados a proveer soluciones de alto calibre a
							través de Madera, Alojamiento, Café y Transporte.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Executive Leadership -->
		<section class="py-24 px-6 md:px-8 bg-white reveal-item">
			<div class="max-w-6xl mx-auto text-center">
				<h2
					class="text-3xl md:text-4xl font-extrabold font-display tracking-tight text-[#2a3035] mb-16 uppercase"
				>
					Nuestro Equipo de Trabajo
				</h2>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{
						leaders.map((leader: any) => (
							<div class="bg-white flex flex-col group border border-gray-200 hover:border-[#1d4c74] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-default rounded-none">
								<div class={`w-full aspect-[3/5] overflow-hidden bg-white ${leader.containerClass || ""}`}>
									<img
										src={leader.image.src}
										alt={leader.name}
										class={`w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ${leader.position || "object-center"} ${leader.imgClass || ""}`}
									/>
								</div>
								<div class="p-8 flex flex-col items-center text-center font-body">
									<h3 class="font-extrabold text-xl text-[#2a3035] font-display">
										{leader.name}
									</h3>
									<p class="text-xs font-bold text-[#1d4c74] mt-1.5 uppercase tracking-widest font-ui">
										{leader.role}
									</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>
		<!-- ISO Certification Section -->
		<section
			class="py-28 px-6 md:px-8 bg-[#1d4c74] border-y border-white/5 reveal-item relative overflow-hidden"
		>
			<!-- Background Watermark Text -->
			<div
				class="absolute right-0 bottom-0 text-[15rem] font-display font-black text-white/5 select-none pointer-events-none transform translate-y-1/4 translate-x-1/4 leading-none"
			>
				ISO 9001
			</div>

			<!-- Visual Pattern Overlay -->
			<div
				class="absolute inset-0 opacity-10 pointer-events-none"
				style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"
			>
			</div>

			<div
				class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center gap-16 relative z-10"
			>
				<!-- Floating ISO Seal -->
				<div class="w-full lg:w-2/5 flex justify-center">
					<div class="relative">
						<!-- Decorative Rings -->
						<div
							class="absolute inset-0 -m-8 border border-white/10 rounded-full animate-[spin_20s_linear_infinite]"
						>
						</div>
						<div
							class="absolute inset-0 -m-4 border border-white/20 rounded-full animate-[spin_15s_linear_infinite_reverse]"
						>
						</div>

						<!-- Glow Effect -->
						<div
							class="absolute inset-0 bg-white/20 rounded-full blur-3xl scale-125"
						>
						</div>

						<!-- The Logo itself (Transparent/Circular focus) -->
						<div class="relative z-10 w-64 h-64 md:w-72 md:h-72">
							<img
								src={isoImg.src}
								alt="Certificado ISO 9001"
								class="w-full h-full object-contain filter drop-shadow-[0_15px_35px_rgba(0,0,0,0.5)] transition-transform duration-700 hover:scale-105"
							/>
						</div>

						<!-- Bottom Badge Label -->
						<div
							class="absolute -bottom-12 left-1/2 -translate-x-1/2 bg-white text-[#1d4c74] font-ui font-black px-6 py-2 rounded-sm shadow-2xl skew-x-[-10deg] whitespace-nowrap text-xs md:text-sm tracking-widest border-r-4 border-b-4 border-gray-200"
						>
							ESTÁNDAR CERTIFICADO
						</div>
					</div>
				</div>

				<!-- Text Content -->
				<div class="w-full lg:w-3/5 space-y-8 text-center lg:text-left">
					<h2
						class="text-3xl md:text-5xl font-extrabold font-display tracking-tight text-white leading-tight min-h-[160px] md:min-h-[120px] flex items-center lg:items-start"
					>
						<span>
							Compromiso con la <br class="md:hidden" />
							<span id="typewriter-word" class="text-white"
							></span>
							<br class="md:hidden" /> e Innovación Sostenible
						</span>
					</h2>
					<div class="w-24 h-1 bg-white/30 hidden lg:block"></div>
					<p
						class="text-lg md:text-xl font-body text-gray-200 leading-relaxed max-w-2xl opacity-90"
					>
						Nuestra excelencia no es una coincidencia, es el
						resultado de procesos estandarizados bajo la norma <span
							class="text-white font-bold border-b-2 border-white/20 pb-0.5"
							>ISO 9001:2015</span
						>. Certificamos cada eslabón de nuestra cadena de valor.
					</p>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-4">
						<div
							class="space-y-3 p-6 bg-white/5 border-l-2 border-white/30 backdrop-blur-sm group hover:bg-white/10 transition-colors"
						>
							<div class="flex items-center gap-3">
								<div class="text-white text-xl">
									<FaCheckCircle />
								</div>
								<h4
									class="font-display font-bold text-white uppercase text-sm tracking-widest"
								>
									Mejora Continua
								</h4>
							</div>
							<p
								class="text-sm font-body text-gray-300 leading-relaxed"
							>
								Optimizamos constantemente cada fase de
								producción para garantizar eficiencia.
							</p>
						</div>
						<div
							class="space-y-3 p-6 bg-white/5 border-l-2 border-white/30 backdrop-blur-sm group hover:bg-white/10 transition-colors"
						>
							<div class="flex items-center gap-3">
								<div class="text-white text-xl">
									<FaCheckCircle />
								</div>
								<h4
									class="font-display font-bold text-white uppercase text-sm tracking-widest"
								>
									Confianza Global
								</h4>
							</div>
							<p
								class="text-sm font-body text-gray-300 leading-relaxed"
							>
								Garantizamos que cada entrega supere las
								expectativas técnicas de nuestros socios
								internacionales.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

