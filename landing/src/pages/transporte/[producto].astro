---
import "../../styles/global.css";
import {
	FaSearch,
	FaBars,
	FaTimes,
	FaArrowRight,
	FaLinkedinIn,
	FaInstagram,
	FaTwitter,
	FaCheckCircle,
	FaShoppingCart,
} from "react-icons/fa";
import { MdMarkEmailRead } from "react-icons/md";
import { FaPhoneSquareAlt } from "react-icons/fa";
import libroImg from "../../assets/libro-reclamaciones.png";

// Imágenes de la División Transporte
import transporteImg03 from "../../assets/transporte/transporte-image-03.png";
import transporteImg04 from "../../assets/transporte/transporte-image-04.png";
import transporteImg05 from "../../assets/transporte/transporte-image-05.png";
import transporteImg06 from "../../assets/transporte/transporte-image-06.png";

export async function getStaticPaths() {
	const allProducts = [
		{
			id: "carga-pesada",
			title: "Transporte de Carga Pesada",
			ref: "TRN-NAC",
			image: transporteImg03,
			specs: "Nivel Nacional | Plataformas y Furgones",
			description:
				"Servicio integral de transporte terrestre a nivel nacional. Contamos con una moderna flota de tractocamiones, plataformas, camas bajas y furgones cerrados. Garantizamos la máxima seguridad y puntualidad en el traslado de sus mercancías a cualquier punto del país, con monitoreo GPS 24/7.",
			features: [
				"Cobertura a nivel nacional",
				"Monitoreo satelital en tiempo real",
				"Conductores altamente capacitados",
				"Seguro de carga de amplia cobertura",
			],
		},
		{
			id: "logistica-internacional",
			title: "Logística Internacional",
			ref: "TRN-INT",
			image: transporteImg04,
			specs: "Aéreo & Marítimo | FCL y LCL",
			description:
				"Conectamos sus operaciones con el mundo. Ofrecemos soluciones integrales de transporte internacional de carga (Freight Forwarding) aéreo y marítimo. Gestionamos cargas completas (FCL) y consolidadas (LCL), encargándonos del agenciamiento aduanero y toda la documentación necesaria para importaciones y exportaciones exitosas.",
			features: [
				"Red global de agentes asociados",
				"Consolidación de carga (LCL/LTL)",
				"Agenciamiento aduanero integrado",
				"Asesoría en comercio exterior",
			],
		},
		{
			id: "ultima-milla",
			title: "Distribución Última Milla",
			ref: "TRN-ULL",
			image: transporteImg05,
			specs: "Urbano | Flota Ligera B2B/B2C",
			description:
				"Aseguramos que sus productos lleguen a las manos de sus clientes de manera rápida y eficiente. Nuestro servicio de distribución urbana y de última milla está diseñado para operaciones B2B y B2C, apoyado por plataformas tecnológicas de ruteo dinámico y prueba de entrega electrónica (e-POD).",
			features: [
				"Ruteo inteligente y dinámico",
				"Prueba de entrega electrónica (e-POD)",
				"Flota ligera y versátil",
				"Alta tasa de entrega exitosa en el primer intento",
			],
		},
		{
			id: "especializado",
			title: "Transporte Especializado",
			ref: "TRN-ESP",
			image: transporteImg06,
			specs: "Refrigerado / Peligroso / Sobredimensionado",
			description:
				"Soluciones a la medida para cargas que requieren un manejo especial. Contamos con furgones refrigerados con control estricto de temperatura, unidades certificadas para materiales peligrosos (MATPEL) y equipamiento especializado para carga sobredimensionada o proyectos complejos.",
			features: [
				"Control estricto de cadena de frío",
				"Certificación y personal calificado MATPEL",
				"Escoltas y permisos para carga sobredimensionada",
				"Protocolos de seguridad especializados",
			],
		},
	];

	return allProducts.map((product) => ({
		params: { producto: product.id },
		props: {
			product,
			otherProducts: allProducts.filter((p) => p.id !== product.id),
		},
	}));
}

const { product, otherProducts } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{product.title} | Transporte | Grupo Prevca</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Outfit:wght@400;600&family=Inter:wght@300;400&display=swap"
			rel="stylesheet"
		/>
		<style>
			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}
			.loader-spinner {
				border: 3px solid rgba(255, 255, 255, 0.1);
				border-left-color: #1d4c74;
				border-radius: 50%;
				width: 50px;
				height: 50px;
				animation: spin 0.8s linear infinite;
			}
			.reveal-item {
				opacity: 0;
				transform: translateY(30px);
				transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.reveal-item.active {
				opacity: 1;
				transform: translateY(0);
			}
			.nav-link {
				position: relative;
			}
			.nav-link::after {
				content: "";
				position: absolute;
				bottom: -2px;
				left: 0;
				width: 0;
				height: 2px;
				background-color: white;
				transition: width 0.3s ease;
			}
			.nav-link:hover::after {
				width: 100%;
			}
		</style>
	</head>
	<body
		class="bg-gray-50 text-gray-800 font-body selection:bg-[#1d4c74] selection:text-white overflow-x-hidden"
	>
		<!-- CORPORATE LOADER -->
		<div
			id="loader-overlay"
			class="fixed inset-0 z-[100] flex flex-col items-center justify-center transition-opacity duration-700"
		>
			<div class="absolute inset-0 bg-black/30 backdrop-blur-md"></div>
			<div class="relative z-10">
				<div class="loader-spinner"></div>
			</div>
		</div>

		<!-- Main Navbar -->
		<nav
			class="bg-[#2a3035] text-white py-4 px-6 md:px-8 flex justify-between items-center font-ui sticky top-0 z-50 transition-all duration-300"
		>
			<div class="flex items-center gap-3">
				<div
					class="w-7 h-7 md:w-8 md:h-8 bg-white text-[#2a3035] font-extrabold flex items-center justify-center font-display text-base md:text-lg shadow-none rounded-none"
				>
					P
				</div>
				<span
					class="text-xl md:text-2xl font-extrabold tracking-widest font-display uppercase"
					>GRUPO PREVCA</span
				>
			</div>

			<!-- Desktop Menu -->
			<div
				class="hidden lg:flex gap-8 text-sm font-semibold tracking-wide uppercase items-center"
			>
				<a
					href="/"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Inicio</a
				>
				<a
					href="/nosotros"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Sobre Nosotros</a
				>
				<a
					href="/madera"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Madera</a
				>
				<a
					href="/hospitalidad"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Hospitalidad</a
				>
				<a
					href="/cafe"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Café</a
				>
				<a
					href="/transporte"
					class="nav-link text-white border-b-2 border-white cursor-pointer"
					>Transporte</a
				>
				<a
					href="/#contact-section"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Contacto</a
				>

				<!-- Cart Icon -->
				<a
					href="/ecommerce"
					class="relative cursor-pointer hover:text-gray-300 transition-colors ml-2 mr-4 flex items-center"
				>
					<div class="text-xl"><FaShoppingCart /></div>
					<span
						id="cart-count-desktop"
						class="absolute top-[-6px] right-[-14px] w-4 h-4 flex items-center justify-center bg-white text-[#2a3035] text-[10px] font-extrabold rounded-full shadow-md leading-none pt-[1px]"
					>0</span>
				</a>
			</div>

			<!-- Mobile Menu Toggle -->
			<button
				id="menu-toggle"
				class="lg:hidden text-2xl text-white cursor-pointer"
			>
				<div id="icon-bars"><FaBars /></div>
				<div id="icon-times" class="hidden"><FaTimes /></div>
			</button>
		</nav>

		<!-- Mobile Menu Drawer -->
		<div
			id="mobile-menu"
			class="fixed inset-0 bg-[#2a3035] z-40 transform translate-x-full transition-transform duration-300 lg:hidden pt-24 px-8 overflow-y-auto"
		>
			<div
				class="flex flex-col gap-6 text-xl text-white font-ui uppercase font-bold tracking-widest"
			>
				<a href="/" class="border-b border-white/10 pb-4 cursor-pointer"
					>Inicio</a
				>
				<a
					href="/nosotros"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Sobre Nosotros</a
				>
				<a
					href="/madera"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Madera</a
				>
				<a
					href="/hospitalidad"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Hospitalidad</a
				>
				<a
					href="/cafe"
					class="border-b border-white/10 pb-4 cursor-pointer">Café</a
				>
				<a
					href="/transporte"
					class="border-b border-white/10 pb-4 cursor-pointer">Transporte</a
				>
				<a
					href="/#contact-section"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Contacto</a
				>
				<div
					class="border-b border-white/10 pb-4 cursor-pointer flex justify-between items-center text-[#1d4c74] bg-white px-4 rounded-none shadow-sm"
				>
					<span class="flex items-center gap-3"
						><FaShoppingCart /> Mi Carrito</span
					>
					<span
						id="cart-count-mobile"
						class="bg-[#2a3035] text-white text-xs font-bold w-6 h-6 flex items-center justify-center rounded-full"
						>0</span
					>
				</div>
				<a
					href="/ecommerce"
					class="bg-[#1d4c74] text-center py-4 mt-2 cursor-pointer text-sm"
					>Tienda Virtual</a
				>
			</div>
		</div>

		<!-- Breadcrumb -->
		<div class="bg-white border-b border-gray-200">
			<div
				class="max-w-7xl mx-auto px-6 md:px-8 py-4 text-sm font-ui text-gray-500 uppercase tracking-widest font-bold"
			>
				<a href="/transporte" class="hover:text-[#1d4c74] transition-colors"
					>División Transporte</a
				>
				<span class="mx-2">/</span>
				<span class="text-[#1d4c74]">{product.title}</span>
			</div>
		</div>

		<!-- Product Detail Section -->
		<section class="pt-8 pb-16 md:pt-12 md:pb-24 px-6 md:px-8 bg-white">
			<div
				class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-start"
			>
				<!-- Image -->
				<div class="reveal-item">
					<div class="bg-gray-100 p-2 md:p-4 border border-gray-100 rounded-none">
						<img
							src={product.image.src}
							alt={product.title}
							class="w-full h-auto object-cover rounded-none"
						/>
					</div>
				</div>

				<!-- Details -->
				<div
					class="space-y-8 reveal-item"
					style="transition-delay: 100ms;"
				>
					<div>
						<div class="flex items-center gap-4 mb-3">
							<span
								class="bg-[#1d4c74]/10 text-[#1d4c74] text-[10px] md:text-xs font-bold px-3 py-1 uppercase tracking-wider rounded-none"
								>Ref: {product.ref}</span
							>
						</div>
						<h1
							class="text-4xl md:text-5xl font-extrabold font-display text-[#2a3035] leading-tight mb-4"
						>
							{product.title}
						</h1>
						<p
							class="text-xl font-body text-gray-500 font-semibold mb-6"
						>
							{product.specs}
						</p>
					</div>

					<div class="w-full h-px bg-gray-200"></div>

					<div>
						<h3
							class="text-[#1d4c74] font-bold font-display text-lg mb-3"
						>
							Descripción del Servicio
						</h3>
						<p
							class="text-gray-600 font-body leading-relaxed text-base"
						>
							{product.description}
						</p>
					</div>

					<div class="bg-gray-50 p-6 md:p-8 border border-gray-100 rounded-none">
						<h3
							class="text-[#2a3035] font-bold font-display text-lg mb-4"
						>
							Características Principales
						</h3>
						<ul class="space-y-3">
							{
								product.features.map((feature) => (
									<li class="flex items-center gap-3 text-gray-600 font-body">
										<div class="text-[#1d4c74] flex-shrink-0">
											<FaCheckCircle />
										</div>
										<span>{feature}</span>
									</li>
								))
							}
						</ul>
					</div>

					<div class="pt-4 flex flex-col lg:flex-row gap-4 items-stretch">
						<div class="flex items-stretch border border-gray-300 bg-white text-[#2a3035] font-ui font-bold h-[56px] lg:h-auto rounded-none">
							<button id="qty-minus" class="w-12 hover:bg-gray-100 transition-colors border-r border-gray-300 cursor-pointer text-xl flex items-center justify-center rounded-none">-</button>
							<input id="qty-input" type="number" value="1" min="1" class="w-14 text-center m-0 p-0 outline-none bg-transparent text-lg [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none rounded-none" />
							<button id="qty-plus" class="w-12 hover:bg-gray-100 transition-colors border-l border-gray-300 cursor-pointer text-xl flex items-center justify-center rounded-none">+</button>
						</div>

						<button
							id="add-to-cart-btn"
							data-product={product.id}
							class="flex-1 bg-[#1d4c74] text-white font-bold px-4 py-4 uppercase font-ui tracking-widest hover:bg-[#2a3035] transition-colors border border-[#1d4c74] flex items-center justify-center gap-3 cursor-pointer shadow-lg hover:shadow-xl text-sm rounded-none"
						>
							<span class="text-xl"><FaShoppingCart /></span>
							<span class="whitespace-nowrap">Agregar al Carrito</span>
						</button>
						<a
							href="/ecommerce"
							class="flex-1 flex items-center justify-center text-center bg-white text-[#1d4c74] font-bold px-4 py-4 uppercase font-ui tracking-widest hover:bg-gray-50 transition-colors border-2 border-[#1d4c74] text-sm rounded-none"
						>
							Ir a Cotizar
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Related Products Section -->
		<section class="py-24 px-6 md:px-8 bg-gray-50">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16 reveal-item">
					<h2
						class="text-3xl font-extrabold font-display text-[#2a3035]"
					>
						Otros Servicios Logísticos
					</h2>
					<div class="w-16 h-1 bg-[#1d4c74] mx-auto mt-6"></div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 reveal-item">
					{
						otherProducts.map((related) => (
							<div class="bg-white border border-gray-200 group hover:border-[#1d4c74] transition-colors flex flex-col rounded-none">
								<div class="h-48 overflow-hidden bg-gray-100 relative rounded-none">
									<img
										src={related.image.src}
										alt={related.title}
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 rounded-none"
									/>
								</div>
								<div class="p-6 flex flex-col flex-grow">
									<h3 class="font-display font-bold text-[#2a3035] leading-tight mb-2">
										{related.title}
									</h3>
									<p class="text-sm text-gray-500 font-body mb-6">
										{related.specs}
									</p>
									<div class="flex justify-between items-center text-xs font-bold text-gray-400 mt-auto pt-4 border-t border-gray-100">
										<span>Ref: {related.ref}</span>
										<a
											href={`/transporte/${related.id}`}
											class="text-[#1d4c74] hover:text-[#153a5b] flex items-center gap-1 group-hover:gap-2 transition-all"
										>
											Detalles <FaArrowRight />
										</a>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="bg-[#2a3035] text-white pt-24 pb-12 px-6 md:px-8">
			<!-- ... Footer Content ... -->
			<div
				class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-12 lg:gap-16 mb-24"
			>
				<div class="space-y-8">
					<div class="flex items-center gap-3">
						<div
							class="w-8 h-8 bg-white text-[#2a3035] font-extrabold flex items-center justify-center font-display text-lg rounded-none"
						>
							P
						</div>
						<span
							class="text-2xl font-extrabold tracking-widest font-display uppercase"
							>PREVCA</span
						>
					</div>
					<p
						class="text-gray-400 text-sm font-body leading-relaxed max-w-xs"
					>
						Elevando estándares corporativos a través de la
						excelencia operativa y la diversificación estratégica.
					</p>
					<div class="flex gap-4">
						<a
							href="#"
							class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all rounded-none"
							><FaLinkedinIn /></a
						>
						<a
							href="#"
							class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all rounded-none"
							><FaInstagram /></a
						>
						<a
							href="#"
							class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all rounded-none"
							><FaTwitter /></a
						>
					</div>
				</div>

				<!-- Contacto -->
				<div>
					<h4 class="font-extrabold mb-8 text-sm opacity-70">
						Contacto
					</h4>
					<div class="space-y-6 text-sm font-body">
						<p class="flex items-center gap-3">
							<span class="text-white text-xl"
								><FaPhoneSquareAlt /></span
							>
							<span
								class="text-gray-400 hover:text-white transition-colors cursor-pointer"
								>+51 987 654 321</span
							>
						</p>
						<p class="flex items-center gap-3">
							<span class="text-white text-xl"
								><MdMarkEmailRead /></span
							>
							<span
								class="text-gray-400 hover:text-white transition-colors cursor-pointer"
								>info@grupoprevca.com</span
							>
						</p>
					</div>
				</div>

				<!-- Libro de Reclamaciones -->
				<div>
					<h4 class="mb-6 text-sm opacity-70 text-white">
						Atención al Cliente
					</h4>
					<div class="flex flex-col gap-3 mt-2">
						<a
							href="#"
							class="bg-white p-1 hover:-translate-y-1 transition-transform cursor-pointer border-b-4 border-[#1d4c74] max-w-[200px] w-full flex justify-center items-center shadow-lg rounded-none"
						>
							<img
								src={libroImg.src}
								alt="Libro de Reclamaciones"
								class="w-full h-auto max-h-24 object-contain rounded-none"
							/>
						</a>
						<p
							class="text-[11px] text-gray-500 font-body uppercase tracking-widest pl-1 mt-1 font-bold"
						>
							Conforme a la Ley N° 29571
						</p>
					</div>
				</div>

				<!-- Corporativo Links -->
				<div>
					<h4 class="font-extrabold mb-6 text-sm opacity-70">
						Corporativo
					</h4>
					<ul class="space-y-4 text-sm text-gray-400 font-body">
						<li>
							<a
								href="/nosotros"
								class="hover:text-white transition-all underline-offset-4 hover:underline"
								>Sobre Nosotros</a
							>
						</li>
						<li>
							<a
								href="/#contact-section"
								class="hover:text-white transition-all underline-offset-4 hover:underline"
								>Centro de Contacto</a
							>
						</li>
						<li>
							<button
								id="btn-privacy"
								class="hover:text-white transition-all underline-offset-4 hover:underline cursor-pointer bg-transparent border-none p-0 text-gray-400"
								>Política de Privacidad</button
							>
						</li>
						<li>
							<button
								id="btn-terms"
								class="hover:text-white transition-all underline-offset-4 hover:underline cursor-pointer bg-transparent border-none p-0 text-gray-400"
								>Términos Legales</button
							>
						</li>
					</ul>
				</div>
			</div>
			<div
				class="max-w-7xl mx-auto border-t border-white/5 pt-12 flex flex-col md:flex-row justify-between items-center gap-8 text-xs font-ui tracking-[0.2em] text-gray-500 uppercase font-bold"
			>
				<p>© 2024 GRUPO PREVCA. TODOS LOS DERECHOS RESERVADOS.</p>
				<p>
					DISCUSIÓN Y DISEÑO POR <span class="text-white"
						>TRIGA S.A.C.</span
					>
				</p>
			</div>
		</footer>

		<script is:inline>
			document.addEventListener("DOMContentLoaded", () => {
				const body = document.body;
				const loader = document.getElementById("loader-overlay");
				setTimeout(() => {
					loader.style.opacity = "0";
					setTimeout(() => {
						loader.style.display = "none";
					}, 700);
				}, 500);

				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting)
								entry.target.classList.add("active");
						});
					},
					{ threshold: 0.15 },
				);
				document
					.querySelectorAll(".reveal-item")
					.forEach((el) => observer.observe(el));

				// Mobile Menu
				const menuToggle = document.getElementById("menu-toggle");
				const mobileMenu = document.getElementById("mobile-menu");
				const iconBars = document.getElementById("icon-bars");
				const iconTimes = document.getElementById("icon-times");

				menuToggle?.addEventListener("click", () => {
					const isOpen =
						mobileMenu.classList.contains("translate-x-0");
					if (isOpen) {
						mobileMenu.classList.replace(
							"translate-x-0",
							"translate-x-full",
						);
						iconBars.classList.remove("hidden");
						iconTimes.classList.add("hidden");
						body.style.overflow = "auto";
					} else {
						mobileMenu.classList.replace(
							"translate-x-full",
							"translate-x-0",
						);
						iconBars.classList.add("hidden");
						iconTimes.classList.remove("hidden");
						body.style.overflow = "hidden";
					}
				});

				// Cart Logic & Animation
				const updateCartUI = () => {
					const cart = JSON.parse(localStorage.getItem('prevca_cart')) || [];
					const totalItems = cart.reduce((acc, item) => acc + item.quantity, 0);
					const desktopBadge = document.getElementById('cart-count-desktop');
					const mobileBadge = document.getElementById('cart-count-mobile');
					if (desktopBadge) desktopBadge.textContent = totalItems;
					if (mobileBadge) mobileBadge.textContent = totalItems;
				};

				updateCartUI();

				// Quantity Selector
				const qtyMinus = document.getElementById('qty-minus');
				const qtyPlus = document.getElementById('qty-plus');
				const qtyInput = document.getElementById('qty-input');

				if (qtyMinus && qtyPlus && qtyInput) {
					qtyMinus.addEventListener('click', () => {
						const current = parseInt(qtyInput.value) || 1;
						if (current > 1) qtyInput.value = current - 1;
					});
					qtyPlus.addEventListener('click', () => {
						const current = parseInt(qtyInput.value) || 1;
						qtyInput.value = current + 1;
					});
				}

				// Fly Animation
				const flyToCart = (startEl, endEl) => {
					if (!startEl || !endEl) return;
					const startRect = startEl.getBoundingClientRect();
					const endRect = endEl.getBoundingClientRect();

					const dot = document.createElement('div');
					dot.style.position = 'fixed';
					dot.style.width = '16px';
					dot.style.height = '16px';
					dot.style.borderRadius = '50%';
					dot.style.backgroundColor = '#1d4c74';
					dot.style.zIndex = '9999';
					dot.style.pointerEvents = 'none';
					dot.style.left = `${startRect.left + startRect.width / 2}px`;
					dot.style.top = `${startRect.top + startRect.height / 2}px`;
					dot.style.transition = 'all 0.6s cubic-bezier(0.2, 0.8, 0.2, 1)';
					document.body.appendChild(dot);

					// Force reflow
					dot.getBoundingClientRect();

					dot.style.left = `${endRect.left + endRect.width / 2}px`;
					dot.style.top = `${endRect.top + endRect.height / 2}px`;
					dot.style.transform = 'scale(0.2)';
					dot.style.opacity = '0.5';

					setTimeout(() => dot.remove(), 600);
				};

				const addToCartBtn = document.getElementById('add-to-cart-btn');
				const checkIconSvg = `<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"></path></svg>`;

				if (addToCartBtn) {
					addToCartBtn.addEventListener('click', () => {
						const qty = parseInt(qtyInput?.value) || 1;
						const productId = addToCartBtn.getAttribute('data-product');
						const cart = JSON.parse(localStorage.getItem('prevca_cart')) || [];
						
						const existingItem = cart.find(item => item.id === productId);
						if (existingItem) {
							existingItem.quantity += qty;
						} else {
							cart.push({ id: productId, quantity: qty });
						}
						
						localStorage.setItem('prevca_cart', JSON.stringify(cart));
						
						// Trigger Animation
						const targetBadge = window.innerWidth >= 1024 ? document.getElementById('cart-count-desktop') : document.getElementById('cart-count-mobile');
						flyToCart(addToCartBtn, targetBadge);
						
						// Update numbers slightly before animation finishes
						setTimeout(() => updateCartUI(), 500); 

						// Visual feedback
						const originalHtml = addToCartBtn.innerHTML;
						addToCartBtn.innerHTML = `<span class="text-xl">${checkIconSvg}</span> <span class="whitespace-nowrap">Agregado</span>`;
						addToCartBtn.classList.replace('bg-[#1d4c74]', 'bg-green-600');
						addToCartBtn.classList.replace('border-[#1d4c74]', 'border-green-600');
						setTimeout(() => {
							addToCartBtn.innerHTML = originalHtml;
							addToCartBtn.classList.replace('bg-green-600', 'bg-[#1d4c74]');
							addToCartBtn.classList.replace('border-green-600', 'border-[#1d4c74]');
						}, 1500);
					});
				}
			});
		</script>
	</body>
</html>
