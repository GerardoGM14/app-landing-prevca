---
import "../styles/global.css";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Prevca - Landing Page</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#050505] text-white font-['Outfit'] selection:bg-purple-500/30">
		<main class="min-h-screen relative overflow-hidden flex flex-col justify-center items-center px-4">
			<!-- Bakground Glow -->
			<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-purple-600/20 blur-[120px] rounded-full"></div>
			<div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-blue-600/20 blur-[120px] rounded-full"></div>

			<nav class="absolute top-0 w-full p-8 flex justify-between items-center max-w-7xl">
				<div class="text-2xl font-bold tracking-tighter">PREVCA</div>
				<div class="hidden md:flex gap-8 text-sm font-medium opacity-60">
					<a href="#" class="hover:opacity-100 transition-opacity">Inicio</a>
					<a href="#" class="hover:opacity-100 transition-opacity">Servicios</a>
					<a href="#" class="hover:opacity-100 transition-opacity">Contacto</a>
				</div>
				<a href="/ecommerce" class="px-5 py-2 rounded-full border border-white/10 bg-white/5 hover:bg-white/10 transition-colors text-sm font-medium">
					Ir a la Tienda
				</a>
			</nav>

			<section class="text-center space-y-8 relative z-10 max-w-3xl">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-purple-500/30 bg-purple-500/10 text-xs font-semibold text-purple-300 animate-pulse">
					🚀 Lanzamiento Próximamente
				</div>
				<h1 class="text-6xl md:text-8xl font-bold tracking-tight leading-[0.9]">
					Transforma tu <span class="bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent">Visión</span> en Realidad
				</h1>
				<p class="text-lg md:text-xl text-neutral-400 max-w-xl mx-auto font-light leading-relaxed">
					La solución integral para tu negocio digital. Landing pages rápidas, ecommerce fluido y backend potente.
				</p>
				<div class="flex flex-col md:flex-row gap-4 justify-center items-center pt-4">
					<button class="w-full md:w-auto px-8 py-4 bg-white text-black rounded-full font-bold hover:scale-105 transition-transform">
						Empezar Ahora
					</button>
					<button class="w-full md:w-auto px-8 py-4 bg-white/5 border border-white/10 rounded-full font-bold hover:bg-white/10 transition-colors">
						Saber Más
					</button>
				</div>
			</section>
		</main>
	</body>
</html>
