		<!-- CLIENT SIDE LOGIC -->
		<script is:inline>
			document.addEventListener("DOMContentLoaded", () => {
				// 1. LOADER HIDER
				const loader = document.getElementById("loader-overlay");
				const body = document.body;

				window.addEventListener("load", () => {
					setTimeout(() => {
						if (loader) {
							loader.classList.add("opacity-0");
							setTimeout(() => {
								loader.classList.add("hidden");
								startTypewriter(); // Start typewriter after loader
							}, 700);
						}
					}, 300);
				});

				// 2. TYPEWRITER LOGIC
				const typewriterElement =
					document.getElementById("typewriter-text");
				const targetText = "Excelencia en Madera, Hospitalidad y Café";

				function startTypewriter() {
					let i = 0;
					typewriterElement.textContent = "";
					function type() {
						if (i < targetText.length) {
							typewriterElement.textContent +=
								targetText.charAt(i);
							i++;
							setTimeout(type, 50);
						} else {
							typewriterElement.classList.remove(
								"typewriter-cursor",
							);
						}
					}
					type();
				}

				// 3. REVEAL & COUNTER LOGIC (Intersection Observer)
				const revealItems = document.querySelectorAll(".reveal-item");
				const stats = document.querySelectorAll(".stat-number");

				const observerOptions = {
					threshold: 0.2,
					rootMargin: "0px 0px -50px 0px",
				};

				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("active");

							// If it's a stat section, trigger counter
							if (
								entry.target.contains(stats[0]) ||
								entry.target.classList.contains("stat-number")
							) {
								triggerCounters();
							}
						}
					});
				}, observerOptions);

				revealItems.forEach((item) => observer.observe(item));

				function triggerCounters() {
					stats.forEach((stat) => {
						const target = parseInt(
							stat.getAttribute("data-target"),
						);
						const duration = 2000; // 2 seconds
						const stepTime = 20;
						const totalSteps = duration / stepTime;
						const increment = target / totalSteps;
						let current = 0;

						if (stat.getAttribute("data-started")) return;
						stat.setAttribute("data-started", "true");

						const timer = setInterval(() => {
							current += increment;
							if (current >= target) {
								stat.textContent =
									target +
									(target === 100 &&
									stat.textContent.includes("%")
										? "%"
										: "");
								if (stat.getAttribute("data-target") === "100")
									stat.textContent += "";
								clearInterval(timer);
							} else {
								stat.textContent = Math.floor(current);
							}
						}, stepTime);
					});
				}

				// 4. COOKIE LOGIC
				const cookieBanner = document.getElementById("cookie-banner");
				const cookieOverlay = document.getElementById("cookie-overlay");
				const cookieAcceptBtn =
					document.getElementById("cookie-accept");
				const cookieRejectBtn =
					document.getElementById("cookie-reject");

				const hideCookies = () => {
					if (cookieBanner)
						cookieBanner.style.transform = "translateY(100%)";
					if (cookieOverlay) {
						cookieOverlay.classList.remove("opacity-100");
						cookieOverlay.classList.add("opacity-0");
						cookieOverlay.classList.add("pointer-events-none");
					}
					setTimeout(() => {
						if (cookieBanner) cookieBanner.classList.add("hidden");
						if (cookieOverlay)
							cookieOverlay.classList.add("hidden");
					}, 500);
				};

				if (!localStorage.getItem("prevca_cookies_accepted")) {
					setTimeout(() => {
						if (cookieBanner)
							cookieBanner.style.transform = "translateY(0)";
						if (cookieOverlay) {
							cookieOverlay.classList.remove(
								"opacity-0",
								"pointer-events-none",
							);
							cookieOverlay.classList.add("opacity-100");
						}
					}, 1500);
				} else {
					if (cookieBanner) cookieBanner.classList.add("hidden");
					if (cookieOverlay) cookieOverlay.classList.add("hidden");
				}

				cookieAcceptBtn?.addEventListener("click", () => {
					localStorage.setItem("prevca_cookies_accepted", "true");
					hideCookies();
				});

				cookieRejectBtn?.addEventListener("click", () => {
					localStorage.setItem("prevca_cookies_accepted", "false");
					hideCookies();
				});

				// 5. LEGAL MODALS LOGIC
				const btnPrivacy = document.getElementById("btn-privacy");
				const btnTerms = document.getElementById("btn-terms");
				const modalPrivacy = document.getElementById("modal-privacy");
				const modalTerms = document.getElementById("modal-terms");
				const closeBtns = document.querySelectorAll(".modal-close");

				const toggleModal = (modal, show) => {
					if (show) {
						modal.classList.add("active");
						body.style.overflow = "hidden";
					} else {
						modal.classList.remove("active");
						body.style.overflow = "auto";
					}
				};

				btnPrivacy?.addEventListener("click", () =>
					toggleModal(modalPrivacy, true),
				);
				btnTerms?.addEventListener("click", () =>
					toggleModal(modalTerms, true),
				);

				closeBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						toggleModal(modalPrivacy, false);
						toggleModal(modalTerms, false);
					});
				});

				// Close on click outside content
				[modalPrivacy, modalTerms].forEach((modal) => {
					modal?.addEventListener("click", (e) => {
						if (e.target === modal) toggleModal(modal, false);
					});
				});

				// 6. LOCAL SCROLL PROGRESS LOGIC (Contact Section)
				const scrollIndicator = document.getElementById(
					"scroll-progress-bar",
				);
				const contactSection =
					document.getElementById("contact-section");

				const updateProgress = () => {
					if (!contactSection || !scrollIndicator) return;

					const rect = contactSection.getBoundingClientRect();
					const windowHeight = window.innerHeight;

					// Mide el progreso desde que la sección aparece abajo hasta que desaparece arriba
					const startPoint = rect.top - windowHeight;
					const totalDistance = rect.height + windowHeight;
					const distanceScrolledIntoSection = -startPoint;

					let percentage =
						(distanceScrolledIntoSection / totalDistance) * 100;

					// Limitar estrictamente entre 0 y 100
					percentage = Math.max(0, Math.min(100, percentage));

					scrollIndicator.style.width = percentage + "%";
				};

				window.addEventListener("scroll", updateProgress);
				updateProgress(); // Llamada inicial

				// 7. MOBILE MENU LOGIC
				const toggle = document.getElementById("menu-toggle");
				const menu = document.getElementById("mobile-menu");
				const bars = document.getElementById("icon-bars");
				const times = document.getElementById("icon-times");

				if (toggle && menu && bars && times) {
					toggle.addEventListener("click", () => {
						const isCurrentlyOpen =
							menu.classList.contains("translate-x-full");

						if (isCurrentlyOpen) {
							menu.classList.remove("translate-x-full");
							menu.classList.add("translate-x-0");
							bars.classList.add("hidden");
							times.classList.remove("hidden");
							body.style.overflow = "hidden";
						} else {
							menu.classList.add("translate-x-full");
							menu.classList.remove("translate-x-0");
							bars.classList.remove("hidden");
							times.classList.add("hidden");
							body.style.overflow = "auto";
						}
					});
				}
			});
		</script>
	</body>
</html>
