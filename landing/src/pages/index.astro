---
import "../styles/global.css";
import {
	FaSearch,
	FaArrowLeft,
	FaArrowRight,
	FaLinkedinIn,
	FaInstagram,
	FaTwitter,
	FaBars,
	FaTimes,
	FaBullseye,
	FaEye,
	FaPhoneSquareAlt,
} from "react-icons/fa";
import { MdMarkEmailRead } from "react-icons/md";
import {
	HiArrowDownOnSquareStack,
	HiArrowUpOnSquareStack,
} from "react-icons/hi2";
import { LuCookie } from "react-icons/lu";
import libroImg from "../assets/libro-reclamaciones.png";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Grupo Prevca</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Outfit:wght@400;600&family=Inter:wght@300;400&display=swap"
			rel="stylesheet"
		/>
		<style>
			/* Spinner Animation */
			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}
			.loader-spinner {
				border: 3px solid rgba(255, 255, 255, 0.1);
				border-left-color: #1d4c74;
				border-radius: 50%;
				width: 50px;
				height: 50px;
				animation: spin 0.8s linear infinite;
			}
			/* Initial state for cookie banner */
			#cookie-banner {
				transform: translateY(100%);
			}

			/* Reveal on Scroll classes */
			.reveal-item {
				opacity: 0;
				transform: translateY(30px);
				transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.reveal-item.active {
				opacity: 1;
				transform: translateY(0);
			}

			/* Nav Link Animation */
			.nav-link {
				position: relative;
			}
			.nav-link::after {
				content: "";
				position: absolute;
				bottom: -2px;
				left: 0;
				width: 0;
				height: 2px;
				background-color: white;
				transition: width 0.3s ease;
			}
			.nav-link:hover::after {
				width: 100%;
			}

			/* Typewriter Cursor */
			.typewriter-cursor::after {
				content: "|";
				animation: blink 1s infinite;
				margin-left: 2px;
				color: #1d4c74;
			}
			@keyframes blink {
				0%,
				100% {
					opacity: 1;
				}
				50% {
					opacity: 0;
				}
			}

			/* Scroll Progress Bar Style */
			#scroll-progress-bar {
				width: 0%;
				transition: width 0.1s ease-out;
			}

			/* Legal Modals Styles */
			.modal-overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.5);
				backdrop-filter: blur(4px);
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 20px;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.3s ease;
			}
			.modal-overlay.active {
				opacity: 1;
				pointer-events: auto;
			}
			.modal-content {
				background: white;
				width: 100%;
				max-width: 800px;
				max-height: 80vh;
				overflow-y: auto;
				padding: 40px;
				border-radius: 2px;
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
				position: relative;
				border-top: 6px solid #1d4c74;
			}
			.modal-close {
				position: absolute;
				top: 20px;
				right: 20px;
				font-size: 24px;
				cursor: pointer;
				color: #2a3035;
				opacity: 0.5;
				transition: opacity 0.2s;
			}
			.modal-close:hover {
				opacity: 1;
			}
			.modal-body h3 {
				color: #1d4c74;
				font-weight: 700;
				font-family: "Outfit Variable", sans-serif;
				margin-bottom: 20px;
				letter-spacing: -0.01em;
			}
			.modal-body section {
				margin-bottom: 24px;
			}
			.modal-body h4 {
				font-weight: 700;
				margin-bottom: 8px;
				color: #2a3035;
			}
			.modal-body p {
				color: #4b5563;
				line-height: 1.6;
				margin-bottom: 12px;
			}
		</style>
	</head>
	<body
		class="bg-white text-gray-800 font-body selection:bg-[#1d4c74] selection:text-white overflow-x-hidden"
	>
		<!-- CORPORATE LOADER -->
		<div
			id="loader-overlay"
			class="fixed inset-0 z-[100] flex flex-col items-center justify-center transition-opacity duration-700"
		>
			<div class="absolute inset-0 bg-black/30 backdrop-blur-md"></div>
			<div class="relative z-10">
				<div class="loader-spinner"></div>
			</div>
		</div>

		<!-- Main Navbar -->
		<nav
			class="bg-[#2a3035] text-white py-4 px-6 md:px-8 flex justify-between items-center font-ui sticky top-0 z-50 transition-all duration-300"
		>
			<div class="flex items-center gap-3">
				<div
					class="w-7 h-7 md:w-8 md:h-8 bg-white text-[#2a3035] font-extrabold flex items-center justify-center font-display text-base md:text-lg shadow-none"
				>
					P
				</div>
				<span
					class="text-xl md:text-2xl font-extrabold tracking-widest font-display uppercase"
					>GRUPO PREVCA</span
				>
			</div>

			<!-- Desktop Menu -->
			<div
				class="hidden lg:flex gap-8 text-sm font-semibold tracking-wide uppercase"
			>
				<a
					href="/"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Inicio</a
				>
				<a
					href="#sobre-nosotros"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Sobre Nosotros</a
				>
				<a
					href="/madera"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Madera</a
				>
				<a
					href="/hospitalidad"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Hospitalidad</a
				>
				<a
					href="/cafe"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Café</a
				>
				<a
					href="/transporte"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Transporte</a
				>
				<a
					href="#contact-section"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Contacto</a
				>
			</div>

			<div class="hidden lg:flex gap-6 items-center">
				<button
					class="hover:text-gray-400 transition-colors text-lg cursor-pointer"
					aria-label="Buscar"><FaSearch /></button
				>
				<a
					href="/ecommerce"
					class="bg-[#1d4c74] text-white uppercase text-xs font-bold py-2 px-6 hover:bg-[#153a5b] transition-colors cursor-pointer border-none"
				>
					Tienda Virtual
				</a>
			</div>

			<!-- Mobile Toggle -->
			<button
				id="menu-toggle"
				class="lg:hidden text-2xl text-white cursor-pointer"
				aria-label="Menu"
			>
				<div id="icon-bars"><FaBars id="icon-bars" /></div>
				<div id="icon-times" class="hidden">
					<FaTimes id="icon-times" />
				</div>
			</button>
		</nav>

		<!-- Mobile Menu Drawer -->
		<div
			id="mobile-menu"
			class="fixed inset-0 bg-[#2a3035] z-40 transform translate-x-full transition-transform duration-300 lg:hidden pt-24 px-8 overflow-y-auto"
		>
			<div
				class="flex flex-col gap-6 text-xl text-white font-ui uppercase font-bold tracking-widest"
			>
				<a href="/" class="border-b border-white/10 pb-4 cursor-pointer"
					>Inicio</a
				>
				<a href="#sobre-nosotros" class="border-b border-white/10 pb-4 cursor-pointer"
					>Sobre Nosotros</a
				>
				<a href="/madera" class="border-b border-white/10 pb-4 cursor-pointer"
					>Madera</a
				>
				<a href="/hospitalidad" class="border-b border-white/10 pb-4 cursor-pointer"
					>Hospitalidad</a
				>
				<a href="/cafe" class="border-b border-white/10 pb-4 cursor-pointer"
					>Café</a
				>
				<a href="/transporte" class="border-b border-white/10 pb-4 cursor-pointer"
					>Transporte</a
				>
				<a href="#contact-section" class="border-b border-white/10 pb-4 cursor-pointer"
					>Contacto</a
				>
				<a
					href="/ecommerce"
					class="bg-[#1d4c74] text-center py-4 mt-4 cursor-pointer text-sm"
					>Tienda Virtual</a
				>
			</div>
		</div>

		<!-- Hero Section -->
		<header
			class="relative w-full h-[60vh] md:h-[70vh] flex flex-col md:flex-row bg-gray-900 border-b border-[#2a3035]"
		>
			<!-- 3 Background Slices (Stacked on Mobile, Columns on Desktop) -->
			<div
				class="w-full md:w-1/3 h-1/3 md:h-full bg-cover bg-center md:border-r border-white/10 grayscale-[0.3] hover:grayscale-0 transition-all duration-700"
				style="background-image: url('https://images.unsplash.com/photo-1563874093519-ca5eda5cd776?q=80&w=764&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');"
			>
			</div>
			<div
				class="w-full md:w-1/3 h-1/3 md:h-full bg-cover bg-center md:border-r border-white/10 grayscale-[0.3] hover:grayscale-0 transition-all duration-700"
				style="background-image: url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&q=80&w=1200');"
			>
			</div>
			<div
				class="w-full md:w-1/3 h-1/3 md:h-full bg-cover bg-center grayscale-[0.3] hover:grayscale-0 transition-all duration-700"
				style="background-image: url('https://images.unsplash.com/photo-1542372147193-a7aca54189cd?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');"
			>
			</div>
			<!-- Overlay Content -->
			<div
				class="absolute inset-0 bg-black/60 flex flex-col justify-center items-center text-white text-center p-6 md:p-12"
			>
				<h1
					class="text-4xl sm:text-6xl md:text-8xl font-extrabold font-display tracking-tighter mb-4 uppercase leading-none reveal-item"
				>
					GRUPO PREVCA
				</h1>
				<p
					id="typewriter-text"
					class="text-lg sm:text-xl md:text-2xl font-ui mb-8 font-light tracking-wide max-w-2xl px-4 text-gray-200 min-h-[1.5em] typewriter-cursor"
				>
					<!-- Text will be typed here -->
				</p>
				<button
					class="bg-[#1d4c74] text-white font-display font-extrabold tracking-widest uppercase py-4 px-10 hover:bg-[#153a5b] transition-colors text-sm border-2 border-[#1d4c74] cursor-pointer reveal-item"
				>
					Explorar Divisiones
				</button>
			</div>
		</header>

		<!-- About Us (Responsive Columns) -->
		<section
			id="sobre-nosotros"
			class="bg-[#1d4c74] text-white py-16 md:py-24 px-6 md:px-8 reveal-item relative overflow-hidden"
		>
			<!-- Subtle pattern overlay -->
			<div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>

			<div
				class="max-w-7xl mx-auto flex flex-col-reverse lg:flex-row items-center gap-10 md:gap-16 relative z-10"
			>
				<!-- Left Text -->
				<div class="w-full lg:w-1/2 space-y-6 md:space-y-8">
					<h2
						class="text-3xl md:text-4xl font-extrabold font-display uppercase tracking-widest text-white"
					>
						SOBRE NOSOTROS
					</h2>
					<div class="w-16 h-1.5 bg-white"></div>
					<p
						class="font-body text-gray-200 leading-relaxed text-base md:text-lg"
					>
						Grupo Prevca es un firme compromiso con la calidad y la
						innovación, adaptando nuestra gestión a las necesidades
						de los clientes y navegando nuevos retos con la
						experiencia de nuestro equipo. Desde las materias primas
						hasta las mejores experiencias, integramos la excelencia
						en todo lo que hacemos.
					</p>
					<a
						href="/nosotros"
						class="inline-block bg-white text-[#1d4c74] font-ui font-extrabold uppercase py-3.5 px-8 tracking-wider hover:bg-gray-100 transition-all text-xs md:text-sm mt-4 cursor-pointer"
					>
						LEER MÁS
					</a>
				</div>
				<!-- Right Image (Carousel Mock) -->
				<div class="w-full lg:w-1/2">
					<div
						class="relative w-full aspect-[16/9] md:aspect-[4/3] bg-gray-800 overflow-hidden border-[6px] border-white ring-1 ring-black/10"
					>
						<img
							src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1200"
							alt="Corporativo"
							class="w-full h-full object-cover"
						/>
						<!-- Simplified Controls -->
						<div class="absolute bottom-0 right-0 flex shadow-none">
							<button
								class="w-12 h-12 md:w-14 md:h-14 bg-[#2a3035] text-white flex items-center justify-center hover:bg-[#1d4c74] transition-colors cursor-pointer"
							>
								<FaArrowLeft />
							</button>
							<button
								class="w-12 h-12 md:w-14 md:h-14 bg-[#2a3035] text-white flex items-center justify-center hover:bg-[#1d4c74] transition-colors border-l border-white/20 cursor-pointer"
							>
								<FaArrowRight />
							</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Corporate Values & Stats (NEW) -->
		<section
			class="bg-white py-12 md:py-16 border-b border-gray-100 reveal-item"
		>
			<div
				class="max-w-7xl mx-auto px-6 md:px-8 grid grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12"
			>
				<div class="text-center space-y-2">
					<p
						class="text-4xl md:text-5xl font-display font-extrabold text-[#1d4c74] stat-number"
						data-target="25"
					>
						0
					</p>
					<p
						class="text-[10px] md:text-xs font-ui font-bold uppercase tracking-widest text-gray-500"
					>
						Años de Trayectoria
					</p>
				</div>
				<div class="text-center space-y-2">
					<p
						class="text-4xl md:text-5xl font-display font-extrabold text-[#1d4c74] stat-number"
						data-target="150"
					>
						0
					</p>
					<p
						class="text-[10px] md:text-xs font-ui font-bold uppercase tracking-widest text-gray-500"
					>
						Proyectos Globales
					</p>
				</div>
				<div class="text-center space-y-2">
					<p
						class="text-4xl md:text-5xl font-display font-extrabold text-[#1d4c74] stat-number"
						data-target="100"
					>
						0
					</p>
					<p
						class="text-[10px] md:text-xs font-ui font-bold uppercase tracking-widest text-gray-500"
					>
						Calidad Sostenible (%)
					</p>
				</div>
				<div class="text-center space-y-2">
					<p
						class="text-4xl md:text-5xl font-display font-extrabold text-[#1d4c74] stat-number"
						data-target="3"
					>
						0
					</p>
					<p
						class="text-[10px] md:text-xs font-ui font-bold uppercase tracking-widest text-gray-500"
					>
						Unidades de Negocio
					</p>
				</div>
			</div>
		</section>

		<!-- Mission & Vision (NEW) -->
		<section
			class="flex flex-col lg:flex-row w-full min-h-[450px] reveal-item"
		>
			<!-- Mission -->
			<div
				class="w-full lg:w-1/2 bg-[#2a3035] text-white p-12 md:p-20 flex flex-col justify-center gap-8 border-b lg:border-b-0 lg:border-r border-white/5"
			>
				<div class="flex items-center gap-6">
					<div
						class="w-14 h-14 bg-[#1d4c74] flex items-center justify-center text-3xl"
					>
						<HiArrowDownOnSquareStack />
					</div>
					<h3
						class="text-3xl md:text-4xl font-display font-extrabold uppercase tracking-tighter"
					>
						Nuestra Misión
					</h3>
				</div>
				<p
					class="font-body text-gray-400 text-lg leading-relaxed max-w-xl"
				>
					Elevar los estándares de la industria a través de procesos
					productivos innovadores y sostenibles, garantizando la
					excelencia en cada grano de café, cada pieza de madera y
					cada experiencia de hospitalidad que entregamos al mundo.
				</p>
			</div>
			<!-- Vision -->
			<div
				class="w-full lg:w-1/2 bg-[#1d4c74] text-white p-12 md:p-20 flex flex-col justify-center gap-8"
			>
				<div class="flex items-center gap-6">
					<div
						class="w-14 h-14 bg-[#2a3035] flex items-center justify-center text-3xl"
					>
						<HiArrowUpOnSquareStack />
					</div>
					<h3
						class="text-3xl md:text-4xl font-display font-extrabold uppercase tracking-tighter"
					>
						Nuestra Visión
					</h3>
				</div>
				<p
					class="font-body text-gray-100 text-lg leading-relaxed max-w-xl opacity-90"
				>
					Ser el grupo corporativo referente en la región por nuestra
					capacidad de diversificación inteligente, liderando el
					mercado con integridad y transformando los recursos
					naturales en valor excepcional para nuestros socios y
					comunidades.
				</p>
			</div>
		</section>

		<!-- Divisions Cards (Responsive Grid) -->
		<section class="py-16 md:py-24 px-6 md:px-8 bg-gray-50 reveal-item">
			<div
				class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8 md:gap-0 md:border border-gray-200"
			>
				<!-- Madera -->
				<div
					class="bg-[#2a3035] flex flex-col group border md:border-none border-gray-200 shadow-none"
				>
					<div class="h-64 overflow-hidden relative">
						<img
							src="https://images.unsplash.com/photo-1644358686685-4ed525a59663?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
							alt="Madera"
							class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000 font-display"
						/>
					</div>
					<div class="p-8 md:p-10 flex flex-col flex-grow text-white">
						<h3
							class="text-xl md:text-2xl font-extrabold font-display mb-4 tracking-widest uppercase"
						>
							MADERA
						</h3>
						<p
							class="font-body leading-relaxed mb-8 flex-grow text-gray-300 text-sm md:text-base"
						>
							Producimos madera de alta calidad con estándares
							sostenibles para la industria de la construcción y
							diseño.
						</p>
						<a
							href="/madera"
							class="bg-[#1d4c74] text-white font-ui font-bold uppercase py-3 px-6 self-start hover:bg-white hover:text-[#1d4c74] transition-colors text-xs tracking-wider cursor-pointer inline-block"
						>
							Ver División
						</a>
					</div>
				</div>

				<!-- Hospitalidad -->
				<div
					class="bg-[#1d4c74] flex flex-col group border md:border-none border-gray-200 shadow-none"
				>
					<div class="h-64 overflow-hidden relative">
						<img
							src="https://images.unsplash.com/photo-1551632436-cbf8dd35adfa?q=80&w=1171&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
							alt="Hospitalidad"
							class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000 font-display"
						/>
					</div>
					<div
						class="p-8 md:p-10 flex flex-col flex-grow text-white border-y border-white/10 md:border-y-0 md:border-x shadow-none"
					>
						<h3
							class="text-xl md:text-2xl font-extrabold font-display mb-4 tracking-widest uppercase"
						>
							HOSPITALIDAD
						</h3>
						<p
							class="font-body leading-relaxed mb-8 flex-grow text-gray-200 text-sm md:text-base"
						>
							Gestión hotelera de lujo con un enfoque en la
							experiencia personalizada y el confort superior.
						</p>
						<a
							href="/hospitalidad"
							class="bg-[#2a3035] text-white font-ui font-bold uppercase py-3 px-6 self-start hover:bg-white hover:text-[#2a3035] transition-colors text-xs tracking-wider cursor-pointer inline-block"
						>
							Ver División
						</a>
					</div>
				</div>

				<!-- Café -->
				<div
					class="bg-[#2a3035] flex flex-col group border md:border-none border-gray-200 shadow-none"
				>
