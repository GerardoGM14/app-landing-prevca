---
/**
 * Checkout multistep para pedidos con pago real.
 *
 * Pasos:
 *   1. Datos del cliente (nombre, email, telefono, empresa opcional)
 *   2. Direccion de envio (departamento → provincia → distrito + direccion)
 *   3. Facturacion (boleta/factura + DNI/RUC)
 *   4. Metodo de pago (selector: Yape, Transferencia, PayPal, Culqi)
 *   5. Pantalla de pago segun metodo (QR Yape + uploader, etc.)
 *
 * El backend recalcula precios y envio en servidor (nunca confia en el cliente).
 */
import "../styles/global.css";
import {
	FaBars,
	FaTimes,
	FaChevronDown,
	FaShoppingCart,
	FaCheck,
	FaArrowLeft,
	FaUpload,
} from "react-icons/fa";
import libroImg from "../assets/libro-reclamaciones.png";
import logoPrevca from "../assets/logo-prevca.png";
import logoProinnovate from "../assets/logo-proinnovate.png";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Checkout | Grupo Prevca</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Outfit:wght@400;600;700&family=Inter:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-gray-50 text-gray-800 font-body selection:bg-[#1d4c74] selection:text-white overflow-x-hidden min-h-screen flex flex-col">
		<!-- Navbar -->
		<nav class="bg-[#2a3035] text-white py-4 px-6 md:px-8 flex justify-between items-center font-ui sticky top-0 z-50">
			<a href="/" class="flex items-center gap-3 hover:opacity-90 transition-opacity">
				<img src={logoPrevca.src} alt="Grupo Prevca" class="h-10 md:h-14 w-auto object-contain brightness-0 invert" />
			</a>
			<div class="hidden lg:flex gap-8 text-sm font-semibold tracking-wide uppercase items-center">
				<a href="/" class="hover:text-gray-300 transition-colors">Inicio</a>
				<div class="relative group">
					<a href="/madera" class="hover:text-gray-300 transition-colors flex items-center gap-1.5">
						Madera <FaChevronDown className="text-[10px]" />
					</a>
					<div class="absolute left-0 top-full pt-3 hidden group-hover:block z-50 min-w-[280px]">
						<div class="bg-[#2a3035] border border-white/10 shadow-2xl">
							<a href="/madera" class="block px-5 py-3 text-xs uppercase tracking-widest font-semibold hover:bg-white/10 transition-colors border-b border-white/5">Ver división</a>
							<a href="/madera/aserradero-prevca" class="block px-5 py-3 text-xs uppercase tracking-widest font-semibold hover:bg-white/10 transition-colors">Aserradero PREVCA</a>
							<a href="/madera/corporacion-maderera-copesa" class="block px-5 py-3 text-xs uppercase tracking-widest font-semibold hover:bg-white/10 transition-colors border-t border-white/5">Maderera COPESA</a>
						</div>
					</div>
				</div>
				<a href="/alojamiento" class="hover:text-gray-300 transition-colors">Alojamiento</a>
				<a href="/cafe" class="hover:text-gray-300 transition-colors">Café</a>
				<a href="/transporte" class="hover:text-gray-300 transition-colors">Transporte</a>
				<a href="/ecommerce" class="relative cursor-pointer hover:text-gray-300 transition-colors ml-2 flex items-center">
					<div class="text-xl"><FaShoppingCart /></div>
				</a>
			</div>
			<button id="menu-toggle" class="lg:hidden text-2xl text-white cursor-pointer">
				<div id="icon-bars"><FaBars /></div>
				<div id="icon-times" class="hidden"><FaTimes /></div>
			</button>
		</nav>

		<div id="mobile-menu" class="fixed inset-0 bg-[#2a3035] z-40 transform translate-x-full transition-transform duration-300 lg:hidden pt-24 px-8 overflow-y-auto">
			<div class="flex flex-col gap-6 text-xl text-white font-ui uppercase font-bold tracking-widest">
				<a href="/" class="border-b border-white/10 pb-4">Inicio</a>
				<a href="/madera" class="border-b border-white/10 pb-4">Madera</a>
				<a href="/alojamiento" class="border-b border-white/10 pb-4">Alojamiento</a>
				<a href="/cafe" class="border-b border-white/10 pb-4">Café</a>
				<a href="/transporte" class="border-b border-white/10 pb-4">Transporte</a>
				<a href="/ecommerce" class="bg-[#1d4c74] text-center py-4 mt-2 text-sm">Mi Carrito</a>
			</div>
		</div>

		<main class="flex-grow py-10 px-6 md:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="flex items-center justify-between mb-8">
					<div>
						<p class="text-xs font-ui uppercase tracking-widest text-[#1d4c74] mb-2">Checkout</p>
						<h1 class="text-3xl md:text-4xl font-extrabold font-display text-[#2a3035] uppercase tracking-tight">Completar pedido</h1>
					</div>
					<a href="/ecommerce" class="hidden md:flex items-center gap-2 text-[#1d4c74] font-bold font-ui uppercase text-sm hover:text-[#153a5b]">
						<FaArrowLeft /> Volver al carrito
					</a>
				</div>

				<!-- Stepper visual -->
				<div class="bg-white border border-gray-200 mb-8 overflow-hidden">
					<div class="grid grid-cols-4 divide-x divide-gray-200">
						{["Cliente", "Envío", "Facturación", "Pago"].map((label, idx) => (
							<div data-step-indicator={idx + 1} class="step-indicator p-4 text-center transition-colors">
								<div class="step-num w-8 h-8 mx-auto rounded-full flex items-center justify-center font-ui font-extrabold text-sm mb-2 transition-colors">
									{idx + 1}
								</div>
								<p class="text-[10px] md:text-xs font-ui font-bold uppercase tracking-widest text-gray-500">{label}</p>
							</div>
						))}
					</div>
				</div>

				<div id="checkout-error" class="hidden bg-red-50 border-l-4 border-red-500 text-red-700 text-sm font-body p-4 mb-6"></div>

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
					<!-- Formularios (2/3) -->
					<div class="lg:col-span-2">

						<!-- PASO 1: CLIENTE -->
						<section data-step="1" class="step bg-white border border-gray-200 p-6 md:p-8 mb-6">
							<h2 class="text-lg font-display font-extrabold uppercase tracking-widest text-[#2a3035] mb-6 pb-3 border-b border-gray-100">1. Datos del cliente</h2>
							<form id="form-cliente" class="space-y-4">
								<div>
									<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Nombre completo *</label>
									<input type="text" name="name" required class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body" />
								</div>
								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									<div>
										<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Correo electrónico *</label>
										<input type="email" name="email" required class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body" />
									</div>
									<div>
										<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Teléfono *</label>
										<input type="tel" name="phone" required placeholder="+51 987 654 321" class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body" />
									</div>
								</div>
								<div>
									<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Empresa (opcional)</label>
									<input type="text" name="company" class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body" />
								</div>
								<div class="flex justify-end pt-2">
									<button type="submit" class="bg-[#1d4c74] text-white font-bold px-8 py-3 uppercase font-ui tracking-widest hover:bg-[#153a5b] transition-colors border border-[#1d4c74] cursor-pointer text-sm">
										Continuar →
									</button>
								</div>
							</form>
						</section>

						<!-- PASO 2: ENVÍO -->
						<section data-step="2" class="step bg-white border border-gray-200 p-6 md:p-8 mb-6 hidden">
							<h2 class="text-lg font-display font-extrabold uppercase tracking-widest text-[#2a3035] mb-6 pb-3 border-b border-gray-100">2. Dirección de envío</h2>
							<form id="form-envio" class="space-y-4">
								<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
									<div>
										<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Departamento *</label>
										<select id="select-dept" name="department" required class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body cursor-pointer">
											<option value="">Seleccione...</option>
										</select>
									</div>
									<div>
										<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Provincia *</label>
										<select id="select-prov" name="province" required disabled class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body cursor-pointer disabled:opacity-50">
											<option value="">Seleccione departamento primero</option>
										</select>
									</div>
									<div>
										<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Distrito *</label>
										<select id="select-dist" name="district" required disabled class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body cursor-pointer disabled:opacity-50">
											<option value="">Seleccione provincia primero</option>
										</select>
									</div>
								</div>
								<div>
									<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Dirección *</label>
									<input type="text" name="address" required placeholder="Av. Ejemplo 123, Dpto 4B" class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body" />
								</div>
								<div>
									<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Referencia (opcional)</label>
									<input type="text" name="reference" placeholder="Frente al parque, edificio azul" class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body" />
								</div>

								<div id="envio-cost-preview" class="hidden bg-[#1d4c74]/5 border-l-4 border-[#1d4c74] p-4">
									<p class="text-xs uppercase tracking-widest font-bold text-[#1d4c74] mb-1">Costo de envío</p>
									<p class="text-2xl font-extrabold font-display text-[#1d4c74]" id="envio-cost-value">S/ 0.00</p>
								</div>

								<div class="flex justify-between pt-2">
									<button type="button" data-go-step="1" class="bg-white text-[#1d4c74] font-bold px-6 py-3 uppercase font-ui tracking-widest hover:bg-gray-50 transition-colors border-2 border-[#1d4c74] cursor-pointer text-sm">
										← Atrás
									</button>
									<button type="submit" class="bg-[#1d4c74] text-white font-bold px-8 py-3 uppercase font-ui tracking-widest hover:bg-[#153a5b] transition-colors border border-[#1d4c74] cursor-pointer text-sm">
										Continuar →
									</button>
								</div>
							</form>
						</section>

						<!-- PASO 3: FACTURACIÓN -->
						<section data-step="3" class="step bg-white border border-gray-200 p-6 md:p-8 mb-6 hidden">
							<h2 class="text-lg font-display font-extrabold uppercase tracking-widest text-[#2a3035] mb-6 pb-3 border-b border-gray-100">3. Facturación</h2>
							<form id="form-factura" class="space-y-4">
								<div>
									<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-2">Comprobante *</label>
									<div class="grid grid-cols-2 gap-3">
										<label class="border border-gray-300 p-4 cursor-pointer hover:border-[#1d4c74] transition-colors flex items-center gap-3 has-[:checked]:bg-[#1d4c74]/5 has-[:checked]:border-[#1d4c74]">
											<input type="radio" name="receiptType" value="BOLETA" checked class="accent-[#1d4c74]" />
											<div>
												<p class="font-bold text-[#2a3035]">Boleta</p>
												<p class="text-xs text-gray-500">Para persona natural</p>
											</div>
										</label>
										<label class="border border-gray-300 p-4 cursor-pointer hover:border-[#1d4c74] transition-colors flex items-center gap-3 has-[:checked]:bg-[#1d4c74]/5 has-[:checked]:border-[#1d4c74]">
											<input type="radio" name="receiptType" value="FACTURA" class="accent-[#1d4c74]" />
											<div>
												<p class="font-bold text-[#2a3035]">Factura</p>
												<p class="text-xs text-gray-500">Para empresa con RUC</p>
											</div>
										</label>
									</div>
								</div>
								<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
									<div>
										<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Tipo doc. *</label>
										<select id="select-docType" name="documentType" required class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body cursor-pointer">
											<option value="DNI">DNI</option>
											<option value="RUC">RUC</option>
											<option value="CE">Carné Extranjería</option>
											<option value="PASAPORTE">Pasaporte</option>
										</select>
									</div>
									<div class="md:col-span-2">
										<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Número *</label>
										<input type="text" name="documentNumber" required class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body" />
									</div>
								</div>
								<div id="business-name-wrap" class="hidden">
									<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Razón social *</label>
									<input type="text" name="businessName" placeholder="Nombre legal de la empresa" class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors font-body" />
								</div>
								<div class="flex justify-between pt-2">
									<button type="button" data-go-step="2" class="bg-white text-[#1d4c74] font-bold px-6 py-3 uppercase font-ui tracking-widest hover:bg-gray-50 transition-colors border-2 border-[#1d4c74] cursor-pointer text-sm">
										← Atrás
									</button>
									<button type="submit" class="bg-[#1d4c74] text-white font-bold px-8 py-3 uppercase font-ui tracking-widest hover:bg-[#153a5b] transition-colors border border-[#1d4c74] cursor-pointer text-sm">
										Continuar →
									</button>
								</div>
							</form>
						</section>

						<!-- PASO 4: MÉTODO DE PAGO -->
						<section data-step="4" class="step bg-white border border-gray-200 p-6 md:p-8 mb-6 hidden">
							<h2 class="text-lg font-display font-extrabold uppercase tracking-widest text-[#2a3035] mb-6 pb-3 border-b border-gray-100">4. Método de pago</h2>

							<div id="payment-methods-loader" class="text-center py-10 text-gray-500 font-body">
								<div class="inline-block w-8 h-8 border-3 border-[#1d4c74] border-r-transparent rounded-full animate-spin mb-4"></div>
								<p>Cargando métodos de pago...</p>
							</div>

							<div id="payment-methods-list" class="hidden space-y-3"></div>

							<div id="payment-methods-empty" class="hidden bg-yellow-50 border-l-4 border-yellow-500 p-4 text-sm font-body text-yellow-800">
								No hay métodos de pago habilitados en este momento. Por favor contáctenos para coordinar.
							</div>

							<div class="flex justify-between pt-6 mt-6 border-t border-gray-100">
								<button type="button" data-go-step="3" class="bg-white text-[#1d4c74] font-bold px-6 py-3 uppercase font-ui tracking-widest hover:bg-gray-50 transition-colors border-2 border-[#1d4c74] cursor-pointer text-sm">
									← Atrás
								</button>
								<button id="btn-place-order" type="button" disabled class="bg-[#1d4c74] text-white font-bold px-8 py-3 uppercase font-ui tracking-widest hover:bg-[#153a5b] transition-colors border border-[#1d4c74] cursor-pointer text-sm disabled:opacity-50 disabled:cursor-not-allowed">
									Confirmar pedido
								</button>
							</div>
						</section>

						<!-- PASO 5: PAGAR -->
						<section data-step="5" class="step bg-white border border-gray-200 p-6 md:p-8 mb-6 hidden">
							<h2 class="text-lg font-display font-extrabold uppercase tracking-widest text-[#2a3035] mb-6 pb-3 border-b border-gray-100">5. Completar pago</h2>
							<div id="payment-result" class="space-y-4"></div>
						</section>
					</div>

					<!-- Resumen lateral (1/3) -->
					<aside class="bg-white border border-[#1d4c74] p-6 sticky top-24 shadow-xl">
						<h3 class="text-base font-extrabold font-display text-[#2a3035] uppercase tracking-widest mb-4 pb-3 border-b border-gray-100">Resumen</h3>
						<ul id="summary-items" class="space-y-3 mb-4 text-sm font-body"></ul>
						<div class="border-t border-gray-100 pt-4 space-y-2 text-sm">
							<div class="flex justify-between text-gray-600">
								<span>Subtotal</span>
								<span id="summary-subtotal" class="font-bold text-[#2a3035]">S/ 0.00</span>
							</div>
							<div class="flex justify-between text-gray-600">
								<span>Envío</span>
								<span id="summary-shipping" class="font-bold text-[#2a3035]">—</span>
							</div>
							<div class="flex justify-between pt-3 border-t border-gray-100">
								<span class="font-ui font-bold uppercase tracking-widest text-[#2a3035]">Total</span>
								<span id="summary-total" class="font-display font-extrabold text-xl text-[#1d4c74]">S/ 0.00</span>
							</div>
						</div>
					</aside>
				</div>
			</div>
		</main>

		<footer class="bg-[#2a3035] text-white pt-12 pb-6 px-6 md:px-8 mt-auto">
			<div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
				<p class="text-xs font-ui tracking-[0.2em] text-gray-400 uppercase font-bold">© 2026 Grupo Prevca</p>
				<div class="flex items-center gap-3">
					<a href="#" class="bg-white p-1 max-w-[100px] block">
						<img src={libroImg.src} alt="Libro de Reclamaciones" class="w-full h-auto max-h-14 object-contain" />
					</a>
					<div class="bg-white p-1 max-w-[100px]">
						<img src={logoProinnovate.src} alt="Proinnovate" class="w-full h-auto max-h-14 object-contain" />
					</div>
				</div>
			</div>
		</footer>

		<script>
			import { fetchProducts, fetchShippingRates, fetchPaymentMethods, submitCheckout } from "../lib/api.js";
			import { UBIGEO_PERU, DEPARTMENT_LABELS, getProvinces, getDistricts } from "../data/ubigeo-peru.js";

			type CartItem = { id: string; quantity: number };
			type EnabledMethod = { key: 'YAPE' | 'TRANSFERENCIA' | 'PAYPAL' | 'CULQI'; label: string; description: string; available: boolean };

			const $ = <T extends HTMLElement = HTMLElement>(sel: string): T => document.querySelector(sel) as T;
			const $$ = <T extends HTMLElement = HTMLElement>(sel: string): NodeListOf<T> => document.querySelectorAll(sel) as NodeListOf<T>;

			let currentStep = 1;
			let products: any[] = [];
			let cart: CartItem[] = [];
			let shippingRates: Record<string, number> = {};
			let selectedMethod: EnabledMethod['key'] | null = null;
			let paymentConfig: any = null;
			const formData: any = {
				customer: {},
				shipping: {},
				billing: { receiptType: 'BOLETA', documentType: 'DNI' },
			};

			const formatMoney = (n: number) => `S/ ${n.toFixed(2)}`;

			const showError = (msg: string | null) => {
				const el = $("#checkout-error");
				if (!msg) {
					el.classList.add("hidden");
					return;
				}
				el.textContent = msg;
				el.classList.remove("hidden");
				el.scrollIntoView({ behavior: "smooth", block: "start" });
			};

			const goToStep = (step: number) => {
				currentStep = step;
				showError(null);
				$$<HTMLElement>(".step").forEach((s) => {
					const n = Number(s.dataset.step);
					s.classList.toggle("hidden", n !== step);
				});
				$$<HTMLElement>(".step-indicator").forEach((ind) => {
					const n = Number(ind.dataset.stepIndicator);
					const num = ind.querySelector(".step-num");
					if (!num) return;
					if (n < step) {
						num.classList.add("bg-[#1d4c74]", "text-white");
						num.classList.remove("bg-gray-200", "text-gray-500");
						num.innerHTML = '<svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>';
					} else if (n === step) {
						num.classList.add("bg-[#1d4c74]", "text-white");
						num.classList.remove("bg-gray-200", "text-gray-500");
						num.textContent = String(n);
					} else {
						num.classList.add("bg-gray-200", "text-gray-500");
						num.classList.remove("bg-[#1d4c74]", "text-white");
						num.textContent = String(n);
					}
				});
				window.scrollTo({ top: 0, behavior: "smooth" });
			};

			/* === RESUMEN DEL CARRITO === */
			const renderSummary = () => {
				const catalog: Record<string, any> = Object.fromEntries(products.map((p) => [p.slug, p]));
				const validCart = cart.filter((c) => catalog[c.id]);

				const itemsEl = $("#summary-items");
				itemsEl.innerHTML = validCart
					.map((c) => {
						const p = catalog[c.id];
						const lineTotal = (p.price ?? 0) * c.quantity;
						return `
							<li class="flex justify-between gap-2">
								<div class="flex-1">
									<p class="font-bold text-[#2a3035]">${p.title}</p>
									<p class="text-xs text-gray-500">x ${c.quantity}</p>
								</div>
								<span class="font-bold text-[#2a3035] whitespace-nowrap">${formatMoney(lineTotal)}</span>
							</li>
						`;
					})
					.join("");

				const subtotal = validCart.reduce((sum, c) => sum + (catalog[c.id].price ?? 0) * c.quantity, 0);
				const shippingDept = formData.shipping.department;
				const shipping = shippingDept ? shippingRates[shippingDept] ?? 0 : null;
				const total = subtotal + (shipping ?? 0);

				$("#summary-subtotal").textContent = formatMoney(subtotal);
				$("#summary-shipping").textContent = shipping !== null ? formatMoney(shipping) : "—";
				$("#summary-total").textContent = formatMoney(total);

				if (shipping !== null) {
					$("#envio-cost-value").textContent = formatMoney(shipping);
					$("#envio-cost-preview").classList.remove("hidden");
				}
			};

			/* === DEPARTAMENTOS → PROVINCIAS → DISTRITOS === */
			const fillSelect = (selectEl: HTMLSelectElement, options: string[], placeholder: string) => {
				selectEl.innerHTML = `<option value="">${placeholder}</option>` +
					options.map((o) => `<option value="${o}">${o}</option>`).join("");
				selectEl.disabled = options.length === 0;
			};

			const setupUbigeo = () => {
				const deptSelect = $<HTMLSelectElement>("#select-dept");
				const provSelect = $<HTMLSelectElement>("#select-prov");
				const distSelect = $<HTMLSelectElement>("#select-dist");

				// Cargar departamentos
				const deptOpts = Object.entries(DEPARTMENT_LABELS).map(([code, label]) => ({ code, label }));
				deptSelect.innerHTML = '<option value="">Seleccione...</option>' +
					deptOpts.map((d) => `<option value="${d.code}">${d.label}</option>`).join("");

				deptSelect.addEventListener("change", () => {
					const dept = deptSelect.value;
					formData.shipping.department = dept;
					formData.shipping.province = "";
					formData.shipping.district = "";
					if (dept) {
						const provs = getProvinces(dept);
						fillSelect(provSelect, provs, "Seleccione provincia");
					} else {
						fillSelect(provSelect, [], "Seleccione departamento primero");
					}
					fillSelect(distSelect, [], "Seleccione provincia primero");
					renderSummary();
				});

				provSelect.addEventListener("change", () => {
					const dept = deptSelect.value;
					const prov = provSelect.value;
					formData.shipping.province = prov;
					formData.shipping.district = "";
					if (dept && prov) {
						const dists = getDistricts(dept, prov);
						fillSelect(distSelect, dists, "Seleccione distrito");
					} else {
						fillSelect(distSelect, [], "Seleccione provincia primero");
					}
				});

				distSelect.addEventListener("change", () => {
					formData.shipping.district = distSelect.value;
				});
			};

			/* === FORMS POR PASO === */
			const setupForms = () => {
				// Paso 1
				$<HTMLFormElement>("#form-cliente").addEventListener("submit", (e) => {
					e.preventDefault();
					const fd = new FormData(e.target as HTMLFormElement);
					formData.customer = {
						name: String(fd.get("name") ?? "").trim(),
						email: String(fd.get("email") ?? "").trim(),
						phone: String(fd.get("phone") ?? "").trim() || undefined,
						company: String(fd.get("company") ?? "").trim() || undefined,
					};
					goToStep(2);
				});

				// Paso 2
				$<HTMLFormElement>("#form-envio").addEventListener("submit", (e) => {
					e.preventDefault();
					const fd = new FormData(e.target as HTMLFormElement);
					formData.shipping = {
						department: String(fd.get("department")),
						province: String(fd.get("province")),
						district: String(fd.get("district")),
						address: String(fd.get("address") ?? "").trim(),
						reference: String(fd.get("reference") ?? "").trim() || undefined,
					};
					if (!formData.shipping.department || !formData.shipping.province || !formData.shipping.district) {
						showError("Seleccione departamento, provincia y distrito.");
						return;
					}
					renderSummary();
					goToStep(3);
				});

				// Paso 3 — tipo de comprobante cambia visibilidad de razón social
				const receiptRadios = $$<HTMLInputElement>('input[name="receiptType"]');
				const docTypeSelect = $<HTMLSelectElement>("#select-docType");
				const businessWrap = $("#business-name-wrap");
				const updateBillingUI = () => {
					const isFactura = (document.querySelector('input[name="receiptType"]:checked') as HTMLInputElement)?.value === "FACTURA";
					businessWrap.classList.toggle("hidden", !isFactura);
					if (isFactura) {
						docTypeSelect.value = "RUC";
					}
				};
				receiptRadios.forEach((r) => r.addEventListener("change", updateBillingUI));

				$<HTMLFormElement>("#form-factura").addEventListener("submit", (e) => {
					e.preventDefault();
					const fd = new FormData(e.target as HTMLFormElement);
					formData.billing = {
						receiptType: String(fd.get("receiptType")),
						documentType: String(fd.get("documentType")),
						documentNumber: String(fd.get("documentNumber") ?? "").trim(),
						businessName: String(fd.get("businessName") ?? "").trim() || undefined,
					};
					if (formData.billing.receiptType === "FACTURA" && !formData.billing.businessName) {
						showError("La razón social es obligatoria para factura.");
						return;
					}
					goToStep(4);
					loadPaymentMethods();
				});

				// Botones "atrás"
				$$<HTMLButtonElement>("[data-go-step]").forEach((btn) => {
					btn.addEventListener("click", () => goToStep(Number(btn.dataset.goStep)));
				});

				// Confirmar pedido
				$<HTMLButtonElement>("#btn-place-order").addEventListener("click", placeOrder);
			};

			/* === MÉTODOS DE PAGO (paso 4) === */
			const loadPaymentMethods = async () => {
				const loader = $("#payment-methods-loader");
				const list = $("#payment-methods-list");
				const empty = $("#payment-methods-empty");
				loader.classList.remove("hidden");
				list.classList.add("hidden");
				empty.classList.add("hidden");

				try {
					paymentConfig = await fetchPaymentMethods();
					const methods: EnabledMethod[] = [
						{ key: 'YAPE', label: 'Yape', description: 'Paga con QR y sube tu captura', available: !!paymentConfig.yape },
						{ key: 'TRANSFERENCIA', label: 'Transferencia bancaria', description: 'BCP / Interbank / BBVA', available: !!paymentConfig.transfer },
						{ key: 'PAYPAL', label: 'PayPal', description: 'Tarjeta o cuenta PayPal', available: !!paymentConfig.paypal },
						{ key: 'CULQI', label: 'Culqi (tarjetas)', description: 'Visa, Mastercard, Yape vía Culqi', available: !!paymentConfig.culqi },
					].filter((m) => m.available);

					loader.classList.add("hidden");

					if (methods.length === 0) {
						empty.classList.remove("hidden");
						return;
					}

					list.classList.remove("hidden");
					list.innerHTML = methods.map((m) => `
						<label class="border border-gray-300 p-4 cursor-pointer hover:border-[#1d4c74] transition-colors flex items-start gap-3 has-[:checked]:bg-[#1d4c74]/5 has-[:checked]:border-[#1d4c74] block">
							<input type="radio" name="paymentMethod" value="${m.key}" class="accent-[#1d4c74] mt-1" />
							<div>
								<p class="font-bold text-[#2a3035]">${m.label}</p>
								<p class="text-xs text-gray-500 mt-1">${m.description}</p>
							</div>
						</label>
					`).join("");

					list.querySelectorAll<HTMLInputElement>('input[name="paymentMethod"]').forEach((r) => {
						r.addEventListener("change", () => {
							selectedMethod = r.value as EnabledMethod['key'];
							$<HTMLButtonElement>("#btn-place-order").disabled = false;
						});
					});
				} catch (err) {
					loader.classList.add("hidden");
					showError((err as Error).message);
				}
			};

			/* === CONFIRMAR ORDEN === */
			const placeOrder = async () => {
				if (!selectedMethod) return;
				const btn = $<HTMLButtonElement>("#btn-place-order");
				btn.disabled = true;
				btn.textContent = "Procesando...";
				showError(null);

				const catalog: Record<string, any> = Object.fromEntries(products.map((p) => [p.slug, p]));
				const items = cart
					.filter((c) => catalog[c.id])
					.map((c) => ({ productId: catalog[c.id].id, quantity: c.quantity }));

				if (items.length === 0) {
					showError("Tu carrito está vacío.");
					btn.disabled = false;
					btn.textContent = "Confirmar pedido";
					return;
				}

				try {
					const response = await submitCheckout({
						customer: formData.customer,
						shipping: formData.shipping,
						billing: formData.billing,
						items,
						paymentMethod: selectedMethod,
					});
					localStorage.removeItem("prevca_cart");
					localStorage.setItem("prevca_last_order", JSON.stringify({
						code: response.code,
						total: response.total,
						paymentMethod: response.paymentMethod,
						paymentInfo: response.paymentInfo,
					}));
					goToStep(5);
					renderPaymentResult(response);
				} catch (err) {
					showError((err as Error).message);
					btn.disabled = false;
					btn.textContent = "Confirmar pedido";
				}
			};

			/* === PASO 5: RENDER POST-PAGO === */
			const renderPaymentResult = (response: any) => {
				const el = $("#payment-result");
				const code = response.code;
				const total = formatMoney(response.total);
				const method = response.paymentMethod;
				const info = response.paymentInfo;

				let html = `
					<div class="bg-green-50 border-l-4 border-green-500 p-4 mb-4">
						<p class="font-bold text-green-700 mb-1">✓ Pedido registrado</p>
						<p class="text-sm text-green-700">Código: <span class="font-mono font-bold">${code}</span></p>
						<p class="text-sm text-green-700">Total: <span class="font-bold">${total}</span></p>
					</div>
				`;

				if (method === 'YAPE' && info.yape) {
					html += `
						<div class="bg-white border border-gray-200 p-6">
							<h3 class="font-display font-extrabold text-[#2a3035] uppercase tracking-widest text-sm mb-4">Pago con Yape</h3>
							${info.yape.qrUrl ? `<img src="${info.yape.qrUrl}" alt="QR Yape" class="max-w-xs mx-auto mb-4 border border-gray-200" />` : '<p class="text-yellow-700 bg-yellow-50 p-3 mb-4">QR no configurado todavía. Contáctenos.</p>'}
							${info.yape.number ? `<p class="text-center text-sm font-body mb-2">📱 Número: <span class="font-bold">${info.yape.number}</span></p>` : ''}
							${info.yape.ownerName ? `<p class="text-center text-sm font-body mb-4">Titular: ${info.yape.ownerName}</p>` : ''}
							<p class="text-center text-lg font-bold text-[#1d4c74] mb-6">Monto: ${total}</p>
							<div class="border-t border-gray-100 pt-4">
								<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-2">Sube tu captura del Yape *</label>
								<input id="proof-file" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" class="w-full border border-gray-300 bg-gray-50 p-3 outline-none font-body" />
								<button id="btn-upload-proof" type="button" class="w-full mt-3 bg-[#1d4c74] text-white font-bold px-8 py-3 uppercase font-ui tracking-widest hover:bg-[#153a5b] transition-colors cursor-pointer text-sm disabled:opacity-50">
									Enviar captura
								</button>
								<div id="proof-result" class="hidden mt-4 p-3 text-sm font-body"></div>
							</div>
						</div>
					`;
				} else if (method === 'TRANSFERENCIA' && info.transfer) {
					html += `
						<div class="bg-white border border-gray-200 p-6">
							<h3 class="font-display font-extrabold text-[#2a3035] uppercase tracking-widest text-sm mb-4">Datos para transferencia</h3>
							<ul class="space-y-2 text-sm font-body mb-6">
								${info.transfer.bankName ? `<li><strong>Banco:</strong> ${info.transfer.bankName}</li>` : ''}
								${info.transfer.accountHolder ? `<li><strong>Titular:</strong> ${info.transfer.accountHolder}</li>` : ''}
								${info.transfer.accountNumber ? `<li><strong>Cuenta:</strong> ${info.transfer.accountNumber}</li>` : ''}
								${info.transfer.cci ? `<li><strong>CCI:</strong> ${info.transfer.cci}</li>` : ''}
							</ul>
							<p class="text-lg font-bold text-[#1d4c74] mb-6">Monto a transferir: ${total}</p>
							<div class="border-t border-gray-100 pt-4">
								<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-2">Sube el voucher de transferencia *</label>
								<input id="proof-file" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" class="w-full border border-gray-300 bg-gray-50 p-3 outline-none font-body" />
								<button id="btn-upload-proof" type="button" class="w-full mt-3 bg-[#1d4c74] text-white font-bold px-8 py-3 uppercase font-ui tracking-widest hover:bg-[#153a5b] transition-colors cursor-pointer text-sm disabled:opacity-50">
									Enviar voucher
								</button>
								<div id="proof-result" class="hidden mt-4 p-3 text-sm font-body"></div>
							</div>
						</div>
					`;
				} else if (method === 'PAYPAL' || method === 'CULQI') {
					html += `
						<div class="bg-yellow-50 border-l-4 border-yellow-500 p-6">
							<h3 class="font-bold text-yellow-800 mb-2">${method === 'PAYPAL' ? 'PayPal' : 'Culqi'} en preparación</h3>
							<p class="text-sm text-yellow-700 mb-3">
								Su pedido fue registrado correctamente. La integración con esta pasarela se activará en breve.
								Mientras tanto, un asesor lo contactará para coordinar el pago.
							</p>
						</div>
					`;
				}

				html += `<p class="text-center text-sm text-gray-500 mt-6">Guarda tu código <strong>${code}</strong> para futuras consultas.</p>`;
				el.innerHTML = html;

				// Wire upload de captura
				const proofBtn = document.getElementById("btn-upload-proof") as HTMLButtonElement | null;
				const proofInput = document.getElementById("proof-file") as HTMLInputElement | null;
				const proofResult = document.getElementById("proof-result");
				if (proofBtn && proofInput && proofResult) {
					proofBtn.addEventListener("click", async () => {
						const file = proofInput.files?.[0];
						if (!file) {
							proofResult.className = "mt-4 p-3 text-sm font-body bg-red-50 border-l-4 border-red-500 text-red-700";
							proofResult.classList.remove("hidden");
							proofResult.textContent = "Seleccione un archivo primero.";
							return;
						}
						proofBtn.disabled = true;
						proofBtn.textContent = "Subiendo...";
						try {
							const { uploadPaymentProof } = await import("../lib/api.js");
							const result = await uploadPaymentProof(code, file);
							proofResult.className = "mt-4 p-3 text-sm font-body bg-green-50 border-l-4 border-green-500 text-green-700";
							proofResult.classList.remove("hidden");
							proofResult.innerHTML = `<strong>✓ Captura recibida</strong><br>${result.message}`;
							proofBtn.textContent = "Captura enviada";
						} catch (err) {
							proofResult.className = "mt-4 p-3 text-sm font-body bg-red-50 border-l-4 border-red-500 text-red-700";
							proofResult.classList.remove("hidden");
							proofResult.textContent = (err as Error).message;
							proofBtn.disabled = false;
							proofBtn.textContent = "Reintentar";
						}
					});
				}
			};

			/* === MOBILE MENU === */
			const setupMobileMenu = () => {
				const toggle = document.getElementById("menu-toggle");
				const menu = document.getElementById("mobile-menu");
				const bars = document.getElementById("icon-bars");
				const times = document.getElementById("icon-times");
				toggle?.addEventListener("click", () => {
					if (!menu || !bars || !times) return;
					const isOpen = menu.classList.contains("translate-x-0");
					if (isOpen) {
						menu.classList.replace("translate-x-0", "translate-x-full");
						bars.classList.remove("hidden");
						times.classList.add("hidden");
					} else {
						menu.classList.replace("translate-x-full", "translate-x-0");
						bars.classList.add("hidden");
						times.classList.remove("hidden");
					}
				});
			};

			/* === BOOT === */
			(async () => {
				setupMobileMenu();

				cart = JSON.parse(localStorage.getItem("prevca_cart") ?? "[]");
				if (cart.length === 0) {
					showError("Tu carrito está vacío. Agrega productos antes de hacer checkout.");
					return;
				}

				try {
					const [allProducts, ratesData] = await Promise.all([
						fetchProducts({ pageSize: 100 }),
						fetchShippingRates(),
					]);
					products = allProducts;
					shippingRates = ratesData.rates ?? {};

					// Validar que TODOS los items del carrito permitan pago directo
					const catalog: Record<string, any> = Object.fromEntries(products.map((p) => [p.slug, p]));
					const blocked = cart.filter((c) => {
						const p = catalog[c.id];
						return !p || !p.allowsDirectPurchase || p.price == null;
					});
					if (blocked.length > 0) {
						showError("Algunos productos del carrito no aceptan pago directo. Vuelve al carrito y elimínalos o solicita cotización.");
						return;
					}

					renderSummary();
					setupUbigeo();
					setupForms();
					goToStep(1);
				} catch (err) {
					showError((err as Error).message);
				}
			})();
		</script>
	</body>
</html>
