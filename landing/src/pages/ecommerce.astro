---
import "../styles/global.css";
import {
	FaBars,
	FaTimes,
	FaLinkedinIn,
	FaInstagram,
	FaTwitter,
	FaShoppingCart,
	FaChevronDown,
	FaChevronUp,
	FaTrash,
	FaArrowLeft
} from "react-icons/fa";
import { MdMarkEmailRead } from "react-icons/md";
import { FaPhoneSquareAlt } from "react-icons/fa";
import libroImg from "../assets/libro-reclamaciones.png";

const catalog = {
    // Madera
    "pino-radiata": { title: "Madera Aserrada Pino Radiata", div: "Madera", ref: "RP-01", desc: "Madera de excelente trabajabilidad y resistencia, secada al horno y proveniente de bosques certificados." },
    "eucalipto-globulus": { title: "Tablas de Eucalipto Globulus", div: "Madera", ref: "EG-04", desc: "Tablas de extrema dureza y durabilidad natural, secadas bajo estricto control, ideales para pisos y revestimientos." },
    "vigas-pino": { title: "Vigas Estructurales Pino", div: "Madera", ref: "RP-ST", desc: "Vigas diseñadas para soportar cargas pesadas en longitudes de hasta 6m continuos sin uniones." },
    "eucalipto-mueble": { title: "Eucalipto Grado Mueble", div: "Madera", ref: "EG-FG", desc: "Línea premium seca al 10-12% de humedad, ideal para ebanistería fina y acabados de lujo." },
    
    // Hospitalidad
    "deluxe-king": { title: "Habitación Deluxe King", div: "Hospitalidad", ref: "DLX-01", desc: "Santuario de tranquilidad con cama King size, sábanas de algodón egipcio y baño de mármol con ducha de lluvia." },
    "suite-presidencial": { title: "Suite Presidencial Panorama", div: "Hospitalidad", ref: "SUI-PR", desc: "El pináculo del lujo con vistas de 180 grados, comedor privado, sala de estar y servicio de mayordomo personal dedicado." },
    "restaurante-azul": { title: 'Restaurante Signature "Azul"', div: "Hospitalidad", ref: "RST-01", desc: "Experiencia gastronómica galardonada con menús de degustación estacionales que fusionan sabores locales y técnicas internacionales." },
    "spa-wellness": { title: "Spa & Wellness Center", div: "Hospitalidad", ref: "SPA-01", desc: "Santuario holístico con circuito de hidroterapia completo y tratamientos exclusivos para una relajación profunda y duradera." },
    
    // Café
    "especialidad-origen": { title: "Café de Especialidad Origen", div: "Café", ref: "ESP-01", desc: "Perfil de taza complejo con notas a frutas de hueso y caramelo. Tostado artesanal en pequeños lotes para máxima frescura." },
    "verde-exportacion": { title: "Café Verde Grado Exportación", div: "Café", ref: "GRN-EX", desc: "Grano verde meticulosamente procesado y seleccionado (Preparación Europea) para asegurar lotes consistentes de exportación." },
    "capsulas-premium": { title: "Cápsulas Premium Espresso", div: "Café", ref: "CAP-PR", desc: "Cápsulas compatibles que sellan herméticamente café recién molido, preservando aromas para un espresso intenso con crema espesa." },
    "equipamiento-barista": { title: "Equipamiento Barista Profesional", div: "Café", ref: "EQP-BR", desc: "Máquinas de espresso de múltiples grupos y molinos comerciales de las mejores marcas para garantizar una extracción perfecta." }
};
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Cotización | Grupo Prevca</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Outfit:wght@400;600&family=Inter:wght@300;400&display=swap"
			rel="stylesheet"
		/>
		<style>
			.nav-link {
				position: relative;
			}
			.nav-link::after {
				content: "";
				position: absolute;
				bottom: -2px;
				left: 0;
				width: 0;
				height: 2px;
				background-color: white;
				transition: width 0.3s ease;
			}
			.nav-link:hover::after {
				width: 100%;
			}
			/* Acordeón Animations */
			.chevron-icon {
				transition: transform 0.3s ease;
			}
			.chevron-icon.open {
				transform: rotate(180deg);
			}
			.accordion-content {
				display: grid;
				grid-template-rows: 0fr;
				transition: grid-template-rows 0.3s ease;
			}
			.accordion-content.open {
				grid-template-rows: 1fr;
			}
			.accordion-inner {
				overflow: hidden;
			}
		</style>
	</head>
	<body
		class="bg-gray-50 text-gray-800 font-body selection:bg-[#1d4c74] selection:text-white overflow-x-hidden min-h-screen flex flex-col"
	>
		<!-- Main Navbar -->
		<nav
			class="bg-[#2a3035] text-white py-4 px-6 md:px-8 flex justify-between items-center font-ui sticky top-0 z-50 transition-all duration-300"
		>
			<div class="flex items-center gap-3">
				<a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
					<div
						class="w-7 h-7 md:w-8 md:h-8 bg-white text-[#2a3035] font-extrabold flex items-center justify-center font-display text-base md:text-lg shadow-none rounded-none"
					>
						P
					</div>
					<span
						class="text-xl md:text-2xl font-extrabold tracking-widest font-display uppercase"
						>GRUPO PREVCA</span
					>
				</a>
			</div>

			<!-- Desktop Menu -->
			<div
				class="hidden lg:flex gap-8 text-sm font-semibold tracking-wide uppercase items-center"
			>
				<a
					href="/"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Inicio</a
				>
				<a
					href="/madera"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Madera</a
				>
				<a
					href="/hospitalidad"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Hospitalidad</a
				>
				<a
					href="/cafe"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Café</a
				>

				<!-- Cart Icon -->
				<div
					class="relative cursor-pointer text-[#1d4c74] bg-white px-3 py-1 ml-2 flex items-center gap-2 rounded-none"
				>
					<div class="text-xl"><FaShoppingCart /></div>
					<span class="font-bold text-xs tracking-wider">COTIZACIÓN</span>
					<span
						id="cart-count-desktop"
						class="absolute top-[-8px] right-[-12px] w-5 h-5 flex items-center justify-center bg-[#1d4c74] text-white text-[10px] font-extrabold rounded-full shadow-md leading-none pt-[1px]"
						>0</span
					>
				</div>
			</div>

			<!-- Mobile Menu Toggle -->
			<button
				id="menu-toggle"
				class="lg:hidden text-2xl text-white cursor-pointer"
			>
				<div id="icon-bars"><FaBars /></div>
				<div id="icon-times" class="hidden"><FaTimes /></div>
			</button>
		</nav>

		<!-- Mobile Menu Drawer -->
		<div
			id="mobile-menu"
			class="fixed inset-0 bg-[#2a3035] z-40 transform translate-x-full transition-transform duration-300 lg:hidden pt-24 px-8 overflow-y-auto"
		>
			<div
				class="flex flex-col gap-6 text-xl text-white font-ui uppercase font-bold tracking-widest"
			>
				<a href="/" class="border-b border-white/10 pb-4 cursor-pointer">Inicio</a>
				<a href="/madera" class="border-b border-white/10 pb-4 cursor-pointer">Madera</a>
				<a href="/hospitalidad" class="border-b border-white/10 pb-4 cursor-pointer">Hospitalidad</a>
				<a href="/cafe" class="border-b border-white/10 pb-4 cursor-pointer">Café</a>
				<div
					class="border-b border-white/10 pb-4 cursor-pointer flex justify-between items-center text-[#1d4c74] bg-white px-4 rounded-none shadow-sm"
				>
					<span class="flex items-center gap-3"><FaShoppingCart /> Cotización</span>
					<span id="cart-count-mobile" class="bg-[#2a3035] text-white text-xs font-bold w-6 h-6 flex items-center justify-center rounded-full">0</span>
				</div>
			</div>
		</div>

		<!-- Main Content -->
		<main class="flex-grow py-12 px-6 md:px-8">
			<div class="max-w-7xl mx-auto">
				<div class="mb-8 flex items-center justify-between">
					<div>
						<h1 class="text-3xl md:text-4xl font-extrabold font-display text-[#2a3035] uppercase tracking-tight">Su Lista de Cotización</h1>
						<p class="text-gray-500 font-body mt-2">Revise los productos seleccionados y ajuste las cantidades.</p>
					</div>
					<a href="/" class="hidden md:flex items-center gap-2 text-[#1d4c74] font-bold font-ui uppercase text-sm hover:text-[#153a5b] transition-colors">
						<FaArrowLeft /> Seguir Explorando
					</a>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
					<!-- Cart Items List -->
					<div class="lg:col-span-2 space-y-4" id="cart-items-container">
						<!-- Items will be injected here via JS -->
						<div class="text-center py-16 bg-white border border-gray-200">
							<div class="text-gray-300 text-6xl mb-4 flex justify-center"><FaShoppingCart /></div>
							<p class="text-gray-500 font-body font-semibold">Cargando su cotización...</p>
						</div>
					</div>

					<!-- Summary Sidebar -->
					<div class="bg-white border border-[#1d4c74] p-8 sticky top-24 rounded-none shadow-xl">
						<h3 class="text-xl font-extrabold font-display text-[#2a3035] uppercase tracking-wider mb-6 border-b border-gray-100 pb-4">Resumen</h3>
						
						<div class="flex justify-between items-center text-gray-600 font-body mb-8">
							<span>Total de Ítems:</span>
							<span id="summary-total-items" class="font-bold text-[#2a3035] text-xl">0</span>
						</div>

						<form class="space-y-4" onsubmit="event.preventDefault(); alert('Solicitud enviada correctamente. Un asesor se comunicará pronto.');">
							<div>
								<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Nombre Completo</label>
								<input type="text" required class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors rounded-none font-body" />
							</div>
							<div>
								<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Empresa</label>
								<input type="text" class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors rounded-none font-body" />
							</div>
							<div>
								<label class="block text-xs font-bold font-ui text-gray-500 uppercase tracking-widest mb-1">Correo Electrónico</label>
								<input type="email" required class="w-full border border-gray-300 bg-gray-50 p-3 outline-none focus:border-[#1d4c74] transition-colors rounded-none font-body" />
							</div>
							
							<button type="submit" class="w-full bg-[#1d4c74] text-white font-bold px-4 py-4 uppercase font-ui tracking-widest hover:bg-[#2a3035] transition-colors border border-[#1d4c74] flex items-center justify-center gap-3 cursor-pointer shadow-md mt-6 rounded-none">
								Solicitar Cotización
							</button>
						</form>
					</div>
				</div>
			</div>
		</main>

		<!-- Footer -->
		<footer class="bg-[#2a3035] text-white pt-16 pb-8 px-6 md:px-8 mt-auto">
			<div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6 text-xs font-ui tracking-[0.2em] text-gray-500 uppercase font-bold">
				<div class="flex items-center gap-3">
					<div class="w-6 h-6 bg-white text-[#2a3035] flex items-center justify-center font-display text-sm rounded-none">P</div>
					<span>PREVCA</span>
				</div>
				<p>© 2024 GRUPO PREVCA. TODOS LOS DERECHOS RESERVADOS.</p>
			</div>
		</footer>

		<script is:inline define:vars={{ catalog }}>
			document.addEventListener("DOMContentLoaded", () => {
				// Mobile Menu
				const menuToggle = document.getElementById("menu-toggle");
				const mobileMenu = document.getElementById("mobile-menu");
				const iconBars = document.getElementById("icon-bars");
				const iconTimes = document.getElementById("icon-times");

				menuToggle?.addEventListener("click", () => {
					const isOpen = mobileMenu.classList.contains("translate-x-0");
					if (isOpen) {
						mobileMenu.classList.replace("translate-x-0", "translate-x-full");
						iconBars.classList.remove("hidden");
						iconTimes.classList.add("hidden");
						document.body.style.overflow = "auto";
					} else {
						mobileMenu.classList.replace("translate-x-full", "translate-x-0");
						iconBars.classList.add("hidden");
						iconTimes.classList.remove("hidden");
						document.body.style.overflow = "hidden";
					}
				});

				// Cart Render Logic
				const container = document.getElementById('cart-items-container');
				const desktopBadge = document.getElementById('cart-count-desktop');
				const mobileBadge = document.getElementById('cart-count-mobile');
				const summaryTotal = document.getElementById('summary-total-items');

				const renderCart = () => {
					let cart = JSON.parse(localStorage.getItem('prevca_cart')) || [];
					
					// Filter out valid items (in case of old data)
					cart = cart.filter(item => catalog[item.id]);

					const totalItems = cart.reduce((acc, item) => acc + item.quantity, 0);
					if (desktopBadge) desktopBadge.textContent = totalItems;
					if (mobileBadge) mobileBadge.textContent = totalItems;
					if (summaryTotal) summaryTotal.textContent = totalItems;

					if (cart.length === 0) {
						container.innerHTML = `
							<div class="text-center py-16 bg-white border border-gray-200 rounded-none shadow-sm">
								<div class="text-gray-300 text-6xl mb-6 flex justify-center">
									<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 576 512" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M528.12 301.319l47.273-208C578.806 78.301 567.391 64 551.99 64H159.208l-9.166-44.81C147.758 8.021 137.93 0 126.529 0H24C10.745 0 0 10.745 0 24v16c0 13.255 10.745 24 24 24h69.883l70.248 343.435C147.325 417.1 136 435.222 136 456c0 30.928 25.072 56 56 56s56-25.072 56-56c0-15.674-6.447-29.835-16.824-40h209.647C430.447 426.165 424 440.326 424 456c0 30.928 25.072 56 56 56s56-25.072 56-56c0-22.172-12.888-41.332-31.579-50.405l5.517-24.276c3.413-15.018-8.002-29.319-23.403-29.319H218.117l-6.545-32h293.145c11.206 0 20.92-7.754 23.403-18.681z"></path></svg>
								</div>
								<h2 class="text-2xl font-extrabold font-display text-[#2a3035] mb-2">Su cotización está vacía</h2>
								<p class="text-gray-500 font-body mb-6">Explore nuestras divisiones para agregar productos a su lista.</p>
								<div class="flex justify-center gap-4 flex-wrap">
									<a href="/madera" class="text-sm border border-[#1d4c74] text-[#1d4c74] px-4 py-2 uppercase font-bold tracking-wider hover:bg-[#1d4c74] hover:text-white transition-colors">Madera</a>
									<a href="/hospitalidad" class="text-sm border border-[#1d4c74] text-[#1d4c74] px-4 py-2 uppercase font-bold tracking-wider hover:bg-[#1d4c74] hover:text-white transition-colors">Hospitalidad</a>
									<a href="/cafe" class="text-sm border border-[#1d4c74] text-[#1d4c74] px-4 py-2 uppercase font-bold tracking-wider hover:bg-[#1d4c74] hover:text-white transition-colors">Café</a>
								</div>
							</div>
						`;
						return;
					}

					container.innerHTML = cart.map((item, index) => {
						const details = catalog[item.id];
						return `
							<div class="bg-white border border-gray-200 rounded-none shadow-sm transition-colors hover:border-[#1d4c74]/50">
								<div class="p-4 md:p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
									
									<div class="flex-grow">
										<div class="flex items-center gap-3 mb-1">
											<span class="bg-gray-100 text-gray-600 text-[10px] font-bold px-2 py-1 uppercase tracking-wider">${details.div}</span>
											<span class="text-xs font-bold text-gray-400">Ref: ${details.ref}</span>
										</div>
										<h3 class="text-xl font-bold font-display text-[#2a3035]">${details.title}</h3>
									</div>

									<div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-end">
										<!-- Quantity Control -->
										<div class="flex items-stretch border border-gray-300 bg-white text-[#2a3035] font-ui font-bold h-[40px] rounded-none">
											<button onclick="updateQty('${item.id}', -1)" class="w-10 hover:bg-gray-100 transition-colors border-r border-gray-300 cursor-pointer text-lg flex items-center justify-center">-</button>
											<input type="number" readonly value="${item.quantity}" class="w-12 text-center m-0 p-0 outline-none bg-transparent text-sm [appearance:textfield]" />
											<button onclick="updateQty('${item.id}', 1)" class="w-10 hover:bg-gray-100 transition-colors border-l border-gray-300 cursor-pointer text-lg flex items-center justify-center">+</button>
										</div>

										<div class="flex items-center gap-2">
											<button onclick="removeItem('${item.id}')" title="Eliminar" class="w-10 h-10 flex items-center justify-center text-red-500 hover:bg-red-50 transition-colors border border-transparent hover:border-red-100 rounded-none cursor-pointer">
												<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M432 32H312l-9.4-18.7A24 24 0 0 0 281.1 0H166.8a23.72 23.72 0 0 0-21.4 13.3L136 32H16A16 16 0 0 0 0 48v32a16 16 0 0 0 16 16h416a16 16 0 0 0 16-16V48a16 16 0 0 0-16-16zM53.2 467a48 48 0 0 0 47.9 45h245.8a48 48 0 0 0 47.9-45L416 128H32z"></path></svg>
											</button>
											<button onclick="toggleAccordion(${index})" class="w-10 h-10 flex items-center justify-center text-[#1d4c74] hover:bg-gray-50 transition-colors border border-gray-200 cursor-pointer rounded-none">
												<svg id="chevron-${index}" class="chevron-icon" stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"></path></svg>
											</button>
										</div>
									</div>
								</div>
								
								<!-- Accordion Content -->
								<div id="accordion-${index}" class="accordion-content bg-gray-50 border-t border-gray-100">
									<div class="accordion-inner">
										<div class="p-6">
											<h4 class="text-[#1d4c74] font-bold font-display text-sm mb-2 uppercase tracking-widest">Descripción</h4>
											<p class="text-gray-600 font-body text-sm leading-relaxed">${details.desc}</p>
										</div>
									</div>
								</div>
							</div>
						`;
					}).join('');
				};

				// Global Functions for inline handlers
				window.updateQty = (id, change) => {
					let cart = JSON.parse(localStorage.getItem('prevca_cart')) || [];
					const itemIndex = cart.findIndex(item => item.id === id);
					if (itemIndex > -1) {
						cart[itemIndex].quantity += change;
						if (cart[itemIndex].quantity < 1) cart[itemIndex].quantity = 1;
						localStorage.setItem('prevca_cart', JSON.stringify(cart));
						renderCart();
					}
				};

				window.removeItem = (id) => {
					let cart = JSON.parse(localStorage.getItem('prevca_cart')) || [];
					cart = cart.filter(item => item.id !== id);
					localStorage.setItem('prevca_cart', JSON.stringify(cart));
					renderCart();
				};

				window.toggleAccordion = (index) => {
					const content = document.getElementById(`accordion-${index}`);
					const chevron = document.getElementById(`chevron-${index}`);
					if (content && chevron) {
						content.classList.toggle('open');
						chevron.classList.toggle('open');
					}
				};

				// Initial Render
				renderCart();
			});
		</script>
	</body>
</html>
