		<script is:inline>
			(function () {
				const btnPrivacy = document.getElementById("btn-privacy");
				const btnTerms = document.getElementById("btn-terms");
				const modalPrivacy = document.getElementById("modal-privacy");
				const modalTerms = document.getElementById("modal-terms");
				const btnDevoluciones = document.getElementById("btn-devoluciones");
				const modalDevoluciones = document.getElementById("modal-devoluciones");
				const closeBtns = document.querySelectorAll(".modal-close");
				const toggle = (modal, show) => {
					if (!modal) return;
					modal.classList.toggle("active", show);
					document.body.style.overflow = show ? "hidden" : "auto";
				};
				btnPrivacy && btnPrivacy.addEventListener("click", () => toggle(modalPrivacy, true));
				btnTerms && btnTerms.addEventListener("click", () => toggle(modalTerms, true));
				if (btnDevoluciones) btnDevoluciones.addEventListener("click", () => (typeof toggleModal === "function" ? toggleModal : toggle)(modalDevoluciones, true));
				closeBtns.forEach((b) => b.addEventListener("click", () => { toggle(modalPrivacy, false); toggle(modalTerms, false); toggle(modalDevoluciones, false); }));
				[modalPrivacy, modalTerms].forEach((m) => {
					m && m.addEventListener("click", (e) => { if (e.target === m) toggle(m, false); });
				});
			})();
		</script>

