---
import "../styles/global.css";
import {
	FaSearch,
	FaBars,
	FaTimes,
	FaChevronDown,
	FaArrowRight,
	FaLinkedinIn,
	FaInstagram,
	FaTwitter,
	FaTruck,
	FaShip,
	FaRoute,
	FaShoppingCart,
} from "react-icons/fa";
import { MdMarkEmailRead } from "react-icons/md";
import { FaPhoneSquareAlt } from "react-icons/fa";
import libroImg from "../assets/libro-reclamaciones.png";
import logoProinnovate from "../assets/logo-proinnovate.png";
import logoTransporte from "../assets/logo-transporte.png";

// Imágenes decorativas de la división (hero y banners — los productos se cargan dinámicamente desde la API)
import transporteImg01 from "../assets/transporte/transporte-image-01.png";
import transporteImg02 from "../assets/transporte/transporte-image-02.png";
import transporteHero from "../assets/transporte/transporte-hero.jpg";
import transportePrecision from "../assets/transporte/transporte-precision.jpg";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import BankBanner from "../components/BankBanner.astro";
import LibroReclamaciones from "../components/LibroReclamaciones.astro";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Transporte | Grupo Prevca</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Outfit:wght@400;600&family=Inter:wght@300;400&display=swap"
			rel="stylesheet"
		/>
		<style>
			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}
			.loader-spinner {
				border: 3px solid rgba(255, 255, 255, 0.1);
				border-left-color: #1d4c74;
				border-radius: 50%;
				width: 50px;
				height: 50px;
				animation: spin 0.8s linear infinite;
			}
			.reveal-item {
				opacity: 0;
				transform: translateY(30px);
				transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.reveal-item.active {
				opacity: 1;
				transform: translateY(0);
			}
			.nav-link {
				position: relative;
			}
			.nav-link::after {
				content: "";
				position: absolute;
				bottom: -2px;
				left: 0;
				width: 0;
				height: 2px;
				background-color: white;
				transition: width 0.3s ease;
			}
			.nav-link:hover::after {
				width: 100%;
			}
		
			/* Legal Modals Styles */
			.modal-overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.5);
				backdrop-filter: blur(4px);
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 20px;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.3s ease;
			}
			.modal-overlay.active {
				opacity: 1;
				pointer-events: auto;
			}
			.modal-content {
				background: white;
				width: 100%;
				max-width: 800px;
				max-height: 80vh;
				overflow-y: auto;
				padding: 40px;
				border-radius: 2px;
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
				position: relative;
				border-top: 6px solid #1d4c74;
			}
			.modal-close {
				position: absolute;
				top: 20px;
				right: 20px;
				font-size: 24px;
				cursor: pointer;
				color: #2a3035;
				opacity: 0.5;
				transition: opacity 0.2s;
			}
			.modal-close:hover {
				opacity: 1;
			}
			.modal-body h3 {
				color: #1d4c74;
				font-weight: 700;
				font-family: "Outfit Variable", sans-serif;
				margin-bottom: 20px;
				letter-spacing: -0.01em;
			}
			.modal-body section {
				margin-bottom: 24px;
			}
			.modal-body h4 {
				font-weight: 700;
				margin-bottom: 8px;
				color: #2a3035;
			}
			.modal-body p {
				color: #4b5563;
				line-height: 1.6;
				margin-bottom: 12px;
			}
		</style>
	</head>
	<body
		class="bg-gray-50 text-gray-800 font-body selection:bg-[#1d4c74] selection:text-white overflow-x-hidden"
	>
		<!-- CORPORATE LOADER -->
		<div
			id="loader-overlay"
			class="fixed inset-0 z-[100] flex flex-col items-center justify-center transition-opacity duration-700"
		>
			<div class="absolute inset-0 bg-black/30 backdrop-blur-md"></div>
			<div class="relative z-10">
				<div class="loader-spinner"></div>
			</div>
		</div>

		<!-- Main Navbar -->
		<nav
			class="bg-[#2a3035] text-white py-4 px-6 md:px-8 flex justify-between items-center font-ui sticky top-0 z-50 transition-all duration-300"
		>
			<a
				href="/"
				class="flex items-center gap-3 hover:opacity-90 transition-opacity"
			>
				<img
					src={logoTransporte.src}
					alt="Transporte Prevca"
					class="h-10 md:h-14 w-auto object-contain brightness-0 invert"
				/>
			</a>

			<!-- Desktop Menu -->
			<div
				class="hidden lg:flex gap-8 text-sm font-semibold tracking-wide uppercase items-center"
			>
				<a
					href="/"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Inicio</a
				>
				<a
					href="/nosotros"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Sobre Nosotros</a
				>
				<!-- Dropdown Madera -->
				<div class="relative group">
					<a
						href="/madera"
						class="nav-link hover:text-gray-300 transition-colors cursor-pointer flex items-center gap-1.5"
						>Madera <FaChevronDown className="text-[10px]" /></a
					>
					<div class="absolute left-0 top-full pt-3 hidden group-hover:block z-50 min-w-[300px]">
						<div class="bg-[#2a3035] border border-white/10 shadow-2xl">
							<a href="/madera" class="block px-5 py-3 text-xs uppercase tracking-widest font-semibold hover:bg-white/10 transition-colors border-b border-white/5">
								Ver división completa
							</a>
							<a href="/madera/aserradero-prevca" class="block px-5 py-3 hover:bg-white/10 transition-colors">
								<span class="block text-xs uppercase tracking-widest font-semibold">Aserradero PREVCA</span>
								<span class="block text-[10px] opacity-60 mt-1 normal-case font-normal">Producción y subproductos</span>
							</a>
							<a href="/madera/corporacion-maderera-copesa" class="block px-5 py-3 hover:bg-white/10 transition-colors border-t border-white/5">
								<span class="block text-xs uppercase tracking-widest font-semibold">Maderera COPESA</span>
								<span class="block text-[10px] opacity-60 mt-1 normal-case font-normal">Catálogo de especies</span>
							</a>
						</div>
					</div>
				</div>
				<a
					href="/alojamiento"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Alojamiento</a
				>
				<a
					href="/cafe"
					class="hidden nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Café</a
				>
				<a
					href="/transporte"
					class="nav-link text-white border-b-2 border-white cursor-pointer"
					>Transporte</a
				>
				<a
					href="/#contact-section"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Contacto</a
				>

				<!-- Cart Icon -->
				<a
					href="/ecommerce"
					class="relative cursor-pointer hover:text-gray-300 transition-colors ml-2 mr-4 flex items-center"
				>
					<div class="text-xl"><FaShoppingCart /></div>
					<span
						id="cart-count-desktop"
						class="absolute top-[-6px] right-[-14px] w-4 h-4 flex items-center justify-center bg-white text-[#2a3035] text-[10px] font-extrabold rounded-full shadow-md leading-none pt-[1px]"
						>0</span
					>
				</a>
			</div>

			<!-- Mobile Menu Toggle -->
			<button
				id="menu-toggle"
				class="lg:hidden text-2xl text-white cursor-pointer"
			>
				<div id="icon-bars"><FaBars /></div>
				<div id="icon-times" class="hidden"><FaTimes /></div>
			</button>
		</nav>

		<!-- Mobile Menu Drawer -->
		<div
			id="mobile-menu"
			class="fixed inset-0 bg-[#2a3035] z-40 transform translate-x-full transition-transform duration-300 lg:hidden pt-24 px-8 overflow-y-auto"
		>
			<div
				class="flex flex-col gap-6 text-xl text-white font-ui uppercase font-bold tracking-widest"
			>
				<a href="/" class="border-b border-white/10 pb-4 cursor-pointer"
					>Inicio</a
				>
				<a
					href="/nosotros"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Sobre Nosotros</a
				>
				<details class="border-b border-white/10 pb-4">
					<summary class="cursor-pointer flex items-center justify-between">
						<span>Madera</span>
						<FaChevronDown className="accordion-icon text-base" />
					</summary>
					<div class="pl-4 mt-4 flex flex-col gap-3 text-base normal-case tracking-normal">
						<a href="/madera" class="opacity-80 hover:opacity-100">Ver división completa</a>
						<a href="/madera/aserradero-prevca" class="opacity-80 hover:opacity-100">Aserradero PREVCA</a>
						<a href="/madera/corporacion-maderera-copesa" class="opacity-80 hover:opacity-100">Maderera COPESA</a>
					</div>
				</details>
				<a
					href="/alojamiento"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Alojamiento</a
				>
				<a
					href="/cafe"
					class="hidden border-b border-white/10 pb-4 cursor-pointer">Café</a
				>
				<a
					href="/transporte"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Transporte</a
				>
				<a
					href="/#contact-section"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Contacto</a
				>
				<div
					class="border-b border-white/10 pb-4 cursor-pointer flex justify-between items-center text-[#1d4c74] bg-white px-4 rounded-none shadow-sm"
				>
					<span class="flex items-center gap-3"
						><FaShoppingCart /> Mi Carrito</span
					>
					<span
						id="cart-count-mobile"
						class="bg-[#2a3035] text-white text-xs font-bold w-6 h-6 flex items-center justify-center rounded-full"
						>0</span
					>
				</div>
				<a
					href="/ecommerce"
					class="bg-[#1d4c74] text-center py-4 mt-2 cursor-pointer text-sm"
					>Tienda Virtual</a
				>
			</div>
		</div>

		<!-- Hero Section -->
		<header
			class="relative h-[60vh] md:h-[70vh] flex items-center justify-center overflow-hidden"
		>
			<div class="absolute inset-0 bg-black/60 z-10"></div>
			<img
				src={transporteHero.src}
				alt="División Transporte"
				class="absolute inset-0 w-full h-full object-cover"
			/>
			<div
				class="relative z-20 text-center text-white px-6 max-w-4xl mx-auto reveal-item"
			>
				<span
					class="font-ui tracking-[0.3em] text-sm md:text-base font-bold uppercase mb-4 block opacity-80"
					>División Transporte</span
				>
				<h1
					class="text-4xl md:text-6xl font-extrabold font-display leading-tight mb-6"
				>
					Soluciones Logísticas, <br /><span
						class="text-[#1d4c74] bg-white px-4 inline-block mt-2"
						>Sin Fronteras</span
					>
				</h1>
				<div class="w-24 h-1 bg-white mx-auto mt-8 opacity-50"></div>
			</div>
		</header>

		<!-- Info Section -->
		<section class="py-24 px-6 md:px-8 bg-white overflow-hidden">
			<div
				class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
			>
				<div class="reveal-item">
					<h4
						class="text-[#1d4c74] font-ui font-bold uppercase tracking-widest text-sm mb-4"
					>
						Nuestra Diferencia
					</h4>
					<h2
						class="text-3xl md:text-4xl font-extrabold font-display text-[#2a3035] leading-tight mb-6"
					>
						Precisión en Cada Entrega
					</h2>
					<p
						class="text-gray-600 font-body mb-6 text-lg leading-relaxed"
					>
						En Grupo Prevca, brindamos soluciones integrales de
						transporte terrestre y logística a nivel nacional,
						garantizando que su carga llegue de manera segura,
						oportuna y eficiente a cualquier destino del país.
					</p>
					<p
						class="text-gray-600 font-body mb-8 text-lg leading-relaxed"
					>
						Contamos con una flota moderna, personal especializado y
						una amplia cobertura operativa, lo que nos permite
						ofrecer servicios de distribución confiables desde los
						principales centros logísticos hasta la última milla.
						Nos adaptamos a las necesidades de cada cliente para
						optimizar su cadena de suministro y asegurar la
						continuidad de sus operaciones en todo el territorio
						peruano.
					</p>
				</div>

				<div
					class="relative reveal-item"
					style="transition-delay: 200ms"
				>
					<div class="absolute -inset-4 bg-[#1d4c74]/5 rounded-none">
					</div>
					<img
						src={transportePrecision.src}
						alt="Proceso Logístico"
						class="relative z-10 w-full h-auto rounded-none"
					/>
				</div>
			</div>
		</section>

		<!-- Core Capabilities Section -->
		<section class="py-24 px-6 md:px-8 bg-gray-50">
			<div class="max-w-7xl mx-auto">
				<div
					class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8 reveal-item"
				>
					<div>
						<h4
							class="text-[#1d4c74] font-ui font-bold uppercase tracking-widest text-sm mb-4"
						>
							Proceso Logístico
						</h4>
						<h2
							class="text-3xl md:text-5xl font-extrabold font-display text-[#2a3035] leading-tight max-w-2xl"
						>
							Nuestros Pilares de Transporte
						</h2>
					</div>
					<p class="text-gray-600 font-body max-w-md text-lg">
						Comprometidos con la excelencia operativa en cada
						kilómetro recorrido.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<!-- Card 1 -->
					<div
						class="bg-[#1d4c74] p-10 transition-all duration-300 reveal-item group border border-[#1d4c74] hover:bg-[#153a5b]"
					>
						<div
							class="w-14 h-14 bg-white/10 flex items-center justify-center text-white text-2xl mb-8 rounded-none"
						>
							<FaTruck />
						</div>
						<h3
							class="text-xl font-bold font-display text-white mb-4"
						>
							Flota Moderna
						</h3>
						<p
							class="text-white/80 font-body text-sm leading-relaxed"
						>
							Unidades de transporte de última generación,
							equipadas con tecnología de rastreo satelital para
							monitoreo 24/7.
						</p>
					</div>

					<!-- Card 2 -->
					<div
						class="bg-[#1d4c74] p-10 transition-all duration-300 reveal-item group border border-[#1d4c74] hover:bg-[#153a5b]"
						style="transition-delay: 100ms;"
					>
						<div
							class="w-14 h-14 bg-white/10 flex items-center justify-center text-white text-2xl mb-8 rounded-none"
						>
							<FaShip />
						</div>
						<h3
							class="text-xl font-bold font-display text-white mb-4"
						>
							Transporte Nacional
						</h3>
						<p
							class="text-white/80 font-body text-sm leading-relaxed"
						>
							Cobertura logística a nivel nacional mediante
							soluciones de transporte de carga eficientes,
							seguras y adaptadas a las necesidades de cada
							cliente.
						</p>
					</div>

					<!-- Card 3 -->
					<div
						class="bg-[#1d4c74] p-10 transition-all duration-300 reveal-item group border border-[#1d4c74] hover:bg-[#153a5b]"
						style="transition-delay: 200ms;"
					>
						<div
							class="w-14 h-14 bg-white/10 flex items-center justify-center text-white text-2xl mb-8 rounded-none"
						>
							<FaRoute />
						</div>
						<h3
							class="text-xl font-bold font-display text-white mb-4"
						>
							Rutas Optimizadas
						</h3>
						<p
							class="text-white/80 font-body text-sm leading-relaxed"
						>
							Planificación inteligente de rutas y logística de
							última milla para garantizar entregas puntuales y
							seguras.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Catalog Section -->
		<section class="py-24 px-6 md:px-8 bg-white">
			<div class="max-w-7xl mx-auto">
				<!-- Banner Header -->
				<div
					class="relative rounded-none overflow-hidden mb-16 h-64 reveal-item flex items-center p-10"
				>
					<div class="absolute inset-0 bg-[#2a3035]/80 z-10"></div>
					<img
						src={transporteImg01.src}
						alt="Nuestros Servicios"
						class="absolute inset-0 w-full h-full object-cover z-0"
					/>
					<div class="relative z-20">
						<h2
							class="text-3xl md:text-5xl font-extrabold font-display text-white mb-4"
						>
							Nuestros Servicios
						</h2>
						<p class="text-white/80 font-body text-lg max-w-xl">
							Descubra nuestras soluciones integrales diseñadas
							para cada necesidad logística.
						</p>
					</div>
				</div>

				<!-- Filter placeholder -->
				<div
					class="flex flex-wrap gap-4 items-center mb-12 font-ui text-sm reveal-item"
				>
					<span
						class="font-bold text-gray-500 tracking-widest uppercase mr-4 hidden md:block"
						>Categorías:</span
					>
					<button
						class="bg-[#1d4c74] text-white px-6 py-2 font-bold cursor-pointer border border-[#1d4c74] rounded-none"
						>Todas</button
					>
					<button
						class="bg-transparent text-gray-600 hover:bg-[#1d4c74] hover:text-white border border-gray-200 hover:border-[#1d4c74] px-6 py-2 font-semibold transition-colors cursor-pointer rounded-none"
						>Nacional</button
					>
					<button
						class="bg-transparent text-gray-600 hover:bg-[#1d4c74] hover:text-white border border-gray-200 hover:border-[#1d4c74] px-6 py-2 font-semibold transition-colors cursor-pointer rounded-none"
						>Internacional</button
					>
					<button
						class="bg-transparent text-gray-600 hover:bg-[#1d4c74] hover:text-white border border-gray-200 hover:border-[#1d4c74] px-6 py-2 font-semibold transition-colors cursor-pointer rounded-none"
						>Especializado</button
					>
				</div>

				<!-- Grid of Products (dinámico: se carga desde la API pública) -->
				<div
					id="transporte-products-grid"
					class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 reveal-item min-h-[400px]"
				>
					<!-- Los productos se hidratan aquí desde Firestore via /public/products?division=TRANSPORTE -->
				</div>

				<!-- CTA Banner -->
				<div
					class="mt-16 bg-[#f4f7fa] rounded-none p-8 md:p-12 flex flex-col md:flex-row justify-between items-center gap-8 border border-[#1d4c74]/10 reveal-item"
				>
					<div class="text-center md:text-left">
						<h3
							class="text-2xl md:text-3xl font-extrabold font-display text-[#2a3035] mb-2"
						>
							¿Requiere soluciones a medida?
						</h3>
						<p class="text-gray-600 font-body max-w-xl">
							Ofrecemos asesoría logística, evaluación de rutas y
							presupuestos corporativos personalizados.
						</p>
					</div>
					<a
						href="/ecommerce"
						class="bg-[#1d4c74] text-white font-bold px-8 py-4 rounded-none font-ui tracking-wider hover:bg-[#2a3035] transition-colors whitespace-nowrap"
					>
						Cotizar Servicio
					</a>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="bg-[#2a3035] text-white pt-24 pb-12 px-6 md:px-8">
			<!-- ... Footer Content ... -->
			<div
				class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-12 lg:gap-16 mb-24"
			>
				<div class="space-y-8">
					<div class="flex items-center gap-3">
						<div
							class="w-8 h-8 bg-white text-[#2a3035] font-extrabold flex items-center justify-center font-display text-lg rounded-none"
						>
							P
						</div>
						<span
							class="text-2xl font-extrabold tracking-widest font-display uppercase"
							>PREVCA</span
						>
					</div>
					<p
						class="text-gray-400 text-sm font-body leading-relaxed max-w-xs"
					>
						Elevando estándares corporativos a través de la
						excelencia operativa y la diversificación estratégica.
					</p>
					<div class="flex gap-4">
						<a
							href="#"
							class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all rounded-none"
							><FaLinkedinIn /></a
						>
						<a
							href="#"
							class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all rounded-none"
							><FaInstagram /></a
						>
						<a
							href="#"
