---
import "../styles/global.css";
import {
	FaSearch,
	FaArrowLeft,
	FaArrowRight,
	FaLinkedinIn,
	FaInstagram,
	FaTwitter,
	FaBars,
	FaTimes,
	FaCheckCircle,
	FaTree,
	FaIndustry,
	FaTools,
	FaSeedling,
	FaThermometerHalf,
} from "react-icons/fa";
import { MdMarkEmailRead } from "react-icons/md";
import { FaPhoneSquareAlt } from "react-icons/fa";
import { LuCookie } from "react-icons/lu";
import libroImg from "../assets/libro-reclamaciones.png";
import logoAserradero from "../assets/logo-aserradero.png";

// Imágenes decorativas de la división (hero y banners — los productos se cargan dinámicamente desde la API)
import maderaImg01 from "../assets/madera/madera-image-01.png";
import maderaImg02 from "../assets/madera/madera-image-02.png";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>División Madera | Grupo Prevca</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Outfit:wght@400;600&family=Inter:wght@300;400&display=swap"
			rel="stylesheet"
		/>
		<style>
			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}
			.loader-spinner {
				border: 3px solid rgba(255, 255, 255, 0.1);
				border-left-color: #1d4c74;
				border-radius: 50%;
				width: 50px;
				height: 50px;
				animation: spin 0.8s linear infinite;
			}
			.reveal-item {
				opacity: 0;
				transform: translateY(30px);
				transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.reveal-item.active {
				opacity: 1;
				transform: translateY(0);
			}
			.nav-link {
				position: relative;
			}
			.nav-link::after {
				content: "";
				position: absolute;
				bottom: -2px;
				left: 0;
				width: 0;
				height: 2px;
				background-color: white;
				transition: width 0.3s ease;
			}
			.nav-link:hover::after {
				width: 100%;
			}

			/* Modal Styles */
			.modal-overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.5);
				backdrop-filter: blur(4px);
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 20px;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.3s ease;
			}
			.modal-overlay.active {
				opacity: 1;
				pointer-events: auto;
			}
			.modal-content {
				background: white;
				width: 100%;
				max-width: 800px;
				max-height: 80vh;
				overflow-y: auto;
				padding: 40px;
				border-radius: 2px;
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
				position: relative;
				border-top: 6px solid #1d4c74;
			}
			.modal-close {
				position: absolute;
				top: 20px;
				right: 20px;
				font-size: 24px;
				cursor: pointer;
				color: #2a3035;
				opacity: 0.5;
				transition: opacity 0.2s;
			}
			.modal-close:hover {
				opacity: 1;
			}
			.modal-body h3 {
				color: #1d4c74;
				font-weight: 700;
				margin-bottom: 20px;
			}
			.modal-body section {
				margin-bottom: 24px;
			}
			.modal-body h4 {
				font-weight: 700;
				margin-bottom: 8px;
				color: #2a3035;
			}
			.modal-body p {
				color: #4b5563;
				line-height: 1.6;
				margin-bottom: 12px;
			}
		</style>
	</head>
	<body
		class="bg-white text-gray-800 font-body selection:bg-[#1d4c74] selection:text-white overflow-x-hidden"
	>
		<!-- CORPORATE LOADER -->
		<div
			id="loader-overlay"
			class="fixed inset-0 z-[100] flex flex-col items-center justify-center transition-opacity duration-700"
		>
			<div class="absolute inset-0 bg-black/30 backdrop-blur-md"></div>
			<div class="relative z-10">
				<div class="loader-spinner"></div>
			</div>
		</div>

		<!-- Main Navbar -->
		<nav
			class="bg-[#2a3035] text-white py-4 px-6 md:px-8 flex justify-between items-center font-ui sticky top-0 z-50 transition-all duration-300"
		>
			<a href="/" class="flex items-center gap-3 hover:opacity-90 transition-opacity">
				<img src={logoAserradero.src} alt="Aserradero Prevca" class="h-10 md:h-14 w-auto object-contain brightness-0 invert" />
			</a>

			<!-- Desktop Menu -->
			<div
				class="hidden lg:flex gap-8 text-sm font-semibold tracking-wide uppercase"
			>
				<a
					href="/"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Inicio</a
				>
				<a
					href="/nosotros"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Sobre Nosotros</a
				>
				<a
					href="/madera"
					class="nav-link text-white border-b-2 border-white cursor-pointer"
					>Aserradero Prevca</a
				>
				<a
					href="/alojamiento"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Alojamiento</a
				>
				<a
					href="/cafe"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Café</a
				>
				<a
					href="/transporte"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Transporte</a
				>
				<a
					href="/#contact-section"
					class="nav-link hover:text-gray-300 transition-colors cursor-pointer"
					>Contacto</a
				>
			</div>

			<!-- Mobile Menu Toggle -->
			<button
				id="menu-toggle"
				class="lg:hidden text-2xl text-white cursor-pointer"
			>
				<div id="icon-bars"><FaBars /></div>
				<div id="icon-times" class="hidden"><FaTimes /></div>
			</button>
		</nav>

		<!-- Mobile Menu Drawer -->
		<div
			id="mobile-menu"
			class="fixed inset-0 bg-[#2a3035] z-40 transform translate-x-full transition-transform duration-300 lg:hidden pt-24 px-8 overflow-y-auto"
		>
			<div
				class="flex flex-col gap-6 text-xl text-white font-ui uppercase font-bold tracking-widest"
			>
				<a href="/" class="border-b border-white/10 pb-4 cursor-pointer"
					>Inicio</a
				>
				<a
					href="/nosotros"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Sobre Nosotros</a
				>
				<a
					href="/madera"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Aserradero Prevca</a
				>
				<a
					href="/alojamiento"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Alojamiento</a
				>
				<a
					href="/cafe"
					class="border-b border-white/10 pb-4 cursor-pointer">Café</a
				>
				<a
					href="/transporte"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Transporte</a
				>
				<a
					href="/#contact-section"
					class="border-b border-white/10 pb-4 cursor-pointer"
					>Contacto</a
				>
				<a
					href="/ecommerce"
					class="bg-[#1d4c74] text-center py-4 mt-4 cursor-pointer text-sm"
					>Tienda Virtual</a
				>
			</div>
		</div>

		<!-- Hero Section -->
		<header
			class="relative h-[60vh] md:h-[70vh] flex items-center justify-center overflow-hidden"
		>
			<div class="absolute inset-0 bg-black/50 z-10"></div>
			<img
				src={maderaImg01.src}
				alt="División Madera"
				class="absolute inset-0 w-full h-full object-cover"
			/>
			<div class="relative z-20 text-center px-6">
				<h1
					class="text-4xl md:text-7xl font-extrabold font-display text-white uppercase tracking-tighter mb-4"
				>
					Madera Sustentable
				</h1>
				<div class="w-24 h-2 bg-white mx-auto mb-6"></div>
				<p
					class="max-w-2xl mx-auto text-lg md:text-xl text-white/90 font-body leading-relaxed"
				>
					Líderes en el procesamiento y distribución de madera de alta
					calidad, con procesos eficientes y controlados, respaldados
					por la certificación ISO 9001.
				</p>
			</div>
		</header>

		<!-- Content Section -->
		<section class="py-24 px-6 md:px-8 bg-white">
			<div
				class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
			>
				<div class="space-y-8 reveal-item">
					<h2
						class="text-3xl md:text-5xl font-extrabold font-display text-[#1d4c74] uppercase tracking-tight leading-tight"
					>
						Procesos sólidos, resultados confiables
					</h2>
					<p class="text-lg font-body text-gray-600 leading-relaxed">
						Nuestra división de madera se especializa en la
						transformación de recursos naturales bajo estrictos
						estándares de calidad. Contamos con procesos
						industrializados que garantizan un producto final
						superior para el mercado nacional e internacional.
					</p>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
						<div class="flex items-start gap-4">
							<div class="text-[#1d4c74] text-2xl mt-1">
								<FaTree />
							</div>
							<div>
								<h4
									class="font-bold text-[#2a3035] uppercase text-sm mb-1"
								>
									Materia Prima
								</h4>
								<p class="text-sm text-gray-500">
									Seleccionamos proveedores bajo estándares
									definidos que aseguran consistencia y
									calidad en los insumos.
								</p>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="text-[#1d4c74] text-2xl mt-1">
								<FaIndustry />
							</div>
							<div>
								<h4
									class="font-bold text-[#2a3035] uppercase text-sm mb-1"
								>
									Tecnología
								</h4>
								<p class="text-sm text-gray-500">
									Equipamiento de tecnología europea que
									garantiza cortes de alta precisión.
								</p>
							</div>
						</div>
					</div>
				</div>
				<div
					class="relative reveal-item"
					style="transition-delay: 200ms"
				>
					<div class="absolute -inset-4 bg-[#1d4c74]/5 rounded-sm">
					</div>
					<img
						src={maderaImg02.src}
						alt="Procesamiento de Madera"
						class="relative z-10 w-full h-auto rounded-sm shadow-2xl"
					/>
				</div>
			</div>
		</section>

		<!-- Core Capabilities Section -->
		<section class="py-24 px-6 md:px-8 bg-gray-50">
			<div class="max-w-7xl mx-auto">
				<div
					class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8 reveal-item"
				>
					<div>
						<h4
							class="text-[#1d4c74] font-ui font-bold uppercase tracking-widest text-sm mb-4"
						>
							Capacidades Centrales
						</h4>
						<h2
							class="text-3xl md:text-5xl font-extrabold font-display text-[#2a3035] leading-tight max-w-2xl"
						>
							Excelencia en Procesamiento Industrial
						</h2>
					</div>
					<p class="text-gray-600 font-body max-w-md text-lg">
						Nuestras operaciones abarcan desde el corte de la madera
						hasta la entrega final, garantizando estándares de
						calidad en cada etapa .
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<!-- Card 1 -->
					<div
						class="bg-[#1d4c74] p-10 transition-all duration-300 reveal-item group border border-[#1d4c74] hover:bg-[#153a5b]"
					>
						<div
							class="w-14 h-14 bg-white/10 flex items-center justify-center text-white text-2xl mb-8"
						>
							<FaTools />
						</div>
						<h3
							class="text-xl font-bold font-display text-white mb-4"
						>
							Descortezado
						</h3>
						<p
							class="text-white/80 font-body text-sm leading-relaxed"
						>
							Se realiza mediante equipos mecánicos que permiten
							la remoción controlada de la corteza, minimizando
							daños en la fibra y optimizando la preparación del
							material para su procesamiento posterior.
						</p>
					</div>

					<!-- Card 2 -->
					<div
						class="bg-[#1d4c74] p-10 transition-all duration-300 reveal-item group border border-[#1d4c74] hover:bg-[#153a5b]"
						style="transition-delay: 100ms;"
					>
						<div
							class="w-14 h-14 bg-white/10 flex items-center justify-center text-white text-2xl mb-8"
						>
							<FaSeedling />
						</div>
						<h3
							class="text-xl font-bold font-display text-white mb-4"
						>
							Corte
						</h3>
						<p
							class="text-white/80 font-body text-sm leading-relaxed"
						>
							Se ejecuta con maquinaria de precisión de origen
							europeo, asegurando tolerancias dimensionales
							controladas y un óptimo rendimiento de la materia
							prima.
						</p>
					</div>

					<!-- Card 3 -->
					<div
						class="bg-[#1d4c74] p-10 transition-all duration-300 reveal-item group border border-[#1d4c74] hover:bg-[#153a5b]"
						style="transition-delay: 200ms;"
					>
						<div
							class="w-14 h-14 bg-white/10 flex items-center justify-center text-white text-2xl mb-8"
						>
							<FaThermometerHalf />
						</div>
						<h3
							class="text-xl font-bold font-display text-white mb-4"
						>
							Limpieza
						</h3>
						<p
							class="text-white/80 font-body text-sm leading-relaxed"
						>
							Se lleva a cabo mediante equipos calibrados que
							garantizan uniformidad superficial, reducción de
							irregularidades y cumplimiento de especificaciones
							técnicas de acabado.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Catalog Section -->
		<section class="py-24 px-6 md:px-8 bg-white">
			<div class="max-w-7xl mx-auto">
				<!-- Banner Header -->
				<div
					class="relative rounded-none overflow-hidden mb-16 h-64 reveal-item flex items-center p-10"
				>
					<div class="absolute inset-0 bg-[#2a3035]/80 z-10"></div>
					<img
						src={maderaImg01.src}
						alt="Catálogo Madera"
						class="absolute inset-0 w-full h-full object-cover z-0"
					/>
					<div class="relative z-20">
						<h2
							class="text-3xl md:text-5xl font-extrabold font-display text-white mb-4"
						>
							Catálogo de División
						</h2>
						<p class="text-white/80 font-body text-lg max-w-xl">
							Madera premium de origen sostenible para
							construcción global y aplicaciones industriales.
						</p>
					</div>
				</div>

				<!-- ============ SECCIÓN 1: ASERRADERO PREVCA ============ -->
				<div class="mb-20 reveal-item">
					<div class="border-l-4 border-[#1d4c74] pl-6 mb-10">
						<span class="font-ui text-xs font-bold tracking-widest text-[#1d4c74] uppercase">
							División de Producción
						</span>
						<h3 class="text-3xl md:text-4xl font-display font-extrabold text-[#2a3035] mt-2">
							Aserradero PREVCA
						</h3>
						<p class="text-gray-600 font-body mt-3 max-w-2xl">
							Madera aserrada, subproductos industriales y productos terminados fabricados en
							nuestro propio aserradero. Calidad garantizada y suministro permanente.
						</p>
					</div>
					<div
						id="prevca-products-grid"
						class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 min-h-[400px]"
					>
						<!-- Productos PREVCA cargados desde la API -->
					</div>
				</div>

				<!-- ============ SECCIÓN 2: CORPORACIÓN MADERERA COPESA ============ -->
				<div class="reveal-item">
					<div class="border-l-4 border-[#1d4c74] pl-6 mb-10">
						<span class="font-ui text-xs font-bold tracking-widest text-[#1d4c74] uppercase">
							Catálogo de Especies
						</span>
						<h3 class="text-3xl md:text-4xl font-display font-extrabold text-[#2a3035] mt-2">
							Corporación Maderera COPESA
						</h3>
						<p class="text-gray-600 font-body mt-3 max-w-2xl">
							Biblioteca técnica de las especies de madera que comercializamos. Conozca origen,
							características y aplicaciones de cada una para elegir la más adecuada para su proyecto.
						</p>
					</div>
					<div
						id="copesa-products-grid"
						class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 min-h-[400px]"
					>
						<!-- Maderas COPESA cargadas desde la API (estilo librería) -->
					</div>
				</div>

				<!-- CTA Banner -->
				<div
					class="mt-16 bg-[#f4f7fa] rounded-none p-8 md:p-12 flex flex-col md:flex-row justify-between items-center gap-8 border border-[#1d4c74]/10 reveal-item"
				>
					<div class="text-center md:text-left">
						<h3
							class="text-2xl md:text-3xl font-extrabold font-display text-[#2a3035] mb-2"
						>
							¿Buscas dimensiones personalizadas?
						</h3>
						<p class="text-gray-600 font-body max-w-xl">
							Nuestra división maderera puede proporcionar
							servicios de corte y tratamiento a medida para
							proyectos de gran escala.
						</p>
					</div>
					<a
						href="/#contact-section"
						class="bg-[#1d4c74] text-white font-bold px-8 py-4 rounded font-ui tracking-wider hover:bg-[#2a3035] transition-colors shadow-lg whitespace-nowrap"
					>
						Solicitar Cotización
					</a>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="bg-[#2a3035] text-white pt-24 pb-12 px-6 md:px-8">
			<div
				class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-12 lg:gap-16 mb-24"
			>
				<div class="space-y-8">
					<div class="flex items-center gap-3">
						<div
							class="w-8 h-8 bg-white text-[#2a3035] font-extrabold flex items-center justify-center font-display text-lg"
						>
							P
						</div>
						<span
							class="text-2xl font-extrabold tracking-widest font-display uppercase"
							>PREVCA</span
						>
					</div>
					<p
						class="text-gray-400 text-sm font-body leading-relaxed max-w-xs"
					>
						Elevando estándares corporativos a través de la
						excelencia operativa y la diversificación estratégica.
					</p>
					<div class="flex gap-4">
						<a
							href="#"
							class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all"
							><FaLinkedinIn /></a
						>
						<a
							href="#"
							class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all"
							><FaInstagram /></a
						>
						<a
							href="#"
							class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all"
							><FaTwitter /></a
						>
					</div>
				</div>

				<!-- Contacto -->
				<div>
					<h4 class="font-extrabold mb-8 text-sm opacity-70">
						Contacto
					</h4>
					<div class="space-y-6 text-sm font-body">
						<p class="flex items-center gap-3">
							<span class="text-white text-xl"
								><FaPhoneSquareAlt /></span
							>
							<span
								class="text-gray-400 hover:text-white transition-colors cursor-pointer"
								>+51 987 654 321</span
							>
						</p>
						<p class="flex items-center gap-3">
							<span class="text-white text-xl"
								><MdMarkEmailRead /></span
							>
							<span
								class="text-gray-400 hover:text-white transition-colors cursor-pointer"
								>info@grupoprevca.com</span
							>
						</p>
					</div>
				</div>

				<!-- Libro de Reclamaciones -->
				<div>
					<h4 class="mb-6 text-sm opacity-70 text-white">
						Atención al Cliente
					</h4>
					<div class="flex flex-col gap-3 mt-2">
						<a
							href="#"
							class="bg-white p-1 rounded-sm hover:-translate-y-1 transition-transform cursor-pointer border-b-4 border-[#1d4c74] max-w-[200px] w-full flex justify-center items-center shadow-lg"
						>
							<img
								src={libroImg.src}
								alt="Libro de Reclamaciones"
								class="w-full h-auto max-h-24 object-contain"
							/>
						</a>
						<p
							class="text-[11px] text-gray-500 font-body uppercase tracking-widest pl-1 mt-1 font-bold"
						>
							Conforme a la Ley N° 29571
						</p>
					</div>
				</div>

				<!-- Corporativo Links -->
				<div>
					<h4 class="font-extrabold mb-6 text-sm opacity-70">
