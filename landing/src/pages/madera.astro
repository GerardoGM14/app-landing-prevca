---
import "../styles/global.css";
import {
	FaSearch,
	FaArrowLeft,
	FaArrowRight,
	FaLinkedinIn,
	FaInstagram,
	FaTwitter,
	FaBars,
	FaTimes,
	FaCheckCircle,
    FaTree,
    FaIndustry,
    FaTools,
    FaSeedling,
    FaThermometerHalf
} from "react-icons/fa";
import { MdMarkEmailRead } from "react-icons/md";
import { FaPhoneSquareAlt } from "react-icons/fa";
import { LuCookie } from "react-icons/lu";
import libroImg from "../assets/libro-reclamaciones.png";

// Imágenes de la División Madera
import maderaImg01 from "../assets/madera/madera-image-01.png";
import maderaImg02 from "../assets/madera/madera-image-02.png";
import maderaImg03 from "../assets/madera/madera-image-03.png";
import maderaImg04 from "../assets/madera/madera-image-04.png";
import maderaImg05 from "../assets/madera/madera-image-05.png";
import maderaImg06 from "../assets/madera/madera-image-06.png";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>División Madera | Grupo Prevca</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Outfit:wght@400;600&family=Inter:wght@300;400&display=swap"
			rel="stylesheet"
		/>
		<style>
			@keyframes spin { to { transform: rotate(360deg); } }
			.loader-spinner {
				border: 3px solid rgba(255, 255, 255, 0.1);
				border-left-color: #1d4c74;
				border-radius: 50%;
				width: 50px;
				height: 50px;
				animation: spin 0.8s linear infinite;
			}
			.reveal-item {
				opacity: 0;
				transform: translateY(30px);
				transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.reveal-item.active {
				opacity: 1;
				transform: translateY(0);
			}
			.nav-link { position: relative; }
			.nav-link::after {
				content: "";
				position: absolute;
				bottom: -2px;
				left: 0;
				width: 0;
				height: 2px;
				background-color: white;
				transition: width 0.3s ease;
			}
			.nav-link:hover::after { width: 100%; }

            /* Modal Styles */
			.modal-overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.5);
				backdrop-filter: blur(4px);
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 20px;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.3s ease;
			}
			.modal-overlay.active {
				opacity: 1;
				pointer-events: auto;
			}
			.modal-content {
				background: white;
				width: 100%;
				max-width: 800px;
				max-height: 80vh;
				overflow-y: auto;
				padding: 40px;
				border-radius: 2px;
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
				position: relative;
				border-top: 6px solid #1d4c74;
			}
			.modal-close {
				position: absolute;
				top: 20px;
				right: 20px;
				font-size: 24px;
				cursor: pointer;
				color: #2a3035;
				opacity: 0.5;
				transition: opacity 0.2s;
			}
			.modal-close:hover { opacity: 1; }
			.modal-body h3 { color: #1d4c74; font-weight: 700; margin-bottom: 20px; }
			.modal-body section { margin-bottom: 24px; }
			.modal-body h4 { font-weight: 700; margin-bottom: 8px; color: #2a3035; }
			.modal-body p { color: #4b5563; line-height: 1.6; margin-bottom: 12px; }
		</style>
	</head>
	<body class="bg-white text-gray-800 font-body selection:bg-[#1d4c74] selection:text-white overflow-x-hidden">
		<!-- CORPORATE LOADER -->
		<div id="loader-overlay" class="fixed inset-0 z-[100] flex flex-col items-center justify-center transition-opacity duration-700">
			<div class="absolute inset-0 bg-black/30 backdrop-blur-md"></div>
			<div class="relative z-10">
				<div class="loader-spinner"></div>
			</div>
		</div>

		<!-- Main Navbar -->
		<nav class="bg-[#2a3035] text-white py-4 px-6 md:px-8 flex justify-between items-center font-ui sticky top-0 z-50 transition-all duration-300">
			<div class="flex items-center gap-3">
				<div class="w-7 h-7 md:w-8 md:h-8 bg-white text-[#2a3035] font-extrabold flex items-center justify-center font-display text-base md:text-lg shadow-none">P</div>
				<span class="text-xl md:text-2xl font-extrabold tracking-widest font-display uppercase">GRUPO PREVCA</span>
			</div>

			<!-- Desktop Menu -->
			<div class="hidden lg:flex gap-8 text-sm font-semibold tracking-wide uppercase">
				<a href="/" class="nav-link hover:text-gray-300 transition-colors cursor-pointer">Inicio</a>
				<a href="/nosotros" class="nav-link hover:text-gray-300 transition-colors cursor-pointer">Sobre Nosotros</a>
				<a href="/madera" class="nav-link text-white border-b-2 border-white cursor-pointer">Madera</a>
				<a href="/hospitalidad" class="nav-link hover:text-gray-300 transition-colors cursor-pointer">Hospitalidad</a>
				<a href="/cafe" class="nav-link hover:text-gray-300 transition-colors cursor-pointer">Café</a>
				<a href="/#contact-section" class="nav-link hover:text-gray-300 transition-colors cursor-pointer">Contacto</a>
			</div>

			<!-- Mobile Menu Toggle -->
			<button id="menu-toggle" class="lg:hidden text-2xl text-white cursor-pointer">
				<div id="icon-bars"><FaBars /></div>
				<div id="icon-times" class="hidden"><FaTimes /></div>
			</button>
		</nav>

		<!-- Mobile Menu Drawer -->
		<div id="mobile-menu" class="fixed inset-0 bg-[#2a3035] z-40 transform translate-x-full transition-transform duration-300 lg:hidden pt-24 px-8 overflow-y-auto">
			<div class="flex flex-col gap-6 text-xl text-white font-ui uppercase font-bold tracking-widest">
				<a href="/" class="border-b border-white/10 pb-4 cursor-pointer">Inicio</a>
				<a href="/nosotros" class="border-b border-white/10 pb-4 cursor-pointer">Sobre Nosotros</a>
				<a href="/madera" class="border-b border-white/10 pb-4 cursor-pointer">Madera</a>
				<a href="/hospitalidad" class="border-b border-white/10 pb-4 cursor-pointer">Hospitalidad</a>
				<a href="/cafe" class="border-b border-white/10 pb-4 cursor-pointer">Café</a>
				<a href="/#contact-section" class="border-b border-white/10 pb-4 cursor-pointer">Contacto</a>
				<a href="/ecommerce" class="bg-[#1d4c74] text-center py-4 mt-4 cursor-pointer text-sm">Tienda Virtual</a>
			</div>
		</div>

		<!-- Hero Section -->
		<header class="relative h-[60vh] md:h-[70vh] flex items-center justify-center overflow-hidden">
			<div class="absolute inset-0 bg-black/50 z-10"></div>
			<img 
				src={maderaImg01.src} 
				alt="División Madera" 
				class="absolute inset-0 w-full h-full object-cover"
			/>
			<div class="relative z-20 text-center px-6">
				<h1 class="text-4xl md:text-7xl font-extrabold font-display text-white uppercase tracking-tighter mb-4">
					Madera Sustentable
				</h1>
				<div class="w-24 h-2 bg-white mx-auto mb-6"></div>
				<p class="max-w-2xl mx-auto text-lg md:text-xl text-white/90 font-body leading-relaxed">
					Líderes en la producción y exportación de madera de alta calidad, comprometidos con la gestión forestal responsable.
				</p>
			</div>
		</header>

		<!-- Content Section -->
		<section class="py-24 px-6 md:px-8 bg-white">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div class="space-y-8 reveal-item">
					<h2 class="text-3xl md:text-5xl font-extrabold font-display text-[#1d4c74] uppercase tracking-tight leading-tight">
						Excelencia en cada fibra
					</h2>
					<p class="text-lg font-body text-gray-600 leading-relaxed">
						Nuestra división de madera se especializa en la transformación de recursos naturales bajo estrictos estándares de calidad. Contamos con procesos industrializados que garantizan un producto final superior para el mercado nacional e internacional.
					</p>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
						<div class="flex items-start gap-4">
							<div class="text-[#1d4c74] text-2xl mt-1"><FaTree /></div>
							<div>
								<h4 class="font-bold text-[#2a3035] uppercase text-sm mb-1">Materia Prima</h4>
								<p class="text-sm text-gray-500">Seleccionamos los mejores bosques bajo manejo forestal sostenible.</p>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="text-[#1d4c74] text-2xl mt-1"><FaIndustry /></div>
							<div>
								<h4 class="font-bold text-[#2a3035] uppercase text-sm mb-1">Tecnología</h4>
								<p class="text-sm text-gray-500">Plantas de procesamiento de última generación para cortes precisos.</p>
							</div>
						</div>
					</div>
				</div>
				<div class="relative reveal-item" style="transition-delay: 200ms">
					<div class="absolute -inset-4 bg-[#1d4c74]/5 rounded-sm"></div>
					<img 
						src={maderaImg02.src} 
						alt="Procesamiento de Madera" 
						class="relative z-10 w-full h-auto rounded-sm shadow-2xl"
					/>
				</div>
			</div>
		</section>

		<!-- Core Capabilities Section -->
		<section class="py-24 px-6 md:px-8 bg-gray-50">
			<div class="max-w-7xl mx-auto">
				<div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8 reveal-item">
					<div>
						<h4 class="text-[#1d4c74] font-ui font-bold uppercase tracking-widest text-sm mb-4">Capacidades Centrales</h4>
						<h2 class="text-3xl md:text-5xl font-extrabold font-display text-[#2a3035] leading-tight max-w-2xl">
							Excelencia en Procesamiento Industrial
						</h2>
					</div>
					<p class="text-gray-600 font-body max-w-md text-lg">
						Nuestras operaciones madereras verticalmente integradas aseguran el control de calidad desde la semilla hasta la entrega final.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<!-- Card 1 -->
					<div class="bg-[#1d4c74] p-10 transition-all duration-300 reveal-item group border border-[#1d4c74] hover:bg-[#153a5b]">
						<div class="w-14 h-14 bg-white/10 flex items-center justify-center text-white text-2xl mb-8">
							<FaTools />
						</div>
						<h3 class="text-xl font-bold font-display text-white mb-4">Aserrado Industrial</h3>
						<p class="text-white/80 font-body text-sm leading-relaxed">
							Sistemas de aserrado automatizado de alta precisión optimizados para un rendimiento máximo e integridad estructural según estándares globales de construcción.
						</p>
					</div>
					
					<!-- Card 2 -->
					<div class="bg-[#1d4c74] p-10 transition-all duration-300 reveal-item group border border-[#1d4c74] hover:bg-[#153a5b]" style="transition-delay: 100ms;">
						<div class="w-14 h-14 bg-white/10 flex items-center justify-center text-white text-2xl mb-8">
							<FaSeedling />
						</div>
						<h3 class="text-xl font-bold font-display text-white mb-4">Reforestación</h3>
						<p class="text-white/80 font-body text-sm leading-relaxed">
							Programas de gestión forestal sostenible que aseguran el equilibrio ecológico y una cadena de suministro de materia prima consistente a largo plazo.
						</p>
					</div>

					<!-- Card 3 -->
					<div class="bg-[#1d4c74] p-10 transition-all duration-300 reveal-item group border border-[#1d4c74] hover:bg-[#153a5b]" style="transition-delay: 200ms;">
						<div class="w-14 h-14 bg-white/10 flex items-center justify-center text-white text-2xl mb-8">
							<FaThermometerHalf />
						</div>
						<h3 class="text-xl font-bold font-display text-white mb-4">Secado Avanzado</h3>
						<p class="text-white/80 font-body text-sm leading-relaxed">
							Tecnología de secado en horno de última generación para el control de humedad y durabilidad, cumpliendo con estrictos requisitos internacionales de exportación.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Catalog Section -->
		<section class="py-24 px-6 md:px-8 bg-white">
			<div class="max-w-7xl mx-auto">
				<!-- Banner Header -->
				<div class="relative rounded-none overflow-hidden mb-16 h-64 reveal-item flex items-center p-10">
					<div class="absolute inset-0 bg-[#2a3035]/80 z-10"></div>
					<img src={maderaImg01.src} alt="Catálogo Madera" class="absolute inset-0 w-full h-full object-cover z-0" />
					<div class="relative z-20">
						<h2 class="text-3xl md:text-5xl font-extrabold font-display text-white mb-4">Catálogo de División</h2>
						<p class="text-white/80 font-body text-lg max-w-xl">Madera premium de origen sostenible para construcción global y aplicaciones industriales.</p>
					</div>
				</div>

				<!-- Filter placeholder -->
				<div class="flex flex-wrap gap-4 items-center mb-12 font-ui text-sm reveal-item">
					<span class="font-bold text-gray-500 tracking-widest uppercase mr-4 hidden md:block">Tipo de Madera:</span>
					<button class="bg-[#1d4c74] text-white px-6 py-2 font-bold cursor-pointer border border-[#1d4c74]">Todas</button>
					<button class="bg-transparent text-gray-600 hover:bg-[#1d4c74] hover:text-white border border-gray-200 hover:border-[#1d4c74] px-6 py-2 font-semibold transition-colors cursor-pointer">Pino Radiata</button>
					<button class="bg-transparent text-gray-600 hover:bg-[#1d4c74] hover:text-white border border-gray-200 hover:border-[#1d4c74] px-6 py-2 font-semibold transition-colors cursor-pointer">Eucalipto</button>
					<button class="bg-transparent text-gray-600 hover:bg-[#1d4c74] hover:text-white border border-gray-200 hover:border-[#1d4c74] px-6 py-2 font-semibold transition-colors cursor-pointer">Teca</button>
					<button class="bg-transparent text-gray-600 hover:bg-[#1d4c74] hover:text-white border border-gray-200 hover:border-[#1d4c74] px-6 py-2 font-semibold transition-colors cursor-pointer">Roble</button>
				</div>

				<!-- Grid of Products -->
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 reveal-item">
					<!-- Product 1 -->
					<div class="bg-white border border-gray-200 group hover:border-[#1d4c74] transition-colors flex flex-col">
						<div class="h-48 overflow-hidden bg-gray-100 relative">
							<img src={maderaImg03.src} alt="Pino Radiata" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
						<div class="p-6 flex flex-col flex-grow">
							<div class="flex justify-between items-start mb-2">
								<h3 class="font-display font-bold text-[#2a3035] leading-tight">Madera Aserrada Pino Radiata</h3>
								<span class="bg-[#1d4c74]/10 text-[#1d4c74] text-[10px] font-bold px-2 py-1 uppercase tracking-wider ml-2 shrink-0">Nuevo</span>
							</div>
							<p class="text-sm text-gray-500 font-body mb-6">Dimensiones: 2x4 a 8x12</p>
							<div class="flex justify-between items-center text-xs font-bold text-gray-400 mt-auto pt-4 border-t border-gray-100">
								<span>Ref: RP-01</span>
								<a href="/madera/pino-radiata" class="text-[#1d4c74] hover:text-[#153a5b] flex items-center gap-1 group-hover:gap-2 transition-all">Detalles <FaArrowRight /></a>
							</div>
						</div>
					</div>

					<!-- Product 2 -->
					<div class="bg-white border border-gray-200 group hover:border-[#1d4c74] transition-colors flex flex-col">
						<div class="h-48 overflow-hidden bg-gray-100">
							<img src={maderaImg04.src} alt="Eucalipto" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
						<div class="p-6 flex flex-col flex-grow">
							<h3 class="font-display font-bold text-[#2a3035] leading-tight mb-2">Tablas de Eucalipto Globulus</h3>
							<p class="text-sm text-gray-500 font-body mb-6">Espesor: 25mm - 50mm</p>
							<div class="flex justify-between items-center text-xs font-bold text-gray-400 mt-auto pt-4 border-t border-gray-100">
								<span>Ref: EG-04</span>
								<a href="/madera/eucalipto-globulus" class="text-[#1d4c74] hover:text-[#153a5b] flex items-center gap-1 group-hover:gap-2 transition-all">Detalles <FaArrowRight /></a>
							</div>
						</div>
					</div>

					<!-- Product 3 -->
					<div class="bg-white border border-gray-200 group hover:border-[#1d4c74] transition-colors flex flex-col">
						<div class="h-48 overflow-hidden bg-gray-100">
							<img src={maderaImg05.src} alt="Vigas" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
						<div class="p-6 flex flex-col flex-grow">
							<h3 class="font-display font-bold text-[#2a3035] leading-tight mb-2">Vigas Estructurales Pino</h3>
							<p class="text-sm text-gray-500 font-body mb-6">Longitud: Hasta 6m continuos</p>
							<div class="flex justify-between items-center text-xs font-bold text-gray-400 mt-auto pt-4 border-t border-gray-100">
								<span>Ref: RP-ST</span>
								<a href="/madera/vigas-pino" class="text-[#1d4c74] hover:text-[#153a5b] flex items-center gap-1 group-hover:gap-2 transition-all">Detalles <FaArrowRight /></a>
							</div>
						</div>
					</div>

					<!-- Product 4 -->
					<div class="bg-white border border-gray-200 group hover:border-[#1d4c74] transition-colors flex flex-col">
						<div class="h-48 overflow-hidden bg-gray-100">
							<img src={maderaImg06.src} alt="Mueble" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
						</div>
						<div class="p-6 flex flex-col flex-grow">
							<h3 class="font-display font-bold text-[#2a3035] leading-tight mb-2">Eucalipto Grado Mueble</h3>
							<p class="text-sm text-gray-500 font-body mb-6">Secado Horno: 10-12% Humedad</p>
							<div class="flex justify-between items-center text-xs font-bold text-gray-400 mt-auto pt-4 border-t border-gray-100">
								<span>Ref: EG-FG</span>
								<a href="/madera/eucalipto-mueble" class="text-[#1d4c74] hover:text-[#153a5b] flex items-center gap-1 group-hover:gap-2 transition-all">Detalles <FaArrowRight /></a>
							</div>
						</div>
					</div>
				</div>

				<!-- CTA Banner -->
				<div class="mt-16 bg-[#f4f7fa] rounded-none p-8 md:p-12 flex flex-col md:flex-row justify-between items-center gap-8 border border-[#1d4c74]/10 reveal-item">
					<div class="text-center md:text-left">
						<h3 class="text-2xl md:text-3xl font-extrabold font-display text-[#2a3035] mb-2">¿Buscas dimensiones personalizadas?</h3>
						<p class="text-gray-600 font-body max-w-xl">Nuestra división maderera puede proporcionar servicios de corte y tratamiento a medida para proyectos de gran escala.</p>
					</div>
					<a href="/#contact-section" class="bg-[#1d4c74] text-white font-bold px-8 py-4 rounded font-ui tracking-wider hover:bg-[#2a3035] transition-colors shadow-lg whitespace-nowrap">
						Solicitar Cotización
					</a>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="bg-[#2a3035] text-white pt-24 pb-12 px-6 md:px-8">
			<div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-12 lg:gap-16 mb-24">
				<div class="space-y-8">
					<div class="flex items-center gap-3">
						<div class="w-8 h-8 bg-white text-[#2a3035] font-extrabold flex items-center justify-center font-display text-lg">P</div>
						<span class="text-2xl font-extrabold tracking-widest font-display uppercase">PREVCA</span>
					</div>
					<p class="text-gray-400 text-sm font-body leading-relaxed max-w-xs">Elevando estándares corporativos a través de la excelencia operativa y la diversificación estratégica.</p>
					<div class="flex gap-4">
						<a href="#" class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all"><FaLinkedinIn /></a>
						<a href="#" class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all"><FaInstagram /></a>
						<a href="#" class="w-10 h-10 border border-white/10 flex items-center justify-center hover:bg-white hover:text-[#2a3035] transition-all"><FaTwitter /></a>
					</div>
				</div>

				<!-- Contacto -->
				<div>
					<h4 class="font-extrabold mb-8 text-sm opacity-70">Contacto</h4>
					<div class="space-y-6 text-sm font-body">
						<p class="flex items-center gap-3">
							<span class="text-white text-xl"><FaPhoneSquareAlt /></span>
							<span class="text-gray-400 hover:text-white transition-colors cursor-pointer">+51 987 654 321</span>
						</p>
						<p class="flex items-center gap-3">
							<span class="text-white text-xl"><MdMarkEmailRead /></span>
							<span class="text-gray-400 hover:text-white transition-colors cursor-pointer">info@grupoprevca.com</span>
						</p>
					</div>
				</div>

				<!-- Libro de Reclamaciones -->
				<div>
					<h4 class="mb-6 text-sm opacity-70 text-white">Atención al Cliente</h4>
					<div class="flex flex-col gap-3 mt-2">
						<a href="#" class="bg-white p-1 rounded-sm hover:-translate-y-1 transition-transform cursor-pointer border-b-4 border-[#1d4c74] max-w-[200px] w-full flex justify-center items-center shadow-lg">
							<img src={libroImg.src} alt="Libro de Reclamaciones" class="w-full h-auto max-h-24 object-contain" />
						</a>
						<p class="text-[11px] text-gray-500 font-body uppercase tracking-widest pl-1 mt-1 font-bold">Conforme a la Ley N° 29571</p>
					</div>
				</div>

				<!-- Corporativo Links -->
				<div>
					<h4 class="font-extrabold mb-6 text-sm opacity-70">Corporativo</h4>
					<ul class="space-y-4 text-sm text-gray-400 font-body">
						<li><a href="/nosotros" class="hover:text-white transition-all underline-offset-4 hover:underline">Sobre Nosotros</a></li>
						<li><a href="/#contact-section" class="hover:text-white transition-all underline-offset-4 hover:underline">Centro de Contacto</a></li>
						<li><button id="btn-privacy" class="hover:text-white transition-all underline-offset-4 hover:underline cursor-pointer bg-transparent border-none p-0 text-gray-400">Política de Privacidad</button></li>
						<li><button id="btn-terms" class="hover:text-white transition-all underline-offset-4 hover:underline cursor-pointer bg-transparent border-none p-0 text-gray-400">Términos Legales</button></li>
					</ul>
				</div>
			</div>
            <div class="max-w-7xl mx-auto border-t border-white/5 pt-12 flex flex-col md:flex-row justify-between items-center gap-8 text-xs font-ui tracking-[0.2em] text-gray-500 uppercase font-bold">
				<p>© 2024 GRUPO PREVCA. TODOS LOS DERECHOS RESERVADOS.</p>
				<p>DISCUSIÓN Y DISEÑO POR <span class="text-white">TRIGA S.A.C.</span></p>
			</div>
		</footer>

		<!-- Modals -->
		<div id="modal-privacy" class="modal-overlay">
			<div class="modal-content relative">
				<span class="modal-close">&times;</span>
				<div class="modal-body font-body">
					<h3>Política de Privacidad</h3>
					<section><h4>1. Protección de Datos</h4><p>De conformidad con la Ley N° 29733, Grupo Prevca garantiza el tratamiento responsable de toda información.</p></section>
				</div>
			</div>
		</div>
		<div id="modal-terms" class="modal-overlay">
			<div class="modal-content relative">
				<span class="modal-close">&times;</span>
				<div class="modal-body font-body">
					<h3>Términos y Condiciones Legales</h3>
					<section><h4>1. Propiedad Intelectual</h4><p>Todo el contenido editorial y logotipos son propiedad exclusiva de Grupo Prevca.</p></section>
				</div>
			</div>
		</div>

		<script is:inline>
			document.addEventListener("DOMContentLoaded", () => {
				const body = document.body;
				const loader = document.getElementById("loader-overlay");
				setTimeout(() => {
					loader.style.opacity = "0";
					setTimeout(() => { loader.style.display = "none"; }, 700);
				}, 500);

				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) entry.target.classList.add('active');
					});
				}, { threshold: 0.15 });
				document.querySelectorAll('.reveal-item').forEach(el => observer.observe(el));

				// Mobile Menu
				const menuToggle = document.getElementById("menu-toggle");
				const mobileMenu = document.getElementById("mobile-menu");
				const iconBars = document.getElementById("icon-bars");
				const iconTimes = document.getElementById("icon-times");
				
				menuToggle?.addEventListener("click", () => {
					const isOpen = mobileMenu.classList.contains("translate-x-0");
					if (isOpen) {
						mobileMenu.classList.replace("translate-x-0", "translate-x-full");
						iconBars.classList.remove("hidden");
						iconTimes.classList.add("hidden");
						body.style.overflow = "auto";
					} else {
						mobileMenu.classList.replace("translate-x-full", "translate-x-0");
						iconBars.classList.add("hidden");
						iconTimes.classList.remove("hidden");
						body.style.overflow = "hidden";
					}
				});

				// Modals
				const btnPrivacy = document.getElementById("btn-privacy");
				const btnTerms = document.getElementById("btn-terms");
				const modalPrivacy = document.getElementById("modal-privacy");
				const modalTerms = document.getElementById("modal-terms");
				const closeBtns = document.querySelectorAll(".modal-close");

				const toggleModal = (modal, show) => {
					if (show) modal.classList.add("active");
					else modal.classList.remove("active");
				};

				btnPrivacy?.addEventListener("click", () => toggleModal(modalPrivacy, true));
				btnTerms?.addEventListener("click", () => toggleModal(modalTerms, true));
				closeBtns.forEach(btn => btn.addEventListener("click", () => {
					toggleModal(modalPrivacy, false);
					toggleModal(modalTerms, false);
				}));
			});
		</script>
	</body>
</html>
