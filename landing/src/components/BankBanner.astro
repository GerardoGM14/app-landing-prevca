---
/**
 * Banner de cuentas corrientes bancarias.
 * Muestra los 5 bancos con tooltip al hover con los datos de cuenta.
 * Usado en las páginas de divisiones para facilitar el pago a proveedores y clientes.
 */
---

<div
	class="max-w-7xl mx-auto border-t border-white/5 py-12 flex flex-col items-center gap-8 reveal-item"
>
	<h4
		class="font-extrabold text-[11px] opacity-50 tracking-[0.2em] uppercase text-center text-white"
	>
		Cuentas Corrientes Bancarias
	</h4>
	<div
		class="flex flex-wrap justify-center items-center gap-8 md:gap-16 w-full relative"
	>
		<!-- BCP -->
		<div class="group relative flex justify-center cursor-pointer">
			<img
				src="/bancos/bcp.png"
				alt="BCP"
				class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
			/>
			<div
				class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto"
			>
				<div
					class="bg-white text-gray-800 shadow-2xl rounded-sm overflow-hidden flex flex-col text-center border border-gray-100"
				>
					<div
						class="bg-[#002C6C] text-white px-4 py-3.5 font-bold font-display text-sm tracking-wide"
					>
						Aserradero Prevca SRL<br />
						<span
							class="text-[10px] font-normal opacity-80 tracking-normal"
							>RUC: 20605999264</span
						>
					</div>
					<div class="p-5 bg-white text-left">
						<p
							class="text-[9px] font-bold text-gray-400 tracking-wider uppercase mb-1"
						>
							Nº CTA SOLES:
						</p>
						<p
							class="text-base font-extrabold text-gray-800 tracking-tight mb-4"
						>
							305-7227583095
						</p>
						<div
							class="bg-[#EEF4FA] border border-[#D5E4F2] p-3 rounded-sm"
						>
							<p
								class="text-[9px] font-bold text-[#002C6C] tracking-wider uppercase mb-1"
							>
								CÓDIGO DE CTA. INTERBANCARIA SOLES
							</p>
							<p
								class="text-xs font-extrabold text-[#002C6C] tracking-tighter"
							>
								002-30500722758309517
							</p>
						</div>
					</div>
				</div>
				<div
					class="w-3 h-3 bg-white rotate-45 border-r border-b border-gray-100 -mt-1.5 shadow-sm"
				>
				</div>
			</div>
		</div>

		<!-- BBVA -->
		<div class="group relative flex justify-center cursor-pointer">
			<img
				src="/bancos/bbva.png"
				alt="BBVA"
				class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
			/>
			<div
				class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto"
			>
				<div
					class="bg-white text-gray-800 shadow-2xl rounded-sm overflow-hidden flex flex-col text-center border border-gray-100"
				>
					<div
						class="bg-[#004481] text-white px-4 py-3.5 font-bold font-display text-sm tracking-wide"
					>
						Aserradero Prevca SRL<br />
						<span
							class="text-[10px] font-normal opacity-80 tracking-normal"
							>RUC: 20605999264</span
						>
					</div>
					<div class="p-5 bg-white text-center">
						<p class="text-sm font-bold text-gray-700">
							Cuenta disponible a solicitud
						</p>
						<p class="text-xs text-gray-400 mt-2 leading-relaxed">
							Por favor consulte con su asesor comercial o de
							administración.
						</p>
					</div>
				</div>
				<div
					class="w-3 h-3 bg-white rotate-45 border-r border-b border-gray-100 -mt-1.5 shadow-sm"
				>
				</div>
			</div>
		</div>

		<!-- Scotiabank -->
		<div class="group relative flex justify-center cursor-pointer">
			<img
				src="/bancos/scotiabank.png"
				alt="Scotiabank"
				class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
			/>
			<div
				class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto"
			>
				<div
					class="bg-white text-gray-800 shadow-2xl rounded-sm overflow-hidden flex flex-col text-center border border-gray-100"
				>
					<div
						class="bg-[#ED1C24] text-white px-4 py-3.5 font-bold font-display text-sm tracking-wide"
					>
						Aserradero Prevca<br />
						<span
							class="text-[10px] font-normal opacity-80 tracking-normal"
							>RUC: 20605999264</span
						>
					</div>
					<div class="p-5 bg-white text-left">
						<p
							class="text-[9px] font-bold text-gray-400 tracking-wider uppercase mb-1"
						>
							Nº CTA SOLES:
						</p>
						<p
							class="text-base font-extrabold text-gray-800 tracking-tight mb-4"
						>
							401-0329813
						</p>
						<div
							class="bg-[#FFEAEA] border border-[#FFD1D1] p-3 rounded-sm"
						>
							<p
								class="text-[9px] font-bold text-[#ED1C24] tracking-wider uppercase mb-1"
							>
								CÓDIGO DE CTA. INTERBANCARIA SOLES
							</p>
							<p
								class="text-xs font-extrabold text-[#ED1C24] tracking-tighter"
							>
								009-174-204010329813-43
							</p>
						</div>
					</div>
				</div>
				<div
					class="w-3 h-3 bg-white rotate-45 border-r border-b border-gray-100 -mt-1.5 shadow-sm"
				>
				</div>
			</div>
		</div>

		<!-- Interbank -->
		<div class="group relative flex justify-center cursor-pointer">
			<img
				src="/bancos/interbank.png"
				alt="Interbank"
				class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
			/>
			<div
				class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto"
			>
				<div
					class="bg-white text-gray-800 shadow-2xl rounded-sm overflow-hidden flex flex-col text-center border border-gray-100"
				>
					<div
						class="bg-[#00A859] text-white px-4 py-3.5 font-bold font-display text-sm tracking-wide"
					>
						Aserradero Prevca SRL<br />
						<span
							class="text-[10px] font-normal opacity-80 tracking-normal"
							>RUC: 20605999264</span
						>
					</div>
					<div class="p-5 bg-white text-left">
						<p
							class="text-[9px] font-bold text-gray-400 tracking-wider uppercase mb-1"
						>
							Nº CTA SOLES:
						</p>
						<p
							class="text-base font-extrabold text-gray-800 tracking-tight mb-4"
						>
							7003007114820
						</p>
						<div
							class="bg-[#EAF7F0] border border-[#CDECDA] p-3 rounded-sm"
						>
							<p
								class="text-[9px] font-bold text-[#00A859] tracking-wider uppercase mb-1"
							>
								CÓDIGO DE CTA. INTERBANCARIA SOLES
							</p>
							<p
								class="text-xs font-extrabold text-[#00A859] tracking-tighter"
							>
								00370000300711482026
							</p>
						</div>
					</div>
				</div>
				<div
					class="w-3 h-3 bg-white rotate-45 border-r border-b border-gray-100 -mt-1.5 shadow-sm"
				>
				</div>
			</div>
		</div>

		<!-- Banco de la Nación -->
		<div class="group relative flex justify-center cursor-pointer">
			<img
				src="/bancos/bn.png"
				alt="Banco de la Nación"
				class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
			/>
			<div
				class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto"
			>
				<div
					class="bg-white text-gray-800 shadow-2xl rounded-sm overflow-hidden flex flex-col text-center border border-gray-100"
				>
					<div
						class="bg-[#7F8C8D] text-white px-4 py-3.5 font-bold font-display text-sm tracking-wide"
					>
						Aserradero Prevca SRL<br />
						<span
							class="text-[10px] font-normal opacity-80 tracking-normal"
							>RUC: 20605999264</span
						>
					</div>
					<div class="p-5 bg-white text-center">
						<p class="text-sm font-bold text-gray-700">
							Cuenta disponible a solicitud
						</p>
						<p class="text-xs text-gray-400 mt-2 leading-relaxed">
							Por favor consulte con su asesor comercial o de
							administración.
						</p>
					</div>
				</div>
				<div
					class="w-3 h-3 bg-white rotate-45 border-r border-b border-gray-100 -mt-1.5 shadow-sm"
				>
				</div>
			</div>
		</div>
	</div>
</div>
