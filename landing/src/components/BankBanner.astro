						</div>
					) : (
						<div class="p-5 bg-white text-center">
							<p class="text-sm font-bold text-gray-700">
								Cuenta disponible a solicitud
							</p>
							<p class="text-xs text-gray-400 mt-2 leading-relaxed">
								Por favor consulte con su asesor comercial o de
								administración.
							</p>
						</div>
					)}
				</div>
				<div
					class="w-3 h-3 bg-white rotate-45 border-r border-b border-gray-100 -mt-1.5 shadow-sm"
				>
				</div>
			</div>
		</div>

		<!-- Scotiabank -->
		<div class="group relative flex justify-center cursor-pointer">
			<img
				src="/bancos/scotiabank.png"
				alt="Scotiabank"
				class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
			/>
			<div
				class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto"
			>
				<div
