						</div>
					)}
				</div>
				<div
					class="w-3 h-3 bg-white rotate-45 border-r border-b border-gray-100 -mt-1.5 shadow-sm"
				>
				</div>
			</div>
		</div>

		<!-- Interbank -->
		<div class="group relative flex justify-center cursor-pointer">
			<img
				src="/bancos/interbank.png"
				alt="Interbank"
				class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
			/>
			<div
				class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto"
			>
				<div
					class="bg-white text-gray-800 shadow-2xl rounded-sm overflow-hidden flex flex-col text-center border border-gray-100"
				>
					<div
						class="bg-[#00A859] text-white px-4 py-3.5 font-bold font-display text-sm tracking-wide"
					>
						{companyName}<br />
						<span
							class="text-[10px] font-normal opacity-80 tracking-normal"
							>RUC: {ruc}</span
						>
					</div>
					{accounts.inter ? (
						<div class="p-5 bg-white text-left">
							<p class="text-[9px] font-bold text-gray-400 tracking-wider uppercase mb-1">
								Nº CTA SOLES:
							</p>
							<p class="text-base font-extrabold text-gray-800 tracking-tight mb-4">
								{accounts.inter.soles}
							</p>
							{accounts.inter.cci && (
								<div class="bg-[#EAF7F0] border border-[#CDECDA] p-3 rounded-sm">
									<p class="text-[9px] font-bold text-[#00A859] tracking-wider uppercase mb-1">
										CÓDIGO DE CTA. INTERBANCARIA SOLES
									</p>
									<p class="text-xs font-extrabold text-[#00A859] tracking-tighter">
										{accounts.inter.cci}
									</p>
								</div>
							)}
						</div>
					) : (
						<div class="p-5 bg-white text-center">
							<p class="text-sm font-bold text-gray-700">
								Cuenta disponible a solicitud
							</p>
							<p class="text-xs text-gray-400 mt-2 leading-relaxed">
								Por favor consulte con su asesor comercial o de
								administración.
							</p>
						</div>
					)}
				</div>
				<div
					class="w-3 h-3 bg-white rotate-45 border-r border-b border-gray-100 -mt-1.5 shadow-sm"
				>
				</div>
			</div>
		</div>

		<!-- Banco de la Nación -->
		<div class="group relative flex justify-center cursor-pointer">
			<img
				src="/bancos/bn.png"
				alt="Banco de la Nación"
				class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
			/>
			<div
				class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto"
			>
				<div
					class="bg-white text-gray-800 shadow-2xl rounded-sm overflow-hidden flex flex-col text-center border border-gray-100"
				>
					<div
						class="bg-[#7F8C8D] text-white px-4 py-3.5 font-bold font-display text-sm tracking-wide"
					>
						{companyName}<br />
						<span
							class="text-[10px] font-normal opacity-80 tracking-normal"
							>RUC: {ruc}</span
						>
					</div>
					{accounts.bn ? (
						<div class="p-5 bg-white text-left">
							<p class="text-[9px] font-bold text-gray-400 tracking-wider uppercase mb-1">
								Nº CTA SOLES:
							</p>
							<p class="text-base font-extrabold text-gray-800 tracking-tight mb-4">
								{accounts.bn.soles}
							</p>
							{accounts.bn.cci && (
								<div class="bg-[#F0F1F2] border border-[#D5D8DA] p-3 rounded-sm">
									<p class="text-[9px] font-bold text-[#7F8C8D] tracking-wider uppercase mb-1">
