---
/**
 * Banner de cuentas corrientes bancarias parametrizable.
 *
 * Recibe los datos de la empresa titular y un mapa de cuentas por banco.
 * Cualquier banco no provisto en `accounts` muestra el tooltip por defecto
 * "Cuenta disponible a solicitud".
 *
 * Uso:
 *   <BankBanner
 *     companyName="Aserradero Prevca SRL"
 *     ruc="20605999264"
 *     accounts={{
 *       bcp:    { soles: "305-7227583095", cci: "002-30500722758309517" },
 *       scotia: { soles: "401-0329813", cci: "009-174-204010329813-43" },
 *       inter:  { soles: "7003007114820", cci: "00370000300711482026" },
 *     }}
 *   />
 */

interface BankAccount {
	soles: string;
	cci?: string;
}

interface Props {
	companyName: string;
	ruc: string;
	accounts?: {
		bcp?: BankAccount;
		bbva?: BankAccount;
		scotia?: BankAccount;
		inter?: BankAccount;
		bn?: BankAccount;
	};
}

const { companyName, ruc, accounts = {} } = Astro.props;
---

<div
	class="max-w-7xl mx-auto border-t border-white/5 py-12 flex flex-col items-center gap-8 reveal-item"
>
	<h4
		class="font-extrabold text-[11px] opacity-50 tracking-[0.2em] uppercase text-center text-white"
	>
		Cuentas Corrientes Bancarias
	</h4>
	<div
		class="flex flex-wrap justify-center items-center gap-8 md:gap-16 w-full relative"
	>
		<!-- BCP -->
		<div class="group relative flex justify-center cursor-pointer">
			<img
				src="/bancos/bcp.png"
				alt="BCP"
				class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
			/>
			<div
				class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto"
			>
				<div
					class="bg-white text-gray-800 shadow-2xl rounded-sm overflow-hidden flex flex-col text-center border border-gray-100"
				>
					<div
						class="bg-[#002C6C] text-white px-4 py-3.5 font-bold font-display text-sm tracking-wide"
					>
						{companyName}<br />
						<span
							class="text-[10px] font-normal opacity-80 tracking-normal"
							>RUC: {ruc}</span
						>
					</div>
					{accounts.bcp ? (
						<div class="p-5 bg-white text-left">
							<p class="text-[9px] font-bold text-gray-400 tracking-wider uppercase mb-1">
								Nº CTA SOLES:
							</p>
							<p class="text-base font-extrabold text-gray-800 tracking-tight mb-4">
								{accounts.bcp.soles}
							</p>
							{accounts.bcp.cci && (
								<div class="bg-[#EEF4FA] border border-[#D5E4F2] p-3 rounded-sm">
									<p class="text-[9px] font-bold text-[#002C6C] tracking-wider uppercase mb-1">
										CÓDIGO DE CTA. INTERBANCARIA SOLES
									</p>
									<p class="text-xs font-extrabold text-[#002C6C] tracking-tighter">
										{accounts.bcp.cci}
									</p>
								</div>
							)}
						</div>
					) : (
						<div class="p-5 bg-white text-center">
							<p class="text-sm font-bold text-gray-700">
								Cuenta disponible a solicitud
							</p>
							<p class="text-xs text-gray-400 mt-2 leading-relaxed">
								Por favor consulte con su asesor comercial o de
								administración.
							</p>
						</div>
					)}
				</div>
				<div
					class="w-3 h-3 bg-white rotate-45 border-r border-b border-gray-100 -mt-1.5 shadow-sm"
				>
				</div>
			</div>
		</div>

		<!-- BBVA -->
		<div class="group relative flex justify-center cursor-pointer">
			<img
				src="/bancos/bbva.png"
				alt="BBVA"
				class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
			/>
			<div
				class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto"
			>
				<div
					class="bg-white text-gray-800 shadow-2xl rounded-sm overflow-hidden flex flex-col text-center border border-gray-100"
