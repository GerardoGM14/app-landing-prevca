---
/**
 * Banner de cuentas corrientes bancarias parametrizable.
 *
 * Recibe los datos de la empresa titular y un mapa de cuentas por banco.
 * SOLO se muestran los bancos presentes en `accounts` (los que no tienen
 * cuenta no aparecen).
 *
 * Uso:
 *   <BankBanner
 *     companyName="Aserradero Prevca SRL"
 *     ruc="20605999264"
 *     accounts={{
 *       bcp:    { soles: "305-7227583095", cci: "002-30500722758309517" },
 *       bbva:   { soles: "00110288020036174981", cci: "011 288 000200361749 81" },
 *       inter:  { soles: "7003007114820", cci: "00370000300711482026" },
 *       scotia: { soles: "401-0329813", cci: "009-174-204010329813-43" },
 *     }}
 *   />
 */

interface BankAccount {
	soles: string;
	cci?: string;
}

type BankKey = "bcp" | "bbva" | "scotia" | "inter" | "bn" | "cajatrujillo";

interface Props {
	companyName: string;
	ruc: string;
	accounts?: Partial<Record<BankKey, BankAccount>>;
}

const { companyName, ruc, accounts = {} } = Astro.props;

/** Config visual por banco: logo, color de cabecera y color de acento del CCI. */
const BANKS: Record<
	BankKey,
	{ label: string; logo: string; header: string; cciBg: string; cciBorder: string; cciText: string }
> = {
	bcp: { label: "BCP", logo: "/bancos/bcp.png", header: "#002C6C", cciBg: "#EEF4FA", cciBorder: "#D5E4F2", cciText: "#002C6C" },
	bbva: { label: "BBVA", logo: "/bancos/bbva.png", header: "#004481", cciBg: "#EEF4FA", cciBorder: "#D5E4F2", cciText: "#004481" },
	scotia: { label: "Scotiabank", logo: "/bancos/scotiabank.png", header: "#ED1C24", cciBg: "#FFEAEA", cciBorder: "#FFD1D1", cciText: "#ED1C24" },
	inter: { label: "Interbank", logo: "/bancos/interbank.png", header: "#00A859", cciBg: "#EAF7F0", cciBorder: "#CDECDA", cciText: "#00A859" },
	bn: { label: "Banco de la Nación", logo: "/bancos/bn.png", header: "#7F8C8D", cciBg: "#F0F1F2", cciBorder: "#D5D8DA", cciText: "#7F8C8D" },
	cajatrujillo: { label: "Caja Trujillo", logo: "/bancos/cajatrujillo.png", header: "#E30613", cciBg: "#FDEAEC", cciBorder: "#F8C9CE", cciText: "#E30613" },
};

// Orden fijo; solo los bancos que tienen cuenta configurada.
const ORDER: BankKey[] = ["bcp", "bbva", "scotia", "inter", "bn", "cajatrujillo"];
const shown = ORDER.filter((k) => accounts[k]).map((k) => ({ key: k, ...BANKS[k], account: accounts[k]! }));
---

{shown.length > 0 && (
	<div class="max-w-7xl mx-auto border-t border-white/5 py-12 flex flex-col items-center gap-8 reveal-item">
		<h4 class="font-extrabold text-[11px] opacity-50 tracking-[0.2em] uppercase text-center text-white">
			Cuentas Corrientes Bancarias
		</h4>
		<div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 w-full relative">
			{shown.map((bank) => (
				<div class="group relative flex justify-center cursor-pointer">
					<img
						src={bank.logo}
						alt={bank.label}
						class="h-8 md:h-9 object-contain filter brightness-0 invert opacity-50 hover:opacity-100 hover:filter-none transition-all duration-300"
					/>
					<div class="absolute bottom-full mb-4 flex flex-col items-center z-50 w-72 transition-all duration-300 transform scale-95 opacity-0 translate-y-2 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto">
						<div class="bg-white text-gray-800 shadow-2xl rounded-sm overflow-hidden flex flex-col text-center border border-gray-100">
							<div
								class="text-white px-4 py-3.5 font-bold font-display text-sm tracking-wide"
								style={`background-color: ${bank.header}`}
							>
								{companyName}<br />
								<span class="text-[10px] font-normal opacity-80 tracking-normal">RUC: {ruc}</span>
							</div>
							<div class="p-5 bg-white text-left">
								<p class="text-[9px] font-bold text-gray-400 tracking-wider uppercase mb-1">
									Nº CTA SOLES:
								</p>
								<p class="text-base font-extrabold text-gray-800 tracking-tight mb-4">
									{bank.account.soles}
								</p>
								{bank.account.cci && (
									<div
										class="p-3 rounded-sm border"
										style={`background-color: ${bank.cciBg}; border-color: ${bank.cciBorder}`}
									>
										<p
											class="text-[9px] font-bold tracking-wider uppercase mb-1"
											style={`color: ${bank.cciText}`}
										>
											CÓDIGO DE CTA. INTERBANCARIA SOLES
										</p>
										<p
											class="text-xs font-extrabold tracking-tighter"
											style={`color: ${bank.cciText}`}
										>
											{bank.account.cci}
										</p>
									</div>
								)}
							</div>
						</div>
						<div class="w-3 h-3 bg-white rotate-45 border-r border-b border-gray-100 -mt-1.5 shadow-sm"></div>
					</div>
				</div>
			))}
		</div>
	</div>
)}
