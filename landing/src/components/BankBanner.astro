							</p>
							{accounts.scotia.cci && (
								<div class="bg-[#FFEAEA] border border-[#FFD1D1] p-3 rounded-sm">
									<p class="text-[9px] font-bold text-[#ED1C24] tracking-wider uppercase mb-1">
										CÓDIGO DE CTA. INTERBANCARIA SOLES
									</p>
									<p class="text-xs font-extrabold text-[#ED1C24] tracking-tighter">
										{accounts.scotia.cci}
									</p>
								</div>
							)}
						</div>
					) : (
						<div class="p-5 bg-white text-center">
							<p class="text-sm font-bold text-gray-700">
