# Configuración de Firebase (Web App) — obtener desde Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=app-prevca.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=app-prevca
VITE_FIREBASE_STORAGE_BUCKET=app-prevca.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL de la API (Cloud Function `api`)
# Desarrollo local con emulador:
VITE_API_BASE_URL=http://localhost:5001/app-prevca/us-central1/api
# Producción:
# VITE_API_BASE_URL=https://us-central1-app-prevca.cloudfunctions.net/api

# Apuntar al emulador local de Firebase (true en dev, false en prod)
VITE_USE_EMULATORS=true
